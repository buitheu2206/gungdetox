    "@eslint/js": "^10.0.1",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
