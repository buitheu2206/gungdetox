---
// Props theo schema bảng `posts` — mục 8.4
interface Props {
  slug: string;
  title: string;
  tag?: string | null;
  readTime?: string | null;
  imageUrl?: string | null;
  videoUrl?: string | null;
  publishedAt?: string | null;
}

const { slug, title, tag, readTime, imageUrl, videoUrl, publishedAt } = Astro.props;

const formattedDate = publishedAt
  ? new Date(publishedAt).toLocaleDateString("vi-VN")
  : null;
---

<a class="blog-card surface-card" href={`/blog/${slug}`}>
  <div class="blog-media">
    {
      imageUrl ? (
        <img src={imageUrl} alt={title} loading="lazy" />
      ) : (
        <div class="blog-media-placeholder" aria-hidden="true" />
      )
    }
    {videoUrl && <video src={videoUrl} muted loop playsinline class="blog-hover-video" />}
  </div>
  <div class="blog-body">
    {tag && <span class="tag">{tag}</span>}
    <h3>{title}</h3>
    <p class="blog-meta">
      {formattedDate}
      {readTime ? ` · ${readTime}` : ""}
    </p>
  </div>
</a>

{/* CSS sống ở src/styles/cards.css (import trong BaseLayout.astro) — xem
    ghi chú trong ProductCard.astro. */}
