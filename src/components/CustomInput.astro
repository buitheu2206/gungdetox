---
// Shared input with required labels and inline validation feedback.
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"input"> {
  id: string;
  label: string;
  requiredMessage?: string;
}

const { id, label, type = "text", requiredMessage, ...attributes } = Astro.props;
const errorId = `${id}-error`;
const describedBy = [attributes["aria-describedby"], errorId].filter(Boolean).join(" ");
---

<div class="custom-input" data-custom-input>
  <label for={id}>{label}{attributes.required && <span class="required-mark" aria-hidden="true"> *</span>}</label>
  <input {...attributes} id={id} type={type} aria-describedby={describedBy} data-required-message={requiredMessage} data-custom-input-control />
  <span id={errorId} class="input-error" aria-live="polite" hidden></span>
</div>

<style>
  .custom-input {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  label {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .custom-input input {
    width: 100%;
    min-width: 0;
    padding: 0.55rem 0.7rem;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.6;
    font-weight: 400;
  }

  .custom-input input:focus-visible {
    outline: none;
    border-color: var(--color-primary);
  }

  .custom-input input[aria-invalid="true"] {
    border-color: var(--color-error);
  }

  .required-mark {
    color: var(--color-error);
  }

  .input-error {
    color: var(--color-error);
    font-size: 0.75rem;
  }
</style>

<script>
  import { initInputValidation } from "../lib/input-validation";

  document.querySelectorAll<HTMLElement>("[data-custom-input]").forEach((root) => {
    const input = root.querySelector("input")!;
    const error = root.querySelector<HTMLElement>(".input-error")!;
    initInputValidation(input, error);
  });
</script>
