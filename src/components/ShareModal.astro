---
// Modal "Chia sẻ" dùng chung toàn site — đặt 1 lần trong BaseLayout, mọi nút kích
// hoạt (data-share-trigger) ở bất kỳ đâu trong trang (kể cả card tạo bằng JS sau
// khi fetch Supabase) đều mở được modal này qua event delegation trên document.
// Trigger có thể khai báo data-share-url/data-share-title riêng (vd. mỗi card sản
// phẩm trong danh sách trỏ về đúng URL sản phẩm đó) — nếu không có thì mặc định
// dùng URL/tiêu đề của trang hiện tại (dùng cho nút "Chia sẻ" ở trang chi tiết).
---

<div class="share-modal-overlay" id="share-modal-overlay" hidden>
  <div class="share-modal-backdrop" data-share-close></div>
  <div class="share-modal-panel">
    <div class="share-modal-header">
      <h3>Chia sẻ</h3>
      <button type="button" class="share-modal-close" data-share-close aria-label="Đóng">✕</button>
    </div>

    <div class="share-icons">
      <a class="share-icon-btn" data-share-fb target="_blank" rel="noopener noreferrer">
        <span class="share-icon fb" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M22 12.06C22 6.48 17.52 2 11.94 2 6.36 2 1.88 6.48 1.88 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.42V9.91c0-2.39 1.42-3.71 3.6-3.71 1.04 0 2.13.19 2.13.19v2.34h-1.2c-1.18 0-1.55.74-1.55 1.49v1.79h2.64l-.42 2.91h-2.22V22c4.78-.76 8.44-4.92 8.44-9.94Z"/></svg>
        </span>
        <span>Facebook</span>
      </a>
      <a class="share-icon-btn" data-share-zalo target="_blank" rel="noopener noreferrer">
        <span class="share-icon zalo" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2C6.48 2 2 5.99 2 10.9c0 2.77 1.43 5.24 3.67 6.87-.12.92-.45 2.14-1.17 3.4a.4.4 0 0 0 .46.58c1.86-.6 3.33-1.44 4.26-2.08.87.21 1.8.33 2.78.33 5.52 0 10-3.99 10-8.9S17.52 2 12 2Z"/></svg>
        </span>
        <span>Zalo</span>
      </a>
      <a class="share-icon-btn" data-share-whatsapp target="_blank" rel="noopener noreferrer">
        <span class="share-icon whatsapp" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.74.46 3.43 1.33 4.92L2 22l5.28-1.39a9.9 9.9 0 0 0 4.76 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm0 18.13h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.13.82.84-3.05-.2-.31a8.22 8.22 0 0 1-1.27-4.35c0-4.55 3.7-8.25 8.26-8.25 2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.42 5.84c0 4.55-3.7 8.21-8.25 8.21Zm4.52-6.16c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.56.12-.17.25-.64.8-.78.96-.14.17-.29.19-.53.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.42h-.48c-.17 0-.43.06-.66.31-.23.25-.86.84-.86 2.05 0 1.2.88 2.37 1 2.53.12.17 1.73 2.64 4.2 3.7.59.25 1.04.4 1.4.52.59.19 1.12.16 1.54.1.47-.07 1.46-.6 1.66-1.17.21-.58.21-1.07.14-1.17-.06-.11-.23-.17-.48-.29Z"/></svg>
        </span>
        <span>WhatsApp</span>
      </a>
      <a class="share-icon-btn" data-share-x target="_blank" rel="noopener noreferrer">
        <span class="share-icon x" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M18.3 2H21.5l-7 8 8.2 12h-6.4l-5-6.6-5.7 6.6H2.4l7.5-8.6L2 2h6.6l4.5 6 5.2-6Zm-1.1 18h1.8L7.9 4H6l11.2 16Z"/></svg>
        </span>
        <span>X</span>
      </a>
    </div>

    <div class="share-link-row">
      <input type="text" readonly id="share-url-input" />
      <button type="button" class="share-copy-btn" id="share-copy-btn">Sao chép</button>
    </div>
  </div>
</div>

<script>
  const overlay = document.getElementById("share-modal-overlay") as HTMLElement;
  const fbLink = overlay.querySelector<HTMLAnchorElement>("[data-share-fb]")!;
  const zaloLink = overlay.querySelector<HTMLAnchorElement>("[data-share-zalo]")!;
  const waLink = overlay.querySelector<HTMLAnchorElement>("[data-share-whatsapp]")!;
  const xLink = overlay.querySelector<HTMLAnchorElement>("[data-share-x]")!;
  const urlInput = document.getElementById("share-url-input") as HTMLInputElement;
  const copyBtn = document.getElementById("share-copy-btn") as HTMLButtonElement;

  function openShare(url: string, title: string) {
    fbLink.href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
    zaloLink.href = `https://zalo.me/share?u=${encodeURIComponent(url)}`;
    waLink.href = `https://wa.me/?text=${encodeURIComponent(`${title} ${url}`)}`;
    xLink.href = `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
    urlInput.value = url;
    overlay.hidden = false;
    document.body.style.overflow = "hidden";
  }

  function closeShare() {
    overlay.hidden = true;
    document.body.style.overflow = "";
  }

  document.addEventListener("click", (e) => {
    const trigger = (e.target as HTMLElement).closest("[data-share-trigger]") as HTMLElement | null;
    if (trigger) {
      e.preventDefault();
      const url = trigger.dataset.shareUrl || window.location.href;
      const title = trigger.dataset.shareTitle || document.title;
      openShare(url, title);
      return;
    }
    if ((e.target as HTMLElement).closest("[data-share-close]")) closeShare();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !overlay.hidden) closeShare();
  });

  copyBtn.addEventListener("click", async () => {
    const original = copyBtn.textContent;
    try {
      await navigator.clipboard.writeText(urlInput.value);
      copyBtn.textContent = "Đã sao chép ✓";
      copyBtn.classList.add("copied");
    } catch {
      urlInput.select();
      return;
    }
    setTimeout(() => {
      copyBtn.textContent = original;
      copyBtn.classList.remove("copied");
    }, 1500);
  });
</script>

<style>
  .share-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .share-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(20, 15, 10, 0.55);
    backdrop-filter: blur(2px);
  }

  .share-modal-panel {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 420px;
    background: #fff;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 1.4rem 1.5rem;
  }

  .share-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.1rem;
  }

  .share-modal-header h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .share-modal-close {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: none;
    background: var(--color-bg-alt);
    cursor: pointer;
    font-size: 0.85rem;
    color: var(--color-text);
  }

  .share-icons {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.6rem;
    margin-bottom: 1.2rem;
  }

  .share-icon-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--color-text);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .share-icon {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
  }

  .share-icon.fb {
    background: #1877f2;
  }

  .share-icon.zalo {
    background: #0068ff;
  }

  .share-icon.whatsapp {
    background: #25d366;
  }

  .share-icon.x {
    background: #000;
  }

  .share-link-row {
    display: flex;
    gap: 0.5rem;
    background: var(--color-bg-alt);
    border-radius: var(--radius-sm);
    padding: 0.4rem 0.4rem 0.4rem 0.8rem;
    align-items: center;
  }

  .share-link-row input {
    flex: 1;
    min-width: 0;
    border: none;
    background: none;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .share-link-row input:focus {
    outline: none;
  }

  .share-copy-btn {
    flex-shrink: 0;
    background: var(--color-primary);
    color: #fff;
    border: none;
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.9rem;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
  }

  .share-copy-btn.copied {
    background: var(--color-primary-dark);
  }
</style>
