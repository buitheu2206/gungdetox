---
// Tra cứu một đơn bằng mã đơn và SĐT — mục 6.3 (section 5), 8.5
---

<section class="order-lookup" id="order-lookup">
  <div class="order-lookup-header">
    <span class="order-lookup-icon">🔍</span>
    <div>
      <h3>Tra cứu đơn hàng</h3>
      <p class="hint">Nhập mã đơn hoặc số điện thoại đã dùng khi đặt hàng (chỉ cần 1 trong 2 — gõ liền hay có dấu gạch/khoảng trắng đều được)</p>
    </div>
  </div>

  <form id="lookup-form">
    <input type="text" name="code" placeholder="Mã đơn (VD: 123456-ABCDEF)" aria-label="Mã đơn" />
    <input
      type="tel"
      name="phone"
      placeholder="Số điện thoại"
      title="Số điện thoại Việt Nam hợp lệ (10 số, bắt đầu bằng 0)"
    />
    <button type="submit">Tra cứu</button>
  </form>

  <div id="lookup-result" hidden></div>
</section>

<script>
  import { supabase } from "../lib/supabase";
  import { lookupCustomerOrder } from "../lib/order-lookup";
  import { ORDER_STATUS_LABELS } from "../lib/order-details";
  import { isOrderItems } from "../lib/order-pricing";
  import { escapeHtml } from "../lib/output";

  const form = document.getElementById("lookup-form") as HTMLFormElement;
  const result = document.getElementById("lookup-result")!;
  const button = form.querySelector("button")!;
  function orderRowHtml(order: { code: string; status: string; paid: boolean; items: unknown; bottles_returned: number | null; created_at: string }) {
    const items = isOrderItems(order.items)
      ? order.items.map((item) => `${item.productSlug} × ${item.quantity}`).join(", ")
      : "Thông tin sản phẩm chưa hợp lệ. Vui lòng liên hệ tiệm.";
    const date = new Date(order.created_at).toLocaleDateString("vi-VN");
    return `<li>
      <span class="order-code">${escapeHtml(order.code)}</span>
      <span class="order-date">${escapeHtml(date)}</span>
      <span class="order-items">${escapeHtml(items)}</span>
      <span class="paid-badge ${order.paid ? "paid-yes" : "paid-no"}">${order.paid ? "Đã thanh toán" : "Chưa thanh toán"}</span>
    </li>`;
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (button.disabled) return;
    const fields = new FormData(form);
    const code = String(fields.get("code") ?? "").trim();
    const phone = String(fields.get("phone") ?? "").trim();
    result.hidden = false;
    if (!code && !phone) {
      result.textContent = "Nhập mã đơn hoặc số điện thoại đã dùng khi đặt hàng.";
      return;
    }
    button.disabled = true;
    result.textContent = "Đang tra cứu…";
    try {
      const orders = await lookupCustomerOrder(supabase, code, phone);
      if (orders.length === 0) {
        result.textContent = "Không tìm thấy đơn nào khớp.";
        return;
      }
      const groups = new Map<string, typeof orders>();
      for (const order of orders) {
        const group = groups.get(order.status) ?? [];
        group.push(order);
        groups.set(order.status, group);
      }
      result.innerHTML = [...groups].map(([status, group]) => `
        <div class="status-group">
          <p class="status-group-title status-${escapeHtml(status)}">${escapeHtml(ORDER_STATUS_LABELS[status] ?? status)}</p>
          <ul class="order-list">${group.map(orderRowHtml).join("")}</ul>
        </div>
      `).join("");
    } catch (error) {
      console.error("Không tra cứu được đơn hàng", { error });
      result.textContent = error instanceof Error ? error.message : "Không tra cứu được. Vui lòng thử lại.";
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .order-lookup {
    max-width: 420px;
    margin: 0 auto;
    padding: 1.6rem;
    background: #fff;
    border-radius: var(--radius-lg);
  }

  .order-lookup-header {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    margin-bottom: 1.2rem;
  }

  .order-lookup-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    background: var(--color-primary-light);
    border-radius: 50%;
  }

  .order-lookup h3 {
    margin: 0 0 0.2rem;
    font-size: 1.15rem;
  }

  .hint {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  #lookup-form {
    flex-wrap: wrap;
    display: flex;
    gap: 0.6rem;
  }

  #lookup-form input {
    flex: 1;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1.5px solid #e2ddd0;
    font-size: 0.95rem;
    font-family: var(--font-body);
    transition: border-color 0.15s ease;
  }

  #lookup-form input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  #lookup-form button {
    background: var(--color-primary);
    color: #fff;
    border: none;
    border-radius: var(--radius-sm);
    padding: 0.65rem 1.1rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  #lookup-form button:hover {
    transform: translateY(-1px);
  }

  #lookup-result {
    margin-top: 1rem;
    font-size: 0.9rem;
  }

  #lookup-result p {
    margin: 0.2rem 0;
  }

  .not-found {
    color: var(--color-accent);
  }

  .summary {
    margin-bottom: 0.9rem !important;
  }

  .status-group {
    margin-bottom: 0.9rem;
  }

  .status-group-title {
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0 0 0.4rem !important;
  }

  .status-processing {
    color: var(--color-accent);
  }

  .status-delivering {
    color: #2563eb;
  }

  .status-delivered {
    color: var(--color-primary);
  }

  .status-cancelled {
    color: #6b7280;
  }

  .order-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }

  .order-list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
    background: var(--color-bg-alt);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.7rem;
    font-size: 0.85rem;
  }

  .order-code {
    font-family: monospace;
    font-weight: 700;
    color: var(--color-secondary);
  }

  .order-date {
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .order-items {
    color: var(--color-text);
  }

  .paid-badge {
    font-size: 0.75rem;
    font-weight: 700;
  }

  .paid-yes {
    color: var(--color-primary);
  }

  .paid-no {
    color: var(--color-accent);
  }
</style>
