---
// Tra cứu một đơn bằng mã đơn và SĐT — mục 6.3 (section 5), 8.5
---

<section class="order-lookup" id="order-lookup">
  <div class="order-lookup-header">
    <span class="order-lookup-icon">🔍</span>
    <div>
      <h3>Tra cứu đơn hàng</h3>
      <p class="hint">Nhập mã đơn và số điện thoại đã dùng khi đặt hàng</p>
    </div>
  </div>

  <form id="lookup-form">
    <input type="text" name="code" placeholder="Mã đơn (VD: 123456-ABCDEF)" aria-label="Mã đơn"
      pattern="[0-9]{6}-[A-Fa-f0-9]{6}" maxlength="13" required />
    <input
      type="tel"
      name="phone"
      placeholder="Số điện thoại"
      pattern="0[0-9]{9}"
      title="Số điện thoại Việt Nam hợp lệ (10 số, bắt đầu bằng 0)"
      required
    />
    <button type="submit">Tra cứu</button>
  </form>

  <div id="lookup-result" hidden></div>
</section>

<script>
  import { supabase } from "../lib/supabase";
  import { lookupCustomerOrder } from "../lib/order-lookup";
  import { ORDER_STATUS_LABELS } from "../lib/order-details";
  import { isOrderItems } from "../lib/order-pricing";
  import { escapeHtml } from "../lib/output";

  const form = document.getElementById("lookup-form") as HTMLFormElement;
  const result = document.getElementById("lookup-result")!;
  const button = form.querySelector("button")!;
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (button.disabled) return;
    button.disabled = true;
    result.hidden = false;
    result.textContent = "Đang tra cứu…";
    try {
      const fields = new FormData(form);
      const order = await lookupCustomerOrder(supabase, String(fields.get("code") ?? ""), String(fields.get("phone") ?? ""));
      if (!order) {
        result.textContent = "Không tìm thấy đơn khớp mã đơn và số điện thoại này.";
        return;
      }
      const items = isOrderItems(order.items)
        ? order.items.map((item) => `${item.productSlug} × ${item.quantity}`).join(", ")
        : "Thông tin sản phẩm chưa hợp lệ. Vui lòng liên hệ tiệm.";
      result.innerHTML = `<p><strong>${escapeHtml(order.code)}</strong></p>
        <p>${escapeHtml(ORDER_STATUS_LABELS[order.status] ?? order.status)}</p>
        <p>${escapeHtml(items)}</p>
        <p>${order.paid ? "Đã thanh toán" : "Chưa thanh toán"} · ${escapeHtml(order.bottles_returned ?? 0)} chai đã trả</p>`;
    } catch (error) {
      console.error("Không tra cứu được đơn hàng", { error });
      result.textContent = error instanceof Error ? error.message : "Không tra cứu được. Vui lòng thử lại.";
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .order-lookup {
    max-width: 420px;
    margin: 0 auto;
    padding: 1.6rem;
    background: #fff;
    border-radius: var(--radius-lg);
  }

  .order-lookup-header {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    margin-bottom: 1.2rem;
  }

  .order-lookup-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    background: var(--color-primary-light);
    border-radius: 50%;
  }

  .order-lookup h3 {
    margin: 0 0 0.2rem;
    font-size: 1.15rem;
  }

  .hint {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  #lookup-form {
    flex-wrap: wrap;
    display: flex;
    gap: 0.6rem;
  }

  #lookup-form input {
    flex: 1;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1.5px solid #e2ddd0;
    font-size: 0.95rem;
    font-family: var(--font-body);
    transition: border-color 0.15s ease;
  }

  #lookup-form input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  #lookup-form button {
    background: var(--color-primary);
    color: #fff;
    border: none;
    border-radius: var(--radius-sm);
    padding: 0.65rem 1.1rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  #lookup-form button:hover {
    transform: translateY(-1px);
  }

  #lookup-result {
    margin-top: 1rem;
    font-size: 0.9rem;
  }

  #lookup-result p {
    margin: 0.2rem 0;
  }

  .not-found {
    color: var(--color-accent);
  }

  .summary {
    margin-bottom: 0.9rem !important;
  }

  .status-group {
    margin-bottom: 0.9rem;
  }

  .status-group-title {
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0 0 0.4rem !important;
  }

  .status-processing {
    color: var(--color-accent);
  }

  .status-delivering {
    color: #2563eb;
  }

  .status-delivered {
    color: var(--color-primary);
  }

  .status-cancelled {
    color: #6b7280;
  }

  .order-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }

  .order-list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
    background: var(--color-bg-alt);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.7rem;
    font-size: 0.85rem;
  }

  .order-code {
    font-family: monospace;
    font-weight: 700;
    color: var(--color-secondary);
  }

  .order-date {
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .order-items {
    color: var(--color-text);
  }

  .paid-badge {
    font-size: 0.75rem;
    font-weight: 700;
  }

  .paid-yes {
    color: var(--color-primary);
  }

  .paid-no {
    color: var(--color-accent);
  }
</style>
