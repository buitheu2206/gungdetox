---
// Tra cứu đơn hàng + số chai đã trả bằng SĐT — mục 6.3 (section 5), 8.5
---

<section class="order-lookup" id="order-lookup">
  <div class="order-lookup-header">
    <span class="order-lookup-icon">🔍</span>
    <div>
      <h3>Tra cứu đơn hàng</h3>
      <p class="hint">Nhập số điện thoại đã dùng khi đặt hàng</p>
    </div>
  </div>

  <form id="lookup-form">
    <input
      type="tel"
      name="phone"
      placeholder="Số điện thoại"
      pattern="0[0-9]{9}"
      title="Số điện thoại Việt Nam hợp lệ (10 số, bắt đầu bằng 0)"
      required
    />
    <button type="submit">Tra cứu</button>
  </form>

  <div id="lookup-result" hidden></div>
</section>

<script>
  import { supabase } from "../lib/supabase";
  import { orderCode } from "../lib/templates";

  const statusLabel: Record<string, string> = {
    processing: "Đang xử lý",
    delivering: "Đang giao",
    delivered: "Đã giao",
    cancelled: "Đã huỷ",
  };

  // Thứ tự nhóm hiển thị — đơn đang chờ xử lý/giao lên trước để khách thấy ngay việc cần quan tâm.
  const statusOrder = ["processing", "delivering", "delivered", "cancelled"];

  function itemsSummary(items: any[]) {
    return (items ?? []).map((i) => `${i.productSlug} × ${i.quantity}`).join(", ");
  }

  const form = document.getElementById("lookup-form") as HTMLFormElement;
  const resultBox = document.getElementById("lookup-result") as HTMLDivElement;

  // Bubble lỗi validate mặc định của trình duyệt hiện theo ngôn ngữ trình duyệt/hệ điều
  // hành (vd "Please fill out this field"), không theo lang="vi" của trang — tự set message
  // tiếng Việt qua setCustomValidity() để luôn hiện đúng tiếng Việt bất kể máy khách cài đặt gì.
  const phoneInput = form?.querySelector<HTMLInputElement>('input[name="phone"]');
  phoneInput?.addEventListener("invalid", () => {
    phoneInput.setCustomValidity(
      phoneInput.validity.valueMissing
        ? "Vui lòng nhập số điện thoại"
        : phoneInput.title || "Số điện thoại không hợp lệ"
    );
  });
  phoneInput?.addEventListener("input", () => phoneInput.setCustomValidity(""));

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const phone = (new FormData(form).get("phone") as string)?.trim();
    if (!phone) return;

    resultBox.hidden = false;
    resultBox.textContent = "Đang tra cứu...";

    const { data: orders, error } = await supabase
      .from("orders")
      .select("*")
      .eq("phone", phone)
      .order("created_at", { ascending: false });

    if (error || !orders || orders.length === 0) {
      resultBox.innerHTML = `<p class="not-found">Không tìm thấy đơn hàng nào với số điện thoại này.</p>`;
      return;
    }

    const totalBottlesReturned = orders.reduce((sum, o) => sum + (o.bottles_returned ?? 0), 0);

    const groups = statusOrder
      .map((status) => ({ status, orders: orders.filter((o) => o.status === status) }))
      .filter((g) => g.orders.length > 0);

    resultBox.innerHTML = `
      <p class="summary">
        <strong>${orders.length}</strong> đơn đã đặt · <strong>${totalBottlesReturned}</strong> chai đã trả
      </p>
      ${groups
        .map(
          (g) => `
        <div class="status-group">
          <p class="status-group-title status-${g.status}">${statusLabel[g.status] ?? g.status} (${g.orders.length})</p>
          <ul class="order-list">
            ${g.orders
              .map(
                (o) => `
              <li>
                <span class="order-code">${orderCode(o.phone, o.id)}</span>
                <span class="order-date">${new Date(o.created_at).toLocaleDateString("vi-VN")}</span>
                <span class="order-items">${itemsSummary(o.items)}</span>
                <span class="paid-badge ${o.paid ? "paid-yes" : "paid-no"}">${o.paid ? "💳 Đã thanh toán" : "⏳ Chưa thanh toán"}</span>
              </li>
            `
              )
              .join("")}
          </ul>
        </div>
      `
        )
        .join("")}
    `;
  });
</script>

<style>
  .order-lookup {
    max-width: 420px;
    margin: 0 auto;
    padding: 1.6rem;
    background: #fff;
    border-radius: var(--radius-lg);
  }

  .order-lookup-header {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    margin-bottom: 1.2rem;
  }

  .order-lookup-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    background: var(--color-primary-light);
    border-radius: 50%;
  }

  .order-lookup h3 {
    margin: 0 0 0.2rem;
    font-size: 1.15rem;
  }

  .hint {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  #lookup-form {
    display: flex;
    gap: 0.6rem;
  }

  #lookup-form input {
    flex: 1;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1.5px solid #e2ddd0;
    font-size: 0.95rem;
    font-family: var(--font-body);
    transition: border-color 0.15s ease;
  }

  #lookup-form input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  #lookup-form button {
    background: var(--color-primary);
    color: #fff;
    border: none;
    border-radius: var(--radius-sm);
    padding: 0.65rem 1.1rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  #lookup-form button:hover {
    transform: translateY(-1px);
  }

  #lookup-result {
    margin-top: 1rem;
    font-size: 0.9rem;
  }

  #lookup-result p {
    margin: 0.2rem 0;
  }

  .not-found {
    color: var(--color-accent);
  }

  .summary {
    margin-bottom: 0.9rem !important;
  }

  .status-group {
    margin-bottom: 0.9rem;
  }

  .status-group-title {
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0 0 0.4rem !important;
  }

  .status-processing {
    color: var(--color-accent);
  }

  .status-delivering {
    color: #2563eb;
  }

  .status-delivered {
    color: var(--color-primary);
  }

  .status-cancelled {
    color: #6b7280;
  }

  .order-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }

  .order-list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
    background: var(--color-bg-alt);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.7rem;
    font-size: 0.85rem;
  }

  .order-code {
    font-family: monospace;
    font-weight: 700;
    color: var(--color-secondary);
  }

  .order-date {
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .order-items {
    color: var(--color-text);
  }

  .paid-badge {
    font-size: 0.75rem;
    font-weight: 700;
  }

  .paid-yes {
    color: var(--color-primary);
  }

  .paid-no {
    color: var(--color-accent);
  }
</style>
