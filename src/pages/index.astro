---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="GỪNG DETOX — đang xây dựng">
  <main
    style="max-width: 640px; margin: 4rem auto; padding: 0 1.5rem; text-align: center;"
  >
    <img
      src="/images/brand/logo.jpg"
      alt="GỪNG DETOX"
      width="160"
      height="160"
      style="border-radius: 50%; margin-bottom: 1.5rem;"
    />
    <h1>GỪNG DETOX</h1>
    <p style="font-family: var(--font-body); color: var(--color-primary);">
      Bước 0 — kiểm tra: font, màu sắc, logo đã lên đúng chưa. Trang thật sẽ
      được xây ở các bước tiếp theo.
    </p>
    <p style="font-family: var(--font-display); font-style: italic;">
      SỐNG XANH - SỐNG KHỎE
    </p>
  </main>
</BaseLayout>
