---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="GỪNG DETOX — Sống xanh, sống khỏe"
  description="Ginger Shot, Kombucha, Bia Gừng và 5 Set Detox tự nhiên — làm mới mỗi ngày, giao tận nhà tại TP.HCM."
>
  <main class="home-page">
    <section class="hero">
      <div class="hero-blob hero-blob-1"></div>
      <div class="hero-blob hero-blob-2"></div>
      <p class="eyebrow">🫚 Detox tự nhiên · Sài Gòn</p>
      <h1>Tiệm GỪNG xin chào!</h1>
      <p class="lead">
        Đồ uống lên men/detox từ gừng tươi, làm mới mỗi ngày, giao tận nhà theo tuần
        tại TP.HCM.
      </p>
      <div class="hero-cta">
        <a class="btn-primary" href="/san-pham">Xem sản phẩm</a>
        <a class="btn-secondary" href="/dat-hang">Đặt hàng ngay</a>
      </div>
      <div class="socials">
        <a href="https://facebook.com/gungdetox" target="_blank" rel="noopener">Facebook</a>
        <a href="https://instagram.com/gungdetox.saigon" target="_blank" rel="noopener">Instagram</a>
      </div>
    </section>

    <section class="why">
      <h2>Vì sao chọn GỪNG</h2>
      <div class="why-grid">
        <div class="surface-card">
          <span class="why-icon">🫚</span>
          <h3>Nguyên liệu thật</h3>
          <p>Gừng tươi, nghệ, chanh vàng, mật ong, muối hồng — không hương liệu, không chất bảo quản.</p>
        </div>
        <div class="surface-card">
          <span class="why-icon">🌿</span>
          <h3>Làm mới mỗi ngày</h3>
          <p>Ép/ủ/nấu mới theo đơn mỗi ngày, không sản xuất hàng loạt trữ sẵn.</p>
        </div>
        <div class="surface-card">
          <span class="why-icon">♻️</span>
          <h3>Hệ chai refill sạch</h3>
          <p>Chai thủy tinh hoặc nhựa, khử khuẩn bằng nước sôi trước khi tái sử dụng.</p>
        </div>
      </div>
    </section>

    <section class="featured">
      <h2>Sản phẩm nổi bật</h2>
      <div class="grid" id="featured-grid">
        <p class="loading">Đang tải...</p>
      </div>
    </section>

    <section class="set-detox-promo">
      <img src="/images/brand/cover-5-set-detox.jpg" alt="5 Set Detox Tự Nhiên" />
      <div class="promo-text">
        <h2>5 SET DETOX TỰ NHIÊN</h2>
        <p>Giao 7 chai thủy tinh — thanh lọc cơ thể — tươi sạch mỗi ngày.</p>
        <a class="btn-primary" href="/san-pham#combo">Xem các gói</a>
      </div>
    </section>

    <section class="quote">
      <blockquote>
        "GỪNG không nghĩ Ginger Shot là 'thuốc' hay uống một chai là khỏe ngay — một
        thói quen nhỏ mỗi sáng, kết hợp ăn uống cân bằng, mới tạo nên kết quả bền
        vững." 💚
      </blockquote>
    </section>

    <section class="quick-contact">
      <p>📍 60M Nguyễn Thông, Q.3 · Nguyễn Hữu Cảnh, Bình Thạnh — TP.HCM</p>
      <p>📞 0888 267 009</p>
      <a class="btn-primary" href="https://zalo.me/0888267009" target="_blank" rel="noopener">
        Chat Zalo
      </a>
    </section>
  </main>
</BaseLayout>

<script>
  import { supabase } from "../lib/supabase";
  import { productCardHtml, setDetoxCardHtml } from "../lib/templates";

  const grid = document.getElementById("featured-grid")!;
  const slugs = ["ginger-shot", "set-2-ginger-thom-tai-tao", "kombucha"];

  const { data, error } = await supabase.from("products").select("*").in("slug", slugs);

  if (error || !data) {
    grid.innerHTML = `<p class="error">Không tải được sản phẩm nổi bật.</p>`;
  } else {
    // Giữ đúng thứ tự đã định, không theo thứ tự trả về từ Supabase
    const ordered = slugs
      .map((slug) => data.find((p) => p.slug === slug))
      .filter(Boolean);
    grid.innerHTML = ordered
      .map((p) => (p!.type === "set" ? setDetoxCardHtml(p!, 2) : productCardHtml(p!)))
      .join("");
  }
</script>

<style>
  .home-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.5rem;
  }

  section {
    margin-bottom: 3rem;
  }

  .hero {
    position: relative;
    text-align: center;
    padding: 3.5rem 1.5rem 2rem;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--color-bg-warm), var(--color-bg));
  }

  .hero-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(50px);
    opacity: 0.35;
    z-index: 0;
  }

  .hero-blob-1 {
    width: 260px;
    height: 260px;
    background: var(--color-primary-light);
    top: -80px;
    left: -60px;
  }

  .hero-blob-2 {
    width: 220px;
    height: 220px;
    background: var(--color-accent);
    opacity: 0.15;
    bottom: -60px;
    right: -40px;
  }

  .hero > * {
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-primary);
    background: var(--color-primary-light);
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
  }

  .lead {
    max-width: 480px;
    margin: 0 auto 1.4rem;
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 1.2rem;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-block;
    padding: 0.8rem 1.6rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-primary {
    background: var(--color-primary);
    color: #fff;
    box-shadow: 0 8px 20px rgba(78, 103, 53, 0.3);
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(78, 103, 53, 0.35);
  }

  .btn-secondary {
    background: #fff;
    color: var(--color-primary);
    border: 1.5px solid var(--color-primary);
  }

  .btn-secondary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .socials {
    display: flex;
    gap: 1rem;
    justify-content: center;
    font-size: 0.9rem;
  }

  .socials a {
    color: var(--color-text);
    text-decoration: none;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.2rem;
  }

  .why-grid > div {
    padding: 1.4rem;
  }

  .why-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--color-primary-light);
    font-size: 1.4rem;
    margin-bottom: 0.7rem;
  }

  .why-grid h3 {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
  }

  .why-grid p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .loading {
    color: #6b7280;
  }

  .set-detox-promo {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 1.5rem;
    align-items: center;
    background: var(--color-bg-alt);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .set-detox-promo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .promo-text {
    padding: 1.5rem;
  }

  @media (max-width: 700px) {
    .set-detox-promo {
      grid-template-columns: 1fr;
    }
  }

  .quote {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 3rem;
  }

  .quote blockquote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--color-secondary);
    margin: 0;
  }

  .quick-contact {
    text-align: center;
    background: var(--color-primary);
    color: #fff;
    border-radius: var(--radius-lg);
    padding: 2rem 1.5rem;
  }

  .quick-contact .btn-primary {
    background: #fff;
    color: var(--color-primary);
  }

  .quick-contact .btn-primary:hover {
    background: var(--color-bg-warm);
  }

  .quick-contact p {
    margin: 0.2rem 0;
  }

  .quick-contact .btn-primary {
    margin-top: 0.8rem;
  }
</style>
