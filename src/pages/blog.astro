---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Blog — GỪNG DETOX"
  description="Chia sẻ về sức khỏe, detox, và cách dùng đồ uống GỪNG DETOX đúng cách."
>
  <main class="blog-page">
    <section class="page-header">
      <h1>Blog</h1>
      <p>Sức khỏe, detox và cách dùng đồ uống GỪNG DETOX đúng cách.</p>
    </section>

    <div class="grid" id="blog-grid">
      <p class="loading">Đang tải bài viết...</p>
    </div>
  </main>
</BaseLayout>

<script>
  import { supabase } from "../lib/supabase";
  import { blogCardHtml, type PostRow } from "../lib/templates";

  const grid = document.getElementById("blog-grid")!;

  const { data, error } = await supabase
    .from("posts")
    .select("*")
    .order("published_at", { ascending: false });

  if (error) {
    grid.innerHTML = `<p class="error">Không tải được bài viết: ${error.message}</p>`;
  } else {
    const posts = (data ?? []) as PostRow[];
    grid.innerHTML = posts.length
      ? posts.map(blogCardHtml).join("")
      : "<p>Chưa có bài viết.</p>";
  }
</script>

<style>
  .blog-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.5rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .grid > a {
    background: #fff;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .loading {
    color: var(--color-text-muted);
  }
</style>
