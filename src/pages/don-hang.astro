---
import BaseLayout from "../layouts/BaseLayout.astro";
import AdminLogin from "../components/AdminLogin.astro";
import CustomSelect from "../components/CustomSelect.astro";
import PaymentReceipt from "../components/PaymentReceipt.astro";
import { ORDER_STATUS_LABELS } from "../lib/order-details";
---

<BaseLayout title="Chi tiết đơn hàng — GỪNG DETOX" description="Chi tiết đơn hàng dành cho quản trị GỪNG DETOX." noindex>
  <main class="order-detail-page">
    <nav class="breadcrumb" aria-label="Điều hướng">
      <a href="/admin/don-hang">Quản lý đơn hàng</a><span aria-hidden="true">/</span><span>Chi tiết đơn</span>
    </nav>
    <header class="order-heading">
      <div><p class="eyebrow">GỪNG DETOX · QUẢN LÝ ĐƠN</p><h1>Chi tiết đơn hàng</h1><p class="order-code-line">Mã đơn <strong id="detail-code">—</strong></p></div>
    </header>

    <AdminLogin>
    <div class="detail-actions"><a class="secondary-button" href="/admin/don-hang">← Danh sách đơn hàng</a><button type="button" class="secondary-button" id="refresh-order">↻ Tải lại đơn hàng</button></div>
    <p id="detail-message" class="detail-message" role="status" hidden></p>
    <noscript><p class="detail-message">Vui lòng bật JavaScript để quản lý đơn hàng.</p></noscript>

    <div id="order-details" hidden>
      <section class="status-panel" aria-labelledby="status-title">
        <div class="status-copy"><span class="status-icon" id="status-icon" aria-hidden="true">🫚</span><div><p class="eyebrow">TRẠNG THÁI HIỆN TẠI</p><h2 id="status-title"></h2></div></div>
        <div class="status-editor"><label for="detail-status">Thay đổi trạng thái</label><CustomSelect id="detail-status">{Object.entries(ORDER_STATUS_LABELS).map(([value, label]) => <option value={value}>{label}</option>)}</CustomSelect><p id="status-save-message" role="status" aria-live="polite" hidden></p></div>
      </section>
      <div class="order-grid">
        <div class="order-main-column">
          <section class="detail-card" aria-labelledby="products-title">
            <div class="card-heading"><h2 id="products-title">Sản phẩm trong đơn</h2><span id="item-count" class="small-badge"></span></div>
            <ul class="detail-items" id="detail-items"></ul>
            <div class="bottle-summary"><span>Loại chai <strong id="detail-bottle"></strong></span><span>Chai gửi lại <strong id="detail-returned"></strong></span></div>
          </section>
          <section class="detail-card" aria-labelledby="delivery-title">
            <h2 id="delivery-title">Thông tin giao hàng</h2>
            <dl class="delivery-details">
              <div><dt>Người nhận</dt><dd id="detail-customer"></dd></div>
              <div><dt>Số điện thoại</dt><dd><a id="call-customer"></a></dd></div>
              <div class="full-row"><dt>Địa chỉ giao hàng</dt><dd id="detail-address"></dd></div>
              <div><dt>Thời điểm nhận hàng</dt><dd id="detail-delivery"></dd></div>
              <div><dt>Ngày đặt đơn</dt><dd id="detail-created"></dd></div>
              <div class="full-row"><dt>Ghi chú</dt><dd id="detail-note"></dd></div>
            </dl>
          </section>
          <section class="detail-card" aria-labelledby="history-title"><h2 id="history-title">Lịch sử đơn hàng</h2><ol id="detail-history" class="order-history"></ol></section>
        </div>
        <aside class="order-sidebar">
          <section class="detail-card payment-card" aria-labelledby="payment-title">
            <p class="eyebrow">THANH TOÁN</p><h2 id="payment-title"></h2><p class="payment-badge" id="detail-paid"></p>
            <label class="paid-toggle"><input type="checkbox" id="detail-paid-confirm" disabled /> Đã thanh toán</label>
            <p id="payment-save-message" role="status" aria-live="polite" hidden></p>
            <h3>Ảnh giao dịch chuyển khoản</h3>
            <PaymentReceipt />
          </section>
        </aside>
      </div>
    </div>
    <template id="detail-item-template"><li><div class="item-image"><img alt="" loading="lazy" hidden /><span aria-hidden="true">🫚</span></div><div class="item-copy"><a class="item-name"></a><span class="item-slug"></span></div><span class="item-quantity"></span></li></template>
    <template id="detail-history-template"><li><span class="history-dot" aria-hidden="true"></span><div><strong></strong><time></time></div></li></template>
    </AdminLogin>
  </main>
</BaseLayout>

<script>
  import { supabase } from "../lib/supabase";
  import { orderCode, type ProductRow } from "../lib/templates";
  import { ORDER_STATUS_LABELS, getDeliveryDetails, getOrderCodeBounds, type OrderRow } from "../lib/order-details";
  import { getPaymentInstructions, DEPOSIT_LABEL } from "../lib/payment";
  import { renderPaymentReceipt } from "../lib/render-payment-receipt";
  import { saveOrderStatus } from "../lib/order-status";
  import { saveOrderPayment } from "../lib/order-payment";
  import { syncCustomSelect } from "../lib/initCustomSelect";

  const lookup = getOrderCodeBounds(location.pathname.split("/").filter(Boolean).at(-1) ?? "");
  const details = document.getElementById("order-details")!;
  const message = document.getElementById("detail-message")!;
  const refresh = document.getElementById("refresh-order") as HTMLButtonElement;
  const itemTemplate = document.getElementById("detail-item-template") as HTMLTemplateElement;
  const historyTemplate = document.getElementById("detail-history-template") as HTMLTemplateElement;
  const statusIcons: Record<string, string> = { processing: "🫚", delivering: "🚲", delivered: "✓", cancelled: "—" };
  const dateFormat = new Intl.DateTimeFormat("vi-VN", { dateStyle: "medium", timeStyle: "short", timeZone: "Asia/Ho_Chi_Minh" });
  let loadVersion = 0;
  let currentOrder: OrderRow | null = null;
  const statusSelect = document.getElementById("detail-status") as HTMLSelectElement;
  const statusMessage = document.getElementById("status-save-message")!;
  const paidCheckbox = document.getElementById("detail-paid-confirm") as HTMLInputElement;
  const paymentMessage = document.getElementById("payment-save-message")!;
  const receipt = document.querySelector<HTMLElement>("[data-payment-receipt]")!;

  function setText(id: string, value: string) {
    document.getElementById(id)!.textContent = value;
  }

  function showMessage(text: string) {
    message.textContent = text;
    message.hidden = false;
  }

  function formatDate(value: string) {
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? "Chưa có thông tin" : dateFormat.format(date);
  }

  function renderStatus(order: OrderRow) {
    setText("status-title", ORDER_STATUS_LABELS[order.status] ?? "Chưa có trạng thái");
    setText("status-icon", statusIcons[order.status] ?? "🫚");
  }

  function renderPayment(order: OrderRow) {
    setText("detail-paid", order.paid ? "Đã thanh toán" : "Chưa thanh toán");
    document.getElementById("detail-paid")!.dataset.paid = String(order.paid);
    paidCheckbox.checked = order.paid;
  }

  function setOrderSaving(saving: boolean) {
    refresh.disabled = saving;
    statusSelect.disabled = saving || !currentOrder;
    paidCheckbox.disabled = saving || !currentOrder;
    syncCustomSelect(statusSelect);
  }

  function renderItems(order: OrderRow, products: ProductRow[]) {
    const rows = order.items.map((item) => {
      const row = itemTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const product = products.find((product) => product.slug === item.productSlug);
      const name = row.querySelector<HTMLAnchorElement>(".item-name")!;
      name.textContent = product?.name ?? item.productSlug;
      if (product) name.href = `/san-pham/${encodeURIComponent(product.slug)}`;
      row.querySelector(".item-slug")!.textContent = item.productSlug;
      row.querySelector(".item-quantity")!.textContent = `× ${item.quantity}`;
      const image = row.querySelector("img")!;
      if (product?.image_url && /^https?:\/\//i.test(product.image_url)) {
        image.src = product.image_url;
        image.alt = product.name;
        image.hidden = false;
        const fallback = row.querySelector<HTMLElement>(".item-image span")!;
        fallback.hidden = true;
        image.addEventListener("error", () => {
          image.hidden = true;
          fallback.hidden = false;
          console.error("Không tải được ảnh sản phẩm trong đơn hàng", { slug: item.productSlug });
        });
      }
      return row;
    });
    document.getElementById("detail-items")!.replaceChildren(...rows);
    setText("item-count", `${order.items.length} sản phẩm`);
  }

  function renderHistory(order: OrderRow) {
    const events = [{ status: "processing", at: order.created_at }, ...(order.status_history ?? [])];
    const rows = events.filter((event) => event && typeof event.at === "string" && typeof event.status === "string").map((event, index) => {
      const row = historyTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
      row.querySelector("strong")!.textContent = index === 0 ? "Đơn hàng được tạo" : ORDER_STATUS_LABELS[event.status] ?? event.status;
      const time = row.querySelector("time")!;
      time.textContent = formatDate(event.at);
      if (!Number.isNaN(Date.parse(event.at))) time.dateTime = event.at;
      return row;
    });
    document.getElementById("detail-history")!.replaceChildren(...rows);
  }

  function renderOrder(order: OrderRow, products: ProductRow[]) {
    const delivery = getDeliveryDetails(order.shipping_fee_note);
    setText("detail-customer", order.customer_name);
    setText("call-customer", order.phone);
    setText("detail-address", [order.address, order.district].filter(Boolean).join(", "));
    setText("detail-delivery", delivery.schedule);
    setText("detail-created", formatDate(order.created_at));
    setText("detail-note", delivery.note);
    setText("detail-bottle", ({ glass: "Thủy tinh", plastic: "Nhựa" } as Record<string, string>)[order.bottle_type] ?? order.bottle_type);
    setText("detail-returned", `${order.bottles_returned ?? 0} chai`);
    const isDeposit = order.shipping_fee_note?.includes(getPaymentInstructions(true).orderNote) ?? false;
    setText("payment-title", isDeposit ? DEPOSIT_LABEL : order.payment_method === "bank_transfer" ? "Chuyển khoản" : "Tiền mặt (COD)");
    renderPayment(order);
    const call = document.getElementById("call-customer") as HTMLAnchorElement;
    call.href = `tel:${order.phone.replace(/[^\d+]/g, "")}`;
    renderStatus(order);
    renderItems(order, products);
    renderHistory(order);
    currentOrder = order;
    statusSelect.value = order.status;
    syncCustomSelect(statusSelect);
    void renderPaymentReceipt(receipt, order.id);
    details.hidden = false;
  }

  async function fetchOrder() {
    if (!lookup) throw new Error("Mã đơn không hợp lệ. Vui lòng mở đơn từ danh sách quản lý.");
    const { data, error } = await supabase.from("orders")
      .select("id, phone, customer_name, address, district, items, bottle_type, bottles_returned, shipping_fee_note, payment_method, paid, status, status_history, created_at")
      .like("phone", `%${lookup.phoneSuffix}`)
      .gte("id", lookup.minId).lte("id", lookup.maxId).limit(2);
    if (error) throw new Error("Không tải được đơn hàng. Vui lòng thử lại.", { cause: error });
    if (!data?.length) throw new Error("Không tìm thấy đơn hàng này. Vui lòng kiểm tra mã đơn hoặc quay lại danh sách.");
    if (data.length !== 1) throw new Error("Mã đơn trùng với nhiều đơn hàng. Vui lòng kiểm tra trong danh sách quản lý.");
    const order = data[0] as OrderRow;
    if (orderCode(order.phone, order.id) !== lookup.code || !Array.isArray(order.items)
      || order.items.some((item) => !item || typeof item.productSlug !== "string" || !Number.isInteger(item.quantity) || item.quantity < 1)
      || (order.status_history != null && !Array.isArray(order.status_history))) {
      throw new Error("Dữ liệu đơn hàng không hợp lệ. Vui lòng kiểm tra lại trong danh sách quản lý.");
    }
    return order;
  }

  async function loadOrder() {
    const version = ++loadVersion;
    setOrderSaving(true);
    currentOrder = null;
    statusMessage.hidden = true;
    paymentMessage.hidden = true;
    details.hidden = true;
    message.hidden = true;
    try {
      const { data: { user }, error: authError } = await supabase.auth.getUser();
      if (!user) {
        if (authError && authError.name !== "AuthSessionMissingError") console.error("Không xác minh được đăng nhập quản trị", { error: authError });
        return;
      }
      if (version !== loadVersion) return;
      showMessage("Đang tải thông tin đơn hàng…");
      const order = await fetchOrder();
      const { data: products, error } = await supabase.from("products").select("slug, name, image_url").in("slug", order.items.map((item) => item.productSlug));
      if (version !== loadVersion) return;
      renderOrder(order, (products ?? []) as ProductRow[]);
      message.hidden = true;
      if (error) {
        console.error("Không tải được tên và ảnh sản phẩm của đơn hàng", { code: lookup?.code, error });
        showMessage("Đã tải đơn hàng. Tên và ảnh sản phẩm tạm thời chưa tải được; đang hiển thị mã sản phẩm.");
      }
    } catch (error) {
      if (version !== loadVersion) return;
      console.error("Không tải được trang chi tiết đơn hàng", { code: lookup?.code, error });
      showMessage(error instanceof Error ? error.message : "Không tải được đơn hàng. Vui lòng thử lại.");
    } finally {
      if (version === loadVersion) setOrderSaving(false);
    }
  }

  setText("detail-code", lookup?.code ?? "Mã không hợp lệ");
  refresh.addEventListener("click", loadOrder);
  statusSelect.addEventListener("change", async () => {
    const order = currentOrder;
    if (!order || statusSelect.disabled) return;
    setOrderSaving(true);
    statusMessage.hidden = false;
    statusMessage.textContent = "Đang lưu trạng thái…";
    try {
      const update = await saveOrderStatus(supabase, order, statusSelect.value);
      if (currentOrder !== order) return;
      Object.assign(order, update);
      renderStatus(order);
      renderHistory(order);
      statusMessage.textContent = "Đã cập nhật trạng thái đơn hàng.";
    } catch (error) {
      if (currentOrder !== order) return;
      statusSelect.value = order.status;
      statusMessage.textContent = error instanceof Error ? error.message : "Không lưu được trạng thái.";
    } finally {
      if (currentOrder === order) setOrderSaving(false);
    }
  });
  paidCheckbox.addEventListener("change", async () => {
    const order = currentOrder;
    if (!order || paidCheckbox.disabled) return;
    setOrderSaving(true);
    paymentMessage.hidden = false;
    paymentMessage.textContent = "Đang lưu thanh toán…";
    try {
      const update = await saveOrderPayment(supabase, order.id, paidCheckbox.checked);
      if (currentOrder !== order) return;
      Object.assign(order, update);
      renderPayment(order);
      paymentMessage.textContent = order.paid ? "Đã xác nhận thanh toán." : "Đã chuyển về chưa thanh toán.";
    } catch (error) {
      if (currentOrder !== order) return;
      renderPayment(order);
      paymentMessage.textContent = error instanceof Error ? error.message : "Không lưu được thanh toán.";
    } finally {
      if (currentOrder === order) setOrderSaving(false);
    }
  });
  supabase.auth.onAuthStateChange((event, session) => {
    if (!session) {
      loadVersion++;
      currentOrder = null;
      receipt.dataset.orderId = "";
      receipt.querySelector("a")!.removeAttribute("href");
      receipt.querySelector("img")!.removeAttribute("src");
      details.hidden = true;
      message.hidden = true;
      setOrderSaving(false);
    } else if (event === "SIGNED_IN") {
      // Auth callbacks run under a lock; defer calls to getUser until it is released.
      setTimeout(() => { if (!refresh.disabled) void loadOrder(); }, 0);
    }
  });
  void loadOrder();
</script>

<style>
  .order-detail-page { max-width: 1120px; margin: auto; padding: 2rem 1.5rem 4rem; }
  .breadcrumb { display: flex; flex-wrap: wrap; gap: .6rem; color: var(--color-text-muted); font-size: .8rem; margin-bottom: 2rem; }
  .breadcrumb a { text-decoration: none; }
  .order-heading { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 2rem; }
  .eyebrow { color: var(--color-primary); font-size: .72rem; font-weight: 700; letter-spacing: .12em; margin: 0 0 .65rem; }
  h1 { margin-bottom: .5rem; }
  .order-code-line { margin: 0; color: var(--color-text-muted); }
  .order-code-line strong { color: var(--color-secondary); margin-left: .5rem; font-family: monospace; }
  .secondary-button { display: inline-flex; justify-content: center; align-items: center; gap: .4rem; border-radius: 999px; padding: .75rem 1.2rem; font: 600 .85rem var(--font-body); cursor: pointer; text-decoration: none; }
  .secondary-button { background: transparent; border: 1px solid #d9ddcc; color: var(--color-primary); }
  button:disabled { opacity: .6; cursor: wait; }
  a:focus-visible, button:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 4px; }
  .detail-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-bottom: 1.5rem; }
  .detail-message { padding: 1rem 1.5rem; background: var(--color-bg-alt); color: var(--color-secondary); border-radius: var(--radius-md); }
  .status-panel { padding: 1.8rem 2rem; background: var(--color-primary-light); border-radius: var(--radius-lg); margin-bottom: 1.5rem; }
  .status-copy { display: flex; gap: 1rem; align-items: center; }
  .status-icon { display: grid; place-items: center; width: 56px; height: 56px; flex-shrink: 0; border-radius: 50%; background: #fffdf8aa; font-size: 1.5rem; }
  .status-copy h2 { font-size: 1.5rem; margin-bottom: .35rem; padding: 0; }
  .status-copy h2::after { display: none; }
  .status-editor { max-width: 320px; margin-top: 1.25rem; }
  .status-editor label { display: block; margin-bottom: .5rem; font-size: .85rem; font-weight: 600; }
  .status-editor p { font-size: .85rem; margin-bottom: 0; }
  .order-grid { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 1.5rem; align-items: start; }
  .order-main-column, .order-sidebar { display: grid; gap: 1.5rem; min-width: 0; }
  .detail-card { padding: 1.5rem; background: white; border: 1px solid #e8e2d7; border-radius: var(--radius-lg); }
  .detail-card h2 { font-size: 1.1rem; margin-bottom: 1.4rem; }
  .card-heading { display: flex; justify-content: space-between; gap: .75rem; align-items: start; }
  .small-badge { background: var(--color-bg-alt); border-radius: 999px; padding: .25rem .7rem; font-size: .75rem; white-space: nowrap; }
  .detail-items { list-style: none; padding: 0; margin: 0; }
  .detail-items li { display: flex; align-items: center; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--color-bg-alt); }
  .detail-items li:first-child { padding-top: 0; }
  .item-image { width: 68px; height: 68px; flex-shrink: 0; display: grid; place-items: center; border-radius: var(--radius-md); overflow: hidden; background: var(--color-bg-warm); font-size: 1.5rem; }
  .item-image img { width: 100%; height: 100%; object-fit: cover; }
  .item-copy { display: grid; gap: .25rem; flex: 1; min-width: 0; overflow-wrap: anywhere; }
  .item-name { color: var(--color-secondary); font-weight: 600; text-decoration: none; }
  .item-slug { color: var(--color-text-muted); font-size: .75rem; }
  .item-quantity { font-size: .85rem; font-weight: 600; white-space: nowrap; color: var(--color-primary); }
  .bottle-summary { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem; margin-top: 1rem; font-size: .8rem; color: var(--color-text-muted); }
  .bottle-summary strong { margin-left: .4rem; color: var(--color-secondary); }
  .delivery-details { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem 1.5rem; margin: 0; }
  .delivery-details dt { font-size: .75rem; color: var(--color-text-muted); margin-bottom: .25rem; }
  .delivery-details dd { margin: 0; font-size: .9rem; overflow-wrap: anywhere; }
  .full-row { grid-column: 1 / -1; }
  .order-history { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .order-history li { display: flex; gap: .8rem; align-items: baseline; font-size: .85rem; }
  .history-dot { width: 8px; height: 8px; flex-shrink: 0; border-radius: 50%; background: var(--color-primary); }
  .order-history time { display: block; font-size: .75rem; color: var(--color-text-muted); margin-top: .2rem; }
  .payment-card { background: var(--color-bg-warm); }
  .payment-card h3 { font-size: .95rem; margin-top: 1.25rem; }
  .payment-badge { display: inline-block; color: var(--color-accent); background: #b5431110; border-radius: 999px; padding: .35rem .7rem; font-size: .8rem; font-weight: 600; margin: 0; }
  .payment-badge[data-paid="true"] { color: var(--color-primary); background: var(--color-primary-light); }
  .payment-card p:not(.eyebrow):not(.payment-badge) { font-size: .85rem; }
  .paid-toggle { display: flex; align-items: center; gap: .5rem; margin-top: 1rem; font-size: .85rem; cursor: pointer; }
  .paid-toggle input { accent-color: var(--color-primary); }
  @media (max-width: 760px) {
    .order-detail-page { padding: 1.5rem 1rem 3rem; }
    .order-heading { align-items: start; flex-direction: column; }
    .order-grid { grid-template-columns: 1fr; }
    .status-panel { padding: 1.3rem; }
    .detail-card { padding: 1.25rem; }
    .delivery-details { grid-template-columns: 1fr; }
    .item-image { width: 56px; height: 56px; }
    .detail-items li { gap: .75rem; }
    .item-name { font-size: .85rem; }
  }
</style>
