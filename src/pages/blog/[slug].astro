---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { supabase } from "../../lib/supabase";
import { blogCardHtml, tagLabel, type PostRow } from "../../lib/templates";

// Cùng pattern với /san-pham/[slug].astro: pre-render tại build time (getStaticPaths)
// cho URL đẹp/SEO, script phía client fetch lại đúng slug để cập nhật nội dung
// nếu admin sửa bài sau lần build gần nhất (không cần rebuild chỉ vì sửa chữ).
export async function getStaticPaths() {
  const { data } = await supabase.from("posts").select("*");
  const allPosts = data ?? [];
  return allPosts.map((p) => ({ params: { slug: p.slug }, props: { post: p, allPosts } }));
}

const { post, allPosts } = Astro.props as { post: PostRow; allPosts: PostRow[] };

const formattedDate = post.published_at
  ? new Date(post.published_at).toLocaleDateString("vi-VN")
  : "";

const paragraphs: string[] = (post.body ?? "").split(/\n\n+/).filter(Boolean);
const images = [post.image_url, ...(post.gallery_images ?? [])].filter(Boolean) as string[];

const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => (a.tag === post.tag ? -1 : 0) - (b.tag === post.tag ? -1 : 0))
  .slice(0, 3);

const shareUrl = new URL(Astro.url.pathname, Astro.site).toString();
const fbShareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`;
---

<BaseLayout
  title={`${post.title} — GỪNG DETOX`}
  description={post.title}
>
  <main class="post-page" data-slug={post.slug}>
    <nav class="breadcrumb">
      <a href="/blog">Blog</a> / <span id="bc-title">{post.title}</span>
    </nav>

    <div class="post-layout">
      <article>
        <header>
          {post.tag && <span class="tag" id="p-tag">{tagLabel[post.tag] ?? post.tag}</span>}
          <h1 id="p-title">{post.title}</h1>
          <p class="meta" id="p-meta">
            {formattedDate}
            {post.read_time ? ` · ${post.read_time}` : ""}
          </p>
        </header>

        <div class="gallery">
          {
            images.length > 0 ? (
              <img class="cover" id="p-cover" src={images[0]} alt={post.title} />
            ) : (
              <div class="cover media-placeholder" id="p-cover" />
            )
          }
          {
            images.length > 1 && (
              <div class="gallery-thumbs" id="gallery-thumbs">
                {images.map((src, i) => (
                  <button class="thumb" data-src={src} class:list={{ active: i === 0 }}>
                    <img src={src} alt="" />
                  </button>
                ))}
              </div>
            )
          }
        </div>

        <div class="content" id="p-body">
          {paragraphs.map((para) => <p>{para}</p>)}
        </div>

        <div class="share-row">
          <span class="share-label">Chia sẻ:</span>
          <a
            class="share-fb"
            href={fbShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Chia sẻ bài viết này lên Facebook"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M22 12.06C22 6.48 17.52 2 11.94 2 6.36 2 1.88 6.48 1.88 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.42V9.91c0-2.39 1.42-3.71 3.6-3.71 1.04 0 2.13.19 2.13.19v2.34h-1.2c-1.18 0-1.55.74-1.55 1.49v1.79h2.64l-.42 2.91h-2.22V22c4.78-.76 8.44-4.92 8.44-9.94Z"/>
            </svg>
            Chia sẻ lên Facebook
          </a>
        </div>

        <div class="cta-banner">
          <p>Muốn thử ngay hôm nay?</p>
          <a class="btn-primary" href="/dat-hang">Đặt hàng ngay</a>
        </div>

        <p class="back"><a href="/blog">← Xem thêm bài viết khác</a></p>
      </article>

      {
        relatedPosts.length > 0 && (
          <aside class="related">
            <h2>Bài viết liên quan</h2>
            <div class="related-list" set:html={relatedPosts.map((p) => blogCardHtml(p)).join("")} />
          </aside>
        )
      }
    </div>
  </main>
</BaseLayout>

<script>
  import { supabase } from "../../lib/supabase";
  import { tagLabel } from "../../lib/templates";

  const page = document.querySelector(".post-page") as HTMLElement;
  const slug = page?.dataset.slug;
  if (!slug) throw new Error("missing slug");

  // Chuyển ảnh khi bấm thumbnail — gắn trên .gallery (luôn tồn tại) thay vì
  // #gallery-thumbs, vì dải thumbnail có thể chưa tồn tại lúc build (bài viết
  // lúc đó chỉ có 1 ảnh) và được script bên dưới tự tạo ra sau khi fetch lại.
  document.querySelector(".gallery")?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest(".thumb") as HTMLButtonElement | null;
    if (!btn) return;
    const mainImg = document.getElementById("p-cover") as HTMLImageElement;
    mainImg.src = btn.dataset.src!;
    document.querySelectorAll(".thumb").forEach((t) => t.classList.remove("active"));
    btn.classList.add("active");
  });

  function renderThumbs(images: string[]) {
    const gallery = document.querySelector(".gallery");
    if (!gallery) return;
    let thumbs = document.getElementById("gallery-thumbs");
    if (images.length <= 1) {
      thumbs?.remove();
      return;
    }
    // Astro chỉ áp style scoped (data-astro-cid-*) cho phần tử render lúc build;
    // phần tử tạo bằng JS phải tự gắn thêm attribute này thì CSS mới nhận diện
    // được — nếu không, ảnh thumbnail sẽ không bị giới hạn kích thước và phá
    // vỡ layout (lỗi đã gặp và fix ở trang chi tiết sản phẩm).
    const cidAttr = Array.from(gallery.attributes).find((a) => a.name.startsWith("data-astro-cid-"));
    const cid = cidAttr ? ` ${cidAttr.name}=""` : "";

    if (!thumbs) {
      thumbs = document.createElement("div");
      thumbs.id = "gallery-thumbs";
      thumbs.className = "gallery-thumbs";
      gallery.appendChild(thumbs);
    }
    if (cidAttr) thumbs.setAttribute(cidAttr.name, "");
    thumbs.innerHTML = images
      .map(
        (src, i) =>
          `<button class="thumb${i === 0 ? " active" : ""}" data-src="${src}"${cid}><img src="${src}" alt=""${cid} /></button>`
      )
      .join("");
  }

  supabase
    .from("posts")
    .select("*")
    .eq("slug", slug)
    .maybeSingle()
    .then(({ data: p }) => {
      if (!p) return; // bài đã bị xoá sau build — giữ nguyên nội dung cũ, không báo lỗi

      document.title = `${p.title} — GỪNG DETOX`;
      const setText = (id: string, value?: string | null) => {
        const el = document.getElementById(id);
        if (el && value) el.textContent = value;
      };
      setText("bc-title", p.title);
      setText("p-title", p.title);
      setText("p-tag", p.tag ? (tagLabel[p.tag] ?? p.tag) : null);

      const metaEl = document.getElementById("p-meta");
      if (metaEl) {
        const date = p.published_at ? new Date(p.published_at).toLocaleDateString("vi-VN") : "";
        metaEl.textContent = `${date}${p.read_time ? ` · ${p.read_time}` : ""}`;
      }

      const images = [p.image_url, ...(p.gallery_images ?? [])].filter(Boolean) as string[];
      const cover = document.getElementById("p-cover");
      if (images.length > 0 && cover?.tagName === "IMG") {
        (cover as HTMLImageElement).src = images[0];
      }
      renderThumbs(images);

      const bodyEl = document.getElementById("p-body");
      if (bodyEl && p.body) {
        bodyEl.innerHTML = "";
        for (const para of p.body.split(/\n\n+/).filter(Boolean)) {
          const pEl = document.createElement("p");
          pEl.textContent = para;
          bodyEl.appendChild(pEl);
        }
      }
    });
</script>

<style>
  .post-page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 1.5rem;
  }

  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 2.5rem;
    align-items: start;
  }

  @media (max-width: 860px) {
    .post-layout {
      grid-template-columns: 1fr;
    }
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 1.2rem;
  }

  .breadcrumb a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 600;
  }

  .breadcrumb a:hover {
    color: var(--color-secondary);
  }

  .tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: #fff;
    background: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 0.5rem;
  }

  header h1 {
    margin: 0 0 0.4rem;
  }

  .meta {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 1.2rem;
  }

  .gallery {
    margin-bottom: 1.5rem;
  }

  .cover {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: contain;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    background: linear-gradient(135deg, var(--color-primary-light), var(--color-bg-warm));
  }

  .gallery-thumbs {
    display: flex;
    gap: 0.6rem;
    margin-top: 0.8rem;
  }

  .thumb {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 2px solid transparent;
    padding: 0;
    cursor: pointer;
    background: none;
    flex-shrink: 0;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .thumb.active {
    border-color: var(--color-primary);
  }

  .content p {
    margin: 0 0 1.1rem;
    line-height: 1.7;
    white-space: pre-wrap;
  }

  .share-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.6rem;
  }

  .share-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .share-fb {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: #1877f2;
    color: #fff;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .share-fb:hover {
    background: #145dbf;
  }

  .back {
    margin-top: 2rem;
  }

  .back a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
  }

  .cta-banner {
    margin-top: 2.5rem;
    padding: 1.6rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--color-primary-light), var(--color-bg-warm));
    text-align: center;
  }

  .cta-banner p {
    margin: 0 0 0.8rem;
    font-weight: 600;
    color: var(--color-secondary);
    font-size: 1.1rem;
  }

  .btn-primary {
    display: inline-block;
    background: var(--color-primary);
    color: #fff;
    text-decoration: none;
    padding: 0.8rem 1.8rem;
    border-radius: 999px;
    font-weight: 600;
    box-shadow: 0 8px 20px rgba(78, 103, 53, 0.3);
  }

  .related {
    padding-top: 0.2rem;
    position: sticky;
    top: 88px;
  }

  @media (max-width: 860px) {
    .related {
      position: static;
    }
  }

  .related h2 {
    font-size: 1.1rem;
    margin: 0 0 1rem;
  }

  .related-list {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .related-list :global(.blog-card) {
    display: flex;
    gap: 0.8rem;
    background: #fff;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .related-list :global(.blog-media) {
    width: 92px;
    aspect-ratio: 1 / 1;
    flex-shrink: 0;
  }

  .related-list :global(.blog-body) {
    padding: 0.6rem 0.8rem 0.6rem 0;
    min-width: 0;
  }

  .related-list :global(.blog-body h3) {
    font-size: 0.9rem;
    line-height: 1.3;
  }
</style>
