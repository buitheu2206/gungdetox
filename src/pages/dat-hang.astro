---
import BaseLayout from "../layouts/BaseLayout.astro";
import OrderLookup from "../components/OrderLookup.astro";
---

<BaseLayout
  title="Đặt hàng — GỪNG DETOX"
  description="Đặt hàng đồ uống/combo GỪNG DETOX và tra cứu trạng thái đơn bằng số điện thoại."
>
  <main class="order-page">
    <h1>Đặt hàng</h1>

    <ol class="steps-indicator" id="steps-indicator">
      <li data-step="1" class="active">Sản phẩm</li>
      <li data-step="2">Tuỳ chọn</li>
      <li data-step="3">Giao hàng</li>
      <li data-step="4">Xác nhận</li>
    </ol>

    <form id="order-form" novalidate>
      <!-- Bước 1 — Sản phẩm -->
      <section class="step" data-step="1">
        <h2>Bước 1 — Sản phẩm</h2>
        <div class="product-picker">
          <label class="product-picker-select">
            Chọn sản phẩm
            <select id="product-select"></select>
          </label>
          <label class="product-picker-qty">
            Số lượng
            <input type="number" id="quantity" min="1" value="1" />
          </label>
          <button type="button" id="add-to-cart" class="add-cart-btn">+ Thêm vào giỏ hàng</button>
        </div>

        <div id="cart-list" class="cart-list"></div>
        <p id="cart-empty-hint" class="cart-empty-hint">Giỏ hàng đang trống — thêm ít nhất 1 sản phẩm để tiếp tục.</p>

        <button type="button" class="next" data-next="2" id="step1-next">Tiếp tục</button>
      </section>

      <!-- Bước 2 — Tuỳ chọn -->
      <section class="step" data-step="2" hidden>
        <h2>Bước 2 — Tuỳ chọn</h2>
        <fieldset id="bottle-fieldset">
          <legend>Loại chai</legend>
        </fieldset>
        <label id="delivery-day-wrap" hidden>
          Ngày giao hàng ưu tiên (áp dụng cho combo/set)
          <select id="delivery-day">
            <option value="thu-2">Thứ 2</option>
            <option value="thu-3">Thứ 3</option>
            <option value="thu-4">Thứ 4</option>
            <option value="thu-5">Thứ 5</option>
            <option value="thu-6">Thứ 6</option>
            <option value="thu-7">Thứ 7</option>
            <option value="chu-nhat">Chủ nhật</option>
          </select>
        </label>
        <div class="nav-row">
          <button type="button" class="back" data-back="1">Quay lại</button>
          <button type="button" class="next" data-next="3">Tiếp tục</button>
        </div>
      </section>

      <!-- Bước 3 — Thông tin giao hàng -->
      <section class="step" data-step="3" hidden>
        <h2>Bước 3 — Thông tin giao hàng</h2>
        <div class="form-row">
          <label>
            Họ tên
            <input type="text" id="customer-name" required />
          </label>
          <label>
            Số điện thoại
            <input
              type="tel"
              id="phone"
              pattern="0[0-9]{9}"
              title="Số điện thoại Việt Nam hợp lệ: đúng 10 số, bắt đầu bằng 0, không có khoảng trắng/dấu gạch"
              required
            />
          </label>
        </div>
        <label>
          Địa chỉ
          <input type="text" id="address" required />
        </label>
        <div class="form-row">
          <label>
            Quận
            <select id="district">
              <option value="Quận 1">Quận 1</option>
              <option value="Quận 3">Quận 3</option>
              <option value="Bình Thạnh">Bình Thạnh</option>
              <option value="Khác">Khác (ngoài khu vực giao chuẩn)</option>
            </select>
          </label>
          <label>
            Số chai cũ muốn trả (nếu có)
            <input type="number" id="bottles-returned" min="0" value="0" />
          </label>
        </div>
        <p id="district-warning" class="warning" hidden>
          ⚠️ Ngoài khu vực giao hàng chuẩn — vui lòng liên hệ tiệm để được tư vấn trước khi đặt.
        </p>
        <div class="nav-row">
          <button type="button" class="back" data-back="2">Quay lại</button>
          <button type="button" class="next" data-next="4">Tiếp tục</button>
        </div>
      </section>

      <!-- Bước 4 — Xác nhận -->
      <section class="step" data-step="4" hidden>
        <h2>Bước 4 — Xác nhận</h2>

        <div class="confirm-grid">
          <div class="confirm-col">
            <div id="order-summary" class="order-summary"></div>

            <p class="shipping-note">
              🚚 Phí ship tính theo khoảng cách thực tế (5.000đ/km từ tiệm gần nhất), tiệm sẽ
              báo lại qua Zalo trước khi giao.
            </p>
          </div>

          <div class="confirm-col">
            <fieldset id="payment-method-fieldset" class="payment-method">
              <legend>Hình thức thanh toán</legend>
              <label>
                <input type="radio" name="payment-method" value="bank_transfer" checked />
                Chuyển khoản trước
              </label>
              <label>
                <input type="radio" name="payment-method" value="cod" />
                Tiền mặt khi nhận hàng (COD)
              </label>
            </fieldset>

            <div class="bank-info" id="bank-info">
              <p class="bank-info-title">💳 Thông tin chuyển khoản</p>
              <div class="bank-info-body">
                <img
                  class="qr-code"
                  src="https://img.vietqr.io/image/970436-1065425789-qr_only.png"
                  alt="Mã QR chuyển khoản Vietcombank HKD GUNG DETOX"
                  width="200"
                  height="200"
                  loading="lazy"
                />
                <dl class="bank-details">
                  <div class="bank-details-row">
                    <dt>Ngân hàng</dt>
                    <dd>Vietcombank</dd>
                  </div>
                  <div class="bank-details-row">
                    <dt>Số tài khoản</dt>
                    <dd class="account-number">
                      <span>1065425789</span>
                      <button type="button" class="copy-btn" data-copy="1065425789">Sao chép</button>
                    </dd>
                  </div>
                  <div class="bank-details-row">
                    <dt>Chủ tài khoản</dt>
                    <dd>HKD GUNG DETOX</dd>
                  </div>
                </dl>
              </div>
            </div>
          </div>
        </div>

        <div class="nav-row">
          <button type="button" class="back" data-back="3">Quay lại</button>
          <button type="submit" class="submit">Đặt hàng</button>
        </div>
      </section>
    </form>

    <!-- Trang cảm ơn -->
    <section id="thank-you" hidden>
      <h2>🎉 Đặt hàng thành công!</h2>
      <p>Mã đơn của bạn: <strong id="order-id"></strong></p>
      <p>Tiệm sẽ liên hệ qua Zalo/hotline để xác nhận và báo phí ship cụ thể.</p>
    </section>

    <OrderLookup />
  </main>
</BaseLayout>

<script>
  import { supabase } from "../lib/supabase";
  import { orderCode } from "../lib/templates";

  interface ProductRow {
    slug: string;
    type: "single" | "combo" | "set";
    name: string;
    price?: number | null;
    price_retail?: number | null;
    bottle_options?: string[] | null;
    image_url?: string | null;
  }

  interface CartItem {
    slug: string;
    quantity: number;
  }

  const bottleLabel: Record<string, string> = { glass: "Thủy tinh", plastic: "Nhựa" };

  let products: ProductRow[] = [];
  let cart: CartItem[] = [];

  const productSelect = document.getElementById("product-select") as HTMLSelectElement;
  const quantityInput = document.getElementById("quantity") as HTMLInputElement;
  const addToCartBtn = document.getElementById("add-to-cart") as HTMLButtonElement;
  const cartList = document.getElementById("cart-list") as HTMLDivElement;
  const cartEmptyHint = document.getElementById("cart-empty-hint") as HTMLElement;
  const step1Next = document.getElementById("step1-next") as HTMLButtonElement;
  const bottleFieldset = document.getElementById("bottle-fieldset") as HTMLFieldSetElement;
  const deliveryDayWrap = document.getElementById("delivery-day-wrap") as HTMLElement;
  const districtSelect = document.getElementById("district") as HTMLSelectElement;
  const districtWarning = document.getElementById("district-warning") as HTMLElement;
  const orderSummary = document.getElementById("order-summary") as HTMLDivElement;
  const form = document.getElementById("order-form") as HTMLFormElement;
  const thankYou = document.getElementById("thank-you") as HTMLElement;
  const stepsIndicator = document.getElementById("steps-indicator")!;
  const bankInfo = document.getElementById("bank-info") as HTMLElement;
  const paymentMethodInputs =
    document.querySelectorAll<HTMLInputElement>('input[name="payment-method"]');

  function money(n?: number | null) {
    return n != null ? `${n.toLocaleString("vi-VN")}đ` : "Đang cập nhật giá";
  }

  function unitPrice(p: ProductRow) {
    return p.type === "single" ? p.price_retail : p.price;
  }

  function findProduct(slug: string) {
    return products.find((p) => p.slug === slug) ?? null;
  }

  // null nghĩa là chưa có giá cho ít nhất 1 sản phẩm trong giỏ — không cộng dồn thành 0,
  // vì "0đ" dễ hiểu nhầm là miễn phí thay vì "chưa có giá".
  function cartTotal(): number | null {
    let hasUnknownPrice = false;
    const total = cart.reduce((sum, item) => {
      const p = findProduct(item.slug);
      const price = p ? unitPrice(p) : null;
      if (price == null) hasUnknownPrice = true;
      return sum + (price ?? 0) * item.quantity;
    }, 0);
    return hasUnknownPrice ? null : total;
  }

  // Astro chỉ áp style scoped (data-astro-cid-*) cho phần tử render lúc build; phần tử
  // tạo bằng innerHTML từ script phải tự gắn thêm attribute này thì CSS mới nhận diện
  // được — nếu không, mọi class ở đây (kể cả kích thước ảnh thumbnail) sẽ bị bỏ qua
  // hoàn toàn và phá vỡ layout (cùng lỗi đã gặp và fix ở trang chi tiết blog).
  const cidAttrName = Array.from(cartList.attributes).find((a) => a.name.startsWith("data-astro-cid-"))?.name;
  const cid = cidAttrName ? ` ${cidAttrName}=""` : "";

  function renderCart() {
    cartEmptyHint.hidden = cart.length > 0;
    step1Next.hidden = cart.length === 0;

    cartList.innerHTML = cart
      .map((item, index) => {
        const p = findProduct(item.slug);
        if (!p) return "";
        const price = unitPrice(p);
        const priceLabel = price != null ? money(price * item.quantity) : "Đang cập nhật giá";
        const thumb = p.image_url
          ? `<img class="cart-item-thumb" src="${p.image_url}" alt=""${cid} loading="lazy" />`
          : `<div class="cart-item-thumb cart-item-thumb-placeholder"${cid}>🫚</div>`;
        return `
          <div class="cart-item" data-index="${index}"${cid}>
            ${thumb}
            <div class="cart-item-info"${cid}>
              <span class="cart-item-name"${cid}>${p.name}</span>
              <span class="cart-item-price"${cid}>${priceLabel}</span>
            </div>
            <div class="qty-stepper"${cid}>
              <button type="button" class="qty-btn qty-decrease" data-index="${index}"${cid} aria-label="Giảm số lượng">−</button>
              <span class="qty-value"${cid}>${item.quantity}</span>
              <button type="button" class="qty-btn qty-increase" data-index="${index}"${cid} aria-label="Tăng số lượng">+</button>
            </div>
            <button type="button" class="remove-item" data-index="${index}"${cid} aria-label="Xoá khỏi giỏ">🗑</button>
          </div>
        `;
      })
      .join("");

    if (cart.length > 0) {
      const total = cartTotal();
      cartList.innerHTML += `<div class="cart-total"${cid}>Tổng tạm tính <strong${cid}>${total != null ? money(total) : "Đang cập nhật giá"}</strong></div>`;
    }

    cartList.querySelectorAll<HTMLButtonElement>(".remove-item").forEach((btn) => {
      btn.addEventListener("click", () => {
        const index = Number(btn.dataset.index);
        cart = cart.filter((_, i) => i !== index);
        renderCart();
        renderStep2Options();
      });
    });

    cartList.querySelectorAll<HTMLButtonElement>(".qty-decrease").forEach((btn) => {
      btn.addEventListener("click", () => {
        const index = Number(btn.dataset.index);
        if (cart[index].quantity > 1) cart[index].quantity -= 1;
        else cart = cart.filter((_, i) => i !== index);
        renderCart();
        renderStep2Options();
      });
    });

    cartList.querySelectorAll<HTMLButtonElement>(".qty-increase").forEach((btn) => {
      btn.addEventListener("click", () => {
        const index = Number(btn.dataset.index);
        cart[index].quantity += 1;
        renderCart();
        renderStep2Options();
      });
    });
  }

  // Thêm trùng sản phẩm sẽ cộng dồn số lượng vào dòng đã có trong giỏ, không tạo
  // dòng riêng — số lượng từng dòng vẫn chỉnh được trực tiếp qua nút +/-.
  function addToCart() {
    const slug = productSelect.value;
    const qty = Math.max(1, Number(quantityInput.value) || 1);
    if (!slug) return;
    const existing = cart.find((item) => item.slug === slug);
    if (existing) existing.quantity += qty;
    else cart.push({ slug, quantity: qty });
    renderCart();
    renderStep2Options();
  }

  // Bước 2 áp dụng chung cho cả đơn (khách chọn 1 loại chai cho toàn bộ đơn thay vì
  // từng sản phẩm riêng) — tuỳ chọn hiện ra dựa trên các sản phẩm đang có trong giỏ.
  function renderStep2Options() {
    const cartProducts = cart.map((item) => findProduct(item.slug)).filter(Boolean) as ProductRow[];
    const allOptions = new Set<string>();
    cartProducts.forEach((p) => (p.bottle_options ?? []).forEach((o) => allOptions.add(o)));

    bottleFieldset.innerHTML = "<legend>Loại chai</legend>";
    if (allOptions.size === 0) {
      bottleFieldset.innerHTML += "<p>Không áp dụng cho các sản phẩm trong giỏ.</p>";
    } else {
      Array.from(allOptions).forEach((opt, i) => {
        const label = document.createElement("label");
        label.innerHTML = `<input type="radio" name="bottle-type" value="${opt}" ${i === 0 ? "checked" : ""}/> ${bottleLabel[opt] ?? opt}`;
        bottleFieldset.appendChild(label);
      });
    }

    deliveryDayWrap.hidden = !cartProducts.some((p) => p.type !== "single");
  }

  function goToStep(step: number) {
    document.querySelectorAll<HTMLElement>(".step").forEach((el) => {
      el.hidden = el.dataset.step !== String(step);
    });
    stepsIndicator.querySelectorAll("li").forEach((li) => {
      li.classList.toggle("active", li.getAttribute("data-step") === String(step));
    });
    if (step === 4) renderSummary();
  }

  function renderSummary() {
    if (cart.length === 0) return;
    const bottleType =
      (form.querySelector('input[name="bottle-type"]:checked') as HTMLInputElement)?.value ??
      "";
    const itemLines = cart
      .map((item) => {
        const p = findProduct(item.slug);
        return p ? `<p><strong>${p.name}</strong> × ${item.quantity}</p>` : "";
      })
      .join("");
    orderSummary.innerHTML = `
      ${itemLines}
      ${bottleType ? `<p>Loại chai: ${bottleLabel[bottleType] ?? bottleType}</p>` : ""}
      <p>Tạm tính: ${money(cartTotal())} (chưa gồm phí ship)</p>
      <p>Giao tới: ${(document.getElementById("address") as HTMLInputElement).value},
      ${districtSelect.value}</p>
    `;
  }

  // Cả 4 bước nằm trong 1 <form> duy nhất (chỉ ẩn/hiện qua CSS), nên nếu để trình duyệt
  // tự validate lúc bấm "Đặt hàng" ở bước 4, các input required của bước 3 (đã ẩn) sẽ
  // fail validation nhưng trình duyệt KHÔNG focus/hiện được lỗi trên field đang ẩn — kết
  // quả là nút "Đặt hàng" trông như không phản hồi gì cả, không có thông báo lỗi nào.
  // Fix: tắt validate tự động của form (novalidate) và tự gọi reportValidity() ngay lúc
  // rời bước 3 (khi field vẫn đang hiển thị, để lỗi hiện đúng chỗ) trước khi cho qua bước 4.
  function validateStep3(): boolean {
    const nameEl = document.getElementById("customer-name") as HTMLInputElement;
    const phoneEl = document.getElementById("phone") as HTMLInputElement;
    const addressEl = document.getElementById("address") as HTMLInputElement;
    // && ngắn mạch: nếu field đầu invalid thì field sau không bị gọi reportValidity()
    // chồng lên nhau (trình duyệt chỉ hiện được 1 bubble lỗi tại 1 thời điểm).
    return nameEl.reportValidity() && phoneEl.reportValidity() && addressEl.reportValidity();
  }

  document.querySelectorAll<HTMLButtonElement>("[data-next]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const next = Number(btn.dataset.next);
      if (next === 2 && cart.length === 0) return;
      if (next === 4 && !validateStep3()) return;
      goToStep(next);
    });
  });
  document.querySelectorAll<HTMLButtonElement>("[data-back]").forEach((btn) => {
    btn.addEventListener("click", () => goToStep(Number(btn.dataset.back)));
  });

  addToCartBtn.addEventListener("click", addToCart);

  districtSelect.addEventListener("change", () => {
    districtWarning.hidden = districtSelect.value !== "Khác";
  });

  paymentMethodInputs.forEach((input) => {
    input.addEventListener("change", () => {
      bankInfo.hidden = input.value !== "bank_transfer" || !input.checked;
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy ?? "";
      const original = btn.textContent;
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = "Đã sao chép ✓";
        btn.classList.add("copied");
      } catch {
        alert("Không sao chép được, vui lòng copy thủ công: " + text);
        return;
      }
      setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove("copied");
      }, 1500);
    });
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (cart.length === 0) return;
    // Phòng trường hợp người dùng tới được bước 4 mà chưa qua kiểm tra ở bước 3
    // (vd. bấm lùi/tiến bằng nút back của trình duyệt) — quay lại bước 3 để field
    // lỗi hiển thị đúng chỗ thay vì để nút "Đặt hàng" im lặng không phản hồi.
    if (!validateStep3()) {
      goToStep(3);
      return;
    }

    const bottleType =
      (form.querySelector('input[name="bottle-type"]:checked') as HTMLInputElement)?.value ??
      "glass";
    const paymentMethod =
      (form.querySelector('input[name="payment-method"]:checked') as HTMLInputElement)?.value ??
      "cod";

    const { data, error } = await supabase
      .from("orders")
      .insert({
        phone: (document.getElementById("phone") as HTMLInputElement).value,
        customer_name: (document.getElementById("customer-name") as HTMLInputElement).value,
        address: (document.getElementById("address") as HTMLInputElement).value,
        district: districtSelect.value,
        items: cart.map((item) => ({ productSlug: item.slug, quantity: item.quantity })),
        bottle_type: bottleType,
        bottles_returned:
          Number((document.getElementById("bottles-returned") as HTMLInputElement).value) || 0,
        payment_method: paymentMethod,
      })
      .select()
      .single();

    if (error || !data) {
      alert("Có lỗi khi đặt hàng, vui lòng thử lại: " + (error?.message ?? "unknown"));
      return;
    }

    form.hidden = true;
    stepsIndicator.hidden = true;
    thankYou.hidden = false;
    (document.getElementById("order-id") as HTMLElement).textContent = orderCode(data.phone, data.id);
  });

  // Load danh sách sản phẩm + đọc query string ?product=slug
  const { data: allProducts } = await supabase
    .from("products")
    .select("slug, type, name, price, price_retail, bottle_options, image_url")
    .order("sort_order");

  products = allProducts ?? [];
  productSelect.innerHTML = products
    .map((p) => `<option value="${p.slug}">${p.name}</option>`)
    .join("");

  const preselectedSlug = new URLSearchParams(location.search).get("product");
  const initial = products.find((p) => p.slug === preselectedSlug) ?? null;

  if (initial) {
    productSelect.value = initial.slug;
    cart.push({ slug: initial.slug, quantity: 1 });
  }
  renderCart();
  renderStep2Options();
</script>

<style>
  .order-page {
    max-width: 880px;
    margin: 0 auto;
    padding: 1.5rem;
  }

  #order-form {
    background: #fff;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: 1.8rem;
  }

  @media (min-width: 720px) {
    #order-form {
      padding: 2.4rem;
    }
  }

  .steps-indicator {
    display: flex;
    justify-content: space-between;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    font-size: 0.85rem;
  }

  .steps-indicator li {
    flex: 1;
    text-align: center;
    color: #9ca3af;
    border-bottom: 3px solid var(--color-bg-alt);
    padding-bottom: 0.5rem;
  }

  .steps-indicator li.active {
    color: var(--color-primary);
    border-color: var(--color-primary);
    font-weight: 600;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .step label {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .step input,
  .step select {
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1.5px solid #e2ddd0;
    font-weight: 400;
    font-family: var(--font-body);
    transition: border-color 0.15s ease;
  }

  .step input:focus,
  .step select:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .product-picker {
