---
import BaseLayout from "../layouts/BaseLayout.astro";
import CustomSelect from "../components/CustomSelect.astro";
import CustomInput from "../components/CustomInput.astro";
import DatePicker from "../components/DatePicker.astro";
import { BANK_QR_URL, DEPOSIT_LABEL } from "../lib/payment";
import PaymentReceiptUpload from "../components/PaymentReceiptUpload.astro";
import { VIETNAMESE_MOBILE_PATTERN } from "../lib/input-validation";
---

<BaseLayout
  title="Đặt hàng — GỪNG DETOX"
  description="Đặt hàng đồ uống/combo GỪNG DETOX và tra cứu trạng thái đơn bằng mã đơn và số điện thoại."
>
  <main class="order-page">
    <div class="ginger-shot-schedule-note">
      <h3>🛵 Lịch giao Ginger Shot</h3>
      <p>
        Giao <strong>định kỳ mỗi 7 ngày</strong>, tính từ lần nhận hàng gần nhất (VD: nhận
        <strong>Thứ 2</strong> → giao tiếp <strong>Thứ 2 tuần sau</strong>) 💚
      </p>
      <p>
        🌿 Muốn đổi ngày giao? Báo Tiệm qua SĐT <a href="tel:0888267009">088 826 7009</a>, Tiệm sẽ
        linh hoạt điều chỉnh và luôn nhắn xác nhận trước mỗi lần giao.
      </p>
    </div>

    <ol class="steps-indicator" id="steps-indicator">
      <li data-step="1" class="active">
        <span class="step-badge">1</span>
        <span class="step-label">Sản phẩm</span>
      </li>
      <li data-step="2">
        <span class="step-badge">2</span>
        <span class="step-label">Tuỳ chọn</span>
      </li>
      <li data-step="3">
        <span class="step-badge">3</span>
        <span class="step-label">Giao hàng</span>
      </li>
      <li data-step="4">
        <span class="step-badge">4</span>
        <span class="step-label">Xác nhận</span>
      </li>
      <li data-step="5">
        <span class="step-badge">5</span>
        <span class="step-label">Thanh toán</span>
      </li>
    </ol>

    <form id="order-form" novalidate>
      <!-- Bước 1 — Sản phẩm -->
      <section class="step" data-step="1">
        <h2>🛒 Bước 1 — Sản phẩm</h2>
        <div class="product-picker">
          <label class="product-picker-select">
            Chọn sản phẩm
            <CustomSelect id="product-select" />
          </label>
          <CustomInput label="Số lượng" type="number" id="quantity" min="1" value="1" />
          <button type="button" id="add-to-cart" class="add-cart-btn">+ Thêm vào giỏ hàng</button>
        </div>

        <div id="cart-list" class="cart-list"></div>
        <p id="cart-empty-hint" class="cart-empty-hint">Giỏ hàng đang trống — thêm ít nhất 1 sản phẩm để tiếp tục.</p>

        <button type="button" class="next" data-next="2" id="step1-next">Tiếp tục</button>
      </section>

      <!-- Bước 2 — Tuỳ chọn -->
      <section class="step" data-step="2" hidden>
        <h2>🕐 Bước 2 — Tuỳ chọn</h2>
        <div class="form-row">
          <DatePicker id="delivery-date" label="Ngày giao mong muốn" required />
        </div>
        <fieldset id="delivery-slot-fieldset" class="delivery-slot-fieldset" aria-describedby="delivery-slot-error">
          <legend>Khung giờ giao mong muốn <span class="required-mark" aria-hidden="true">*</span></legend>
          <div class="option-grid">
            <label class="option-card">
              <input type="radio" name="delivery-slot" value="8h-12h" required />
              <span class="option-icon">☀️</span>
              <span class="option-text">
                <span class="option-title">Sáng</span>
                <span class="option-subtitle">8h - 12h</span>
              </span>
            </label>
            <label class="option-card">
              <input type="radio" name="delivery-slot" value="13h-17h" />
              <span class="option-icon">🌤️</span>
              <span class="option-text">
                <span class="option-title">Chiều</span>
                <span class="option-subtitle">13h - 17h</span>
              </span>
            </label>
            <label class="option-card">
              <input type="radio" name="delivery-slot" value="18h-21h" />
              <span class="option-icon">🌙</span>
              <span class="option-text">
                <span class="option-title">Tối</span>
                <span class="option-subtitle">18h - 21h</span>
              </span>
            </label>
          </div>
          <span id="delivery-slot-error" class="field-error" aria-live="polite" hidden>Vui lòng chọn khung giờ giao</span>
        </fieldset>
        <label>
          Ghi chú giao hàng (không bắt buộc)
          <textarea
            id="delivery-note"
            rows="2"
            maxlength="1000"
            placeholder="VD: gọi trước khi giao, để ở cổng, giao giờ hành chính..."
          ></textarea>
        </label>
        <div class="nav-row">
          <button type="button" class="back" data-back="1">Quay lại</button>
          <button type="button" class="next" data-next="3">Tiếp tục</button>
        </div>
      </section>

      <!-- Bước 3 — Thông tin giao hàng -->
      <section class="step" data-step="3" hidden>
        <h2>📍 Bước 3 — Thông tin giao hàng</h2>
        <div class="form-row">
          <CustomInput label="Họ tên" id="customer-name" autocomplete="name" maxlength="100" required requiredMessage="Vui lòng nhập họ tên" />
          <CustomInput
            label="Số điện thoại"
            type="tel"
            id="phone"
            autocomplete="tel"
            inputmode="tel"
            pattern={VIETNAMESE_MOBILE_PATTERN}
            title="Số điện thoại không hợp lệ"
            required
            requiredMessage="Vui lòng nhập số điện thoại"
          />
        </div>
        <CustomInput label="Địa chỉ" id="address" autocomplete="street-address" maxlength="300" required requiredMessage="Vui lòng nhập địa chỉ" />
        <div class="form-row">
          <label>
            Quận
            <CustomSelect id="district">
              <option value="Quận 1">Quận 1</option>
              <option value="Quận 3">Quận 3</option>
              <option value="Quận 4">Quận 4</option>
              <option value="Quận 5">Quận 5</option>
              <option value="Quận 6">Quận 6</option>
              <option value="Quận 7">Quận 7</option>
              <option value="Quận 8">Quận 8</option>
              <option value="Quận 10">Quận 10</option>
              <option value="Quận 11">Quận 11</option>
              <option value="Quận 12">Quận 12</option>
              <option value="Bình Thạnh">Bình Thạnh</option>
              <option value="Bình Tân">Bình Tân</option>
              <option value="Gò Vấp">Gò Vấp</option>
              <option value="Phú Nhuận">Phú Nhuận</option>
              <option value="Tân Bình">Tân Bình</option>
              <option value="Tân Phú">Tân Phú</option>
              <option value="Thủ Đức">Thủ Đức</option>
              <option value="Bình Chánh">Bình Chánh</option>
              <option value="Cần Giờ">Cần Giờ</option>
              <option value="Củ Chi">Củ Chi</option>
              <option value="Hóc Môn">Hóc Môn</option>
              <option value="Nhà Bè">Nhà Bè</option>
              <option value="Khác">Khác (ngoài khu vực giao chuẩn)</option>
            </CustomSelect>
          </label>
          <CustomInput label="Số chai cũ muốn trả (nếu có)" type="number" id="bottles-returned" min="0" value="0" />
        </div>
        <p id="district-warning" class="warning" hidden>
          ⚠️ Ngoài khu vực giao hàng chuẩn — vui lòng <a href="https://zalo.me/0888267009" target="_blank" rel="noopener">liên hệ tiệm qua Zalo</a> để được tư vấn trước khi đặt.
        </p>
        <div class="nav-row">
          <button type="button" class="back" data-back="2">Quay lại</button>
          <button type="button" class="next" data-next="4">Tiếp tục</button>
        </div>
      </section>

      <!-- Bước 4 — Xác nhận -->
      <section class="step" data-step="4" hidden>
        <h2>✅ Bước 4 — Xác nhận</h2>

        <div class="confirm-grid">
          <div class="confirm-col">
            <div id="order-summary" class="order-summary"></div>

            <p class="shipping-note">
              🚚 Phí ship tùy theo khoảng cách và thời tiết hôm giao — tiệm sẽ báo cụ thể qua Zalo
              trước khi giao.
            </p>
          </div>

          <div class="confirm-col">
            <fieldset id="payment-method-fieldset" class="payment-method">
              <legend>Hình thức thanh toán</legend>
              <div class="option-grid option-grid--cols-2">
                <label class="option-card">
                  <input type="radio" name="payment-method" value="bank_transfer" checked />
                  <span class="option-icon">🏦</span>
                  <span class="option-text">
                    <span class="option-title">Chuyển khoản</span>
                    <span class="option-subtitle">Trước khi giao</span>
                  </span>
                </label>
                <label class="option-card">
                  <input type="radio" name="payment-method" value="deposit" />
                  <span class="option-icon">💵</span>
                  <span class="option-text">
                    <span class="option-title">{DEPOSIT_LABEL}</span>
                    <span class="option-subtitle">Để xác nhận đơn</span>
                  </span>
                </label>
              </div>
              <label class="option-card">
                <input type="radio" name="payment-method" value="zalo" />
                <span class="option-icon">💬</span>
                <span class="option-text">
                  <span class="option-title">Liên hệ qua Zalo</span>
                  <span class="option-subtitle">Nhắn tiệm để được hướng dẫn thanh toán</span>
                </span>
              </label>
            </fieldset>

            <div class="bank-info" id="bank-info">
              <p class="bank-info-title">💳 Thông tin chuyển khoản</p>
              <p id="payment-instructions">Vui lòng chuyển khoản trước khi giao hàng.</p>
              <p id="payment-order-hint">Bấm Tiếp tục để nhận mã QR và nội dung chuyển khoản theo mã đơn.</p>
              <div class="bank-info-body">
                <img
                  class="qr-code"
                  src={BANK_QR_URL}
                  alt="Mã QR chuyển khoản Vietcombank HKD GUNG DETOX"
                  width="200"
                  height="200"
                  loading="lazy"
                  hidden
                />
                <dl class="bank-details">
                  <div class="bank-details-row">
                    <dt>Ngân hàng</dt>
                    <dd>Vietcombank</dd>
                  </div>
                  <div class="bank-details-row">
                    <dt>Số tài khoản</dt>
                    <dd class="account-number">
                      <span>1065425789</span>
                      <button type="button" class="copy-btn" data-copy="1065425789">Sao chép</button>
                    </dd>
                  </div>
                  <div class="bank-details-row">
                    <dt>Chủ tài khoản</dt>
                    <dd>HKD GUNG DETOX</dd>
                  </div>
                  <div class="bank-details-row" id="transfer-content-row" hidden>
                    <dt>Nội dung chuyển khoản</dt>
                    <dd class="account-number"><span id="transfer-content"></span><button type="button" class="copy-btn" id="copy-transfer-content">Sao chép</button></dd>
                  </div>
                </dl>
              </div>
            </div>
          </div>
        </div>

        <div class="nav-row">
          <button type="button" class="back" data-back="3">Quay lại</button>
          <button type="submit" class="submit">Tiếp tục</button>
        </div>
      </section>
    </form>

    <!-- Trang cảm ơn -->
    <section id="thank-you" class="step thank-you-card" data-step="5" hidden>
      <div class="success-icon" aria-hidden="true">🏦</div>
      <h2 id="payment-step-title">Thanh toán đơn hàng</h2>
      <p id="payment-step-description" class="thank-you-sub">Chuyển khoản theo thông tin bên dưới, chọn ảnh giao dịch rồi xác nhận.</p>

      <div class="order-id-box" id="payment-order-code">
        <span class="order-id-label">Mã đơn của bạn</span>
        <div class="order-id-row">
          <strong id="order-id"></strong>
          <button type="button" class="copy-btn" id="copy-order-id">Sao chép</button>
        </div>
      </div>

      <p id="payment-followup-note" class="thank-you-note">📞 Tiệm sẽ liên hệ qua Zalo/hotline để xác nhận và báo phí ship cụ thể.</p>

      <div id="zalo-contact" hidden>
        <a href="https://zalo.me/0888267009" target="_blank" rel="noopener" aria-label="Mở Zalo của GỪNG DETOX">
          <img src="https://api.qrserver.com/v1/create-qr-code/?size=240x240&data=https%3A%2F%2Fzalo.me%2F0888267009"
            width="240" height="240" alt="Mã QR liên hệ Zalo GỪNG DETOX" loading="lazy" />
        </a>
        <p>Quét mã QR bằng điện thoại hoặc bấm nút bên dưới để nhắn tiệm.</p>
        <strong>GỪNG DETOX · 088 826 7009</strong>
        <div class="zalo-message-box">
          <p id="zalo-message-label">Sao chép lời nhắn rồi dán vào cuộc trò chuyện với tiệm:</p>
          <p id="zalo-message" aria-labelledby="zalo-message-label"></p>
          <button type="button" class="copy-btn" id="copy-zalo-message">Sao chép lời nhắn</button>
        </div>
      </div>

      <PaymentReceiptUpload />

      <div class="thank-you-actions">
        <button type="button" id="payment-back" class="thank-you-btn back">Quay lại</button>
        <button type="submit" form="receipt-form" id="receipt-submit" class="thank-you-btn thank-you-btn-primary" disabled>Xác nhận đặt hàng</button>
        <a href="https://zalo.me/0888267009" id="payment-zalo" class="thank-you-btn thank-you-btn-primary" target="_blank" rel="noopener" hidden>Nhắn tiệm qua Zalo</a>
        <a href="/" id="payment-home" class="thank-you-btn thank-you-btn-primary" hidden>Về trang chủ</a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { escapeHtml as esc, safeMediaUrl } from "../lib/output";
  import { getAstroScopeHtml } from "../lib/astro-scope";
  import { supabase } from "../lib/supabase";
  import { orderCode, type ProductRow } from "../lib/templates";
  import { getPaymentInstructions } from "../lib/payment";
  import { getCheckoutProducts, assertCheckoutAvailable, getInitialCheckoutItem, getCartBottleType } from "../lib/checkout-products";
  import { getProductUnitPrice as unitPrice, snapshotOrderItems, getOrderAmount } from "../lib/order-pricing";
  import { normalizeVietnamesePhone } from "../lib/input-validation";

  import { localDateValue } from "../lib/local-date";
  interface CartItem {
    slug: string;
    quantity: number;
  }

  function formatDeliveryDate(dateStr: string): string {
    if (!dateStr) return "";
    const [y, m, d] = dateStr.split("-");
    return `${d}/${m}/${y}`;
  }

  let products: ProductRow[] = [];
  let cart: CartItem[] = [];

  const productSelect = document.getElementById("product-select") as HTMLSelectElement;
  const quantityInput = document.getElementById("quantity") as HTMLInputElement;
  const addToCartBtn = document.getElementById("add-to-cart") as HTMLButtonElement;
  const cartList = document.getElementById("cart-list") as HTMLDivElement;
  const cartEmptyHint = document.getElementById("cart-empty-hint") as HTMLElement;
  const step1Next = document.getElementById("step1-next") as HTMLButtonElement;
  const deliveryDateInput = document.getElementById("delivery-date") as HTMLInputElement;
  const deliveryNoteInput = document.getElementById("delivery-note") as HTMLTextAreaElement;

  const deliverySlotLabel: Record<string, string> = {
    "8h-12h": "Sáng (8h - 12h)",
    "13h-17h": "Chiều (13h - 17h)",
    "18h-21h": "Tối (18h - 21h)",
  };

  function deliveryTimeRangeText(): string {
    const value = (form.querySelector('input[name="delivery-slot"]:checked') as HTMLInputElement)
      ?.value;
    return value ? deliverySlotLabel[value] ?? value : "";
  }
  const districtSelect = document.getElementById("district") as HTMLSelectElement;
  const districtWarning = document.getElementById("district-warning") as HTMLElement;
  const orderSummary = document.getElementById("order-summary") as HTMLDivElement;
  const form = document.getElementById("order-form") as HTMLFormElement;
  const thankYou = document.getElementById("thank-you") as HTMLElement;
  const stepsIndicator = document.getElementById("steps-indicator")!;
  const bankInfo = document.getElementById("bank-info") as HTMLElement;
  const bankInfoParent = bankInfo.parentElement!;
  const paymentBack = document.getElementById("payment-back") as HTMLButtonElement;
  let pendingOrderId: string | null = null;
  const bankTitle = bankInfo.querySelector(".bank-info-title") as HTMLElement;
  const bankQr = bankInfo.querySelector(".qr-code") as HTMLImageElement;
  const paymentInstructions = document.getElementById("payment-instructions") as HTMLElement;
  const depositInput = document.querySelector<HTMLInputElement>(
    'input[name="payment-method"][value="deposit"]'
  )!;
  const paymentMethodInputs =
    document.querySelectorAll<HTMLInputElement>('input[name="payment-method"]');

  function isZaloPayment() {
    return form.querySelector<HTMLInputElement>('input[name="payment-method"]:checked')?.value === "zalo";
  }

  function updatePaymentInstructions(code?: string) {
    const payment = getPaymentInstructions(depositInput.checked, code);
    bankInfo.hidden = isZaloPayment();
    bankTitle.textContent = payment.title;
    paymentInstructions.textContent = payment.instructions;
    bankQr.src = payment.qrUrl;
    bankQr.hidden = !code;
    document.getElementById("payment-order-hint")!.hidden = !!code;
    document.getElementById("transfer-content-row")!.hidden = !code;
    document.getElementById("transfer-content")!.textContent = payment.transferContent;
    document.getElementById("copy-transfer-content")!.dataset.copy = payment.transferContent;
    return payment;
  }

  function money(n?: number | null) {
    return n != null ? `${n.toLocaleString("vi-VN")}đ` : "Đang cập nhật giá";
  }

  function findProduct(slug: string) {
    return products.find((p) => p.slug === slug) ?? null;
  }

  // null nghĩa là chưa có giá cho ít nhất 1 sản phẩm trong giỏ — không cộng dồn thành 0,
  // vì "0đ" dễ hiểu nhầm là miễn phí thay vì "chưa có giá".
  function cartTotal(): number | null {
    return getOrderAmount(snapshotOrderItems(cart, products));
  }

  // Astro chỉ áp style scoped (data-astro-cid-*) cho phần tử render lúc build; phần tử
  // tạo bằng innerHTML từ script phải tự gắn thêm attribute này thì CSS mới nhận diện
  // được — nếu không, mọi class ở đây (kể cả kích thước ảnh thumbnail) sẽ bị bỏ qua
  // hoàn toàn và phá vỡ layout (cùng lỗi đã gặp và fix ở trang chi tiết blog).
  const cid = getAstroScopeHtml(cartList);

  function renderCart() {
    cartEmptyHint.hidden = cart.length > 0;
    step1Next.hidden = cart.length === 0;

    cartList.innerHTML = cart
      .map((item, index) => {
        const p = findProduct(item.slug);
        if (!p) return "";
        const price = unitPrice(p);
        const priceLabel = price != null ? money(price * item.quantity) : "Đang cập nhật giá";
        const thumb = p.image_url
          ? `<img class="cart-item-thumb" src="${esc(safeMediaUrl(p.image_url))}" alt=""${cid} loading="lazy" />`
          : `<div class="cart-item-thumb cart-item-thumb-placeholder"${cid}>🫚</div>`;
        return `
          <div class="cart-item" data-index="${index}"${cid}>
            ${thumb}
            <div class="cart-item-info"${cid}>
              <span class="cart-item-name"${cid}>${esc(p.name)}</span>
              <span class="cart-item-price"${cid}>${priceLabel}</span>
            </div>
            <div class="qty-stepper"${cid}>
              <button type="button" class="qty-btn qty-decrease" data-index="${index}"${cid} aria-label="Giảm số lượng">−</button>
              <span class="qty-value"${cid}>${item.quantity}</span>
              <button type="button" class="qty-btn qty-increase" data-index="${index}"${cid} aria-label="Tăng số lượng">+</button>
            </div>
            <button type="button" class="remove-item" data-index="${index}"${cid} aria-label="Xoá khỏi giỏ">🗑</button>
          </div>
        `;
      })
      .join("");

    if (cart.length > 0) {
      const total = cartTotal();
      cartList.innerHTML += `<div class="cart-total"${cid}>Tổng tạm tính <strong${cid}>${total != null ? money(total) : "Đang cập nhật giá"}</strong></div>`;
    }

    cartList.querySelectorAll<HTMLButtonElement>(".remove-item").forEach((btn) => {
      btn.addEventListener("click", () => {
        const index = Number(btn.dataset.index);
        cart = cart.filter((_, i) => i !== index);
        renderCart();
      });
    });

    cartList.querySelectorAll<HTMLButtonElement>(".qty-decrease").forEach((btn) => {
      btn.addEventListener("click", () => {
        const index = Number(btn.dataset.index);
        if (cart[index].quantity > 1) cart[index].quantity -= 1;
        else cart = cart.filter((_, i) => i !== index);
        renderCart();
      });
    });

    cartList.querySelectorAll<HTMLButtonElement>(".qty-increase").forEach((btn) => {
      btn.addEventListener("click", () => {
        const index = Number(btn.dataset.index);
        cart[index].quantity += 1;
        renderCart();
      });
    });
  }

  // Thêm trùng sản phẩm sẽ cộng dồn số lượng vào dòng đã có trong giỏ, không tạo
  // dòng riêng — số lượng từng dòng vẫn chỉnh được trực tiếp qua nút +/-.
  function addToCart() {
    const slug = productSelect.value;
    const qty = Math.max(1, Number(quantityInput.value) || 1);
    if (!slug) return;
    const existing = cart.find((item) => item.slug === slug);
    if (existing) existing.quantity += qty;
    else cart.push({ slug, quantity: qty });
    renderCart();
    // Trả số lượng về 1 sau khi thêm — tránh giữ lại số lượng cũ khiến lần thêm
    // tiếp theo (kể cả khi đổi sang sản phẩm khác) vô tình cộng nhầm số lượng lớn.
    quantityInput.value = "1";
  }

  productSelect.addEventListener("change", () => {
    quantityInput.value = "1";
  });

  function goToStep(step: number) {
    document.querySelectorAll<HTMLElement>(".step").forEach((el) => {
      el.hidden = el.dataset.step !== String(step);
    });
    form.hidden = step === 5;
    stepsIndicator.querySelectorAll("li").forEach((li) => {
      const liStep = Number(li.getAttribute("data-step"));
      li.classList.toggle("active", liStep === step);
      li.classList.toggle("done", liStep < step);
    });
    if (step === 4) renderSummary();
  }

  function renderSummary() {
    if (cart.length === 0) return;
    const itemLines = cart
      .map((item) => {
        const p = findProduct(item.slug);
        return p ? `<p><strong>${esc(p.name)}</strong> × ${item.quantity}</p>` : "";
      })
      .join("");
    orderSummary.innerHTML = `
      ${itemLines}
      <p>Ngày giao: ${formatDeliveryDate(deliveryDateInput.value)}${deliveryTimeRangeText() ? ` (${esc(deliveryTimeRangeText())})` : ""}</p>
      ${deliveryNoteInput.value ? `<p>Ghi chú: ${esc(deliveryNoteInput.value)}</p>` : ""}
      <p>Tạm tính: ${money(cartTotal())} (chưa gồm phí ship)</p>
      <p>Giao tới: ${esc((document.getElementById("address") as HTMLInputElement).value)},
      ${esc(districtSelect.value)}</p>
    `;
  }

  const deliverySlotRadios = document.querySelectorAll<HTMLInputElement>('input[name="delivery-slot"]');
  const firstDeliverySlotRadio = deliverySlotRadios[0];
  const deliverySlotFieldset = document.getElementById("delivery-slot-fieldset")!;
  const deliverySlotError = document.getElementById("delivery-slot-error")!;
  firstDeliverySlotRadio.addEventListener("invalid", (event) => {
    event.preventDefault();
    deliverySlotFieldset.setAttribute("aria-invalid", "true");
    deliverySlotError.hidden = false;
  });
  deliverySlotRadios.forEach((radio) => {
    radio.addEventListener("change", () => {
      deliverySlotFieldset.removeAttribute("aria-invalid");
      deliverySlotError.hidden = true;
    });
  });

  // Validate each step explicitly because required fields in other steps are hidden.
  function validateStep2(): boolean {
    const dateValid = deliveryDateInput.checkValidity();
    const slotValid = firstDeliverySlotRadio.checkValidity();
    if (!dateValid || !slotValid) {
      goToStep(2);
      if (!dateValid) document.getElementById("delivery-date-trigger")!.focus();
      else firstDeliverySlotRadio.focus();
    }
    return dateValid && slotValid;
  }

  function validateStep3(): boolean {
    const inputs = ["customer-name", "phone", "address"].map((id) => document.getElementById(id) as HTMLInputElement);
    inputs.forEach((input) => {
      input.value = input.id === "phone" ? normalizeVietnamesePhone(input.value) : input.value.trim();
    });
    const invalidInputs = inputs.filter((input) => !input.checkValidity());
    if (invalidInputs.length) {
      goToStep(3);
      invalidInputs[0].focus();
    }
    return invalidInputs.length === 0;
  }

  document.querySelectorAll<HTMLButtonElement>("[data-next]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const next = Number(btn.dataset.next);
      if (next === 2 && cart.length === 0) return;
      if (next === 3 && !validateStep2()) return;
      if (next === 4 && !validateStep3()) return;
      goToStep(next);
    });
  });
  document.querySelectorAll<HTMLButtonElement>("[data-back]").forEach((btn) => {
    btn.addEventListener("click", () => goToStep(Number(btn.dataset.back)));
  });

  addToCartBtn.addEventListener("click", addToCart);

  districtSelect.addEventListener("change", () => {
    districtWarning.hidden = districtSelect.value !== "Khác";
  });

  paymentMethodInputs.forEach((input) => {
    input.addEventListener("change", () => updatePaymentInstructions());
  });
  updatePaymentInstructions();

  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy ?? "";
      const original = btn.textContent;
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = "Đã sao chép ✓";
        btn.classList.add("copied");
      } catch {
        alert("Không sao chép được, vui lòng copy thủ công: " + text);
        return;
      }
      setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove("copied");
      }, 1500);
    });
  });

  function getCheckoutOrderData() {
    const payment = updatePaymentInstructions();
    const orderNote = [deliveryNoteInput.value.trim() || "(không có)", payment.orderNote].filter(Boolean).join(". ");
    return {
      phone: (document.getElementById("phone") as HTMLInputElement).value,
      customer_name: (document.getElementById("customer-name") as HTMLInputElement).value,
      address: (document.getElementById("address") as HTMLInputElement).value,
      district: districtSelect.value,
      items: snapshotOrderItems(cart, products),
      bottle_type: getCartBottleType(cart, products),
      bottles_returned:
        Number((document.getElementById("bottles-returned") as HTMLInputElement).value) || 0,
      payment_method: payment.paymentMethod,
      delivery_date: deliveryDateInput.value,
      delivery_time: deliveryTimeRangeText(),
      delivery_note: deliveryNoteInput.value.trim(),
      is_deposit: Boolean(payment.orderNote),
      // Keep a readable note for older clients while new clients use structured fields.
      shipping_fee_note: `Giao ngày ${formatDeliveryDate(deliveryDateInput.value)}${deliveryTimeRangeText() ? ` (${esc(deliveryTimeRangeText())})` : ""}. Ghi chú của khách: ${orderNote}. Phí ship tùy theo khoảng cách và thời tiết hôm giao, tiệm sẽ báo lại qua Zalo trước khi giao.`,
    };
  }

  function setContactMode(isZalo: boolean) {
    document.getElementById("zalo-contact")!.hidden = !isZalo;
    document.getElementById("payment-zalo")!.hidden = !isZalo;
    document.getElementById("payment-order-code")!.hidden = isZalo;
    document.getElementById("payment-followup-note")!.hidden = isZalo;
    document.getElementById("receipt-form")!.hidden = isZalo;
    document.getElementById("receipt-submit")!.hidden = isZalo;
    bankInfo.hidden = isZalo;
    thankYou.querySelector<HTMLElement>(".success-icon")!.textContent = isZalo ? "💬" : "🏦";
    document.getElementById("payment-step-title")!.textContent = isZalo ? "Nhắn tiệm qua Zalo" : "Thanh toán đơn hàng";
    document.getElementById("payment-step-description")!.textContent = isZalo
      ? "Tiệm sẽ tư vấn, xác nhận thông tin đặt hàng và hướng dẫn bạn thanh toán trực tiếp qua Zalo."
      : "Chuyển khoản theo thông tin bên dưới, chọn ảnh giao dịch rồi xác nhận.";
  }

  function showPaymentStep() {
    const isZalo = isZaloPayment();
    setContactMode(isZalo);
    if (isZalo) {
      const selectedProducts = cart.map((item) =>
        `- ${findProduct(item.slug)?.name ?? item.slug}: số lượng ${item.quantity}`
      ).join("\n");
      const phone = (document.getElementById("phone") as HTMLInputElement).value.trim();
      const address = (document.getElementById("address") as HTMLInputElement).value.trim();
      const note = deliveryNoteInput.value.trim();
      const deliveryDetails = [
        `Số điện thoại: ${phone}`,
        `Địa chỉ giao: ${address}, ${districtSelect.value}`,
        `Ngày giao: ${formatDeliveryDate(deliveryDateInput.value)}`,
        `Giờ giao: ${deliveryTimeRangeText()}`,
        ...(note ? [`Ghi chú: ${note}`] : []),
      ].join("\n");
      const message = `Chào tiệm GỪNG DETOX, mình đang muốn mua:\n${selectedProducts}\n\n${deliveryDetails}\n\nNhờ tiệm tư vấn thêm và hướng dẫn mình đặt hàng, thanh toán nhé. Cảm ơn tiệm!`;
      document.getElementById("zalo-message")!.textContent = message;
      document.getElementById("copy-zalo-message")!.dataset.copy = message;
      goToStep(5);
      return;
    }
    // Reuse the same id across back-and-forth within a session so the displayed order
    // code stays stable; the order is only written after explicit confirmation.
    pendingOrderId ??= crypto.randomUUID();
    const code = orderCode((document.getElementById("phone") as HTMLInputElement).value, pendingOrderId);
    document.getElementById("order-id")!.textContent = code;
    document.getElementById("copy-order-id")!.dataset.copy = code;
    const receiptForm = document.getElementById("receipt-form")!;
    receiptForm.dataset.orderId = pendingOrderId;
    // getCheckoutOrderData() itself calls updatePaymentInstructions() with no code to
    // build shipping_fee_note — call it before the one below so the code-bearing call
    // (which sets the QR/transfer content shown to the customer) isn't reset afterward.
    receiptForm.dataset.orderData = JSON.stringify(getCheckoutOrderData());
    updatePaymentInstructions(code);
    thankYou.insertBefore(bankInfo, receiptForm);
    const receiptInput = document.getElementById("payment-receipt") as HTMLInputElement;
    (document.getElementById("receipt-submit") as HTMLButtonElement).disabled = !receiptInput.files?.length;
    goToStep(5);
  }

  paymentBack.addEventListener("click", () => {
    if (paymentBack.disabled) return;
    bankInfoParent.append(bankInfo);
    goToStep(4);
    form.querySelector<HTMLButtonElement>('button[type="submit"]')!.focus();
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    if (cart.length === 0 || button.disabled) return;
    // Phòng trường hợp người dùng tới được bước 4 mà chưa qua kiểm tra ở bước 2/3
    // (vd. bấm lùi/tiến bằng nút back của trình duyệt) — quay lại đúng bước để field
    // lỗi hiển thị đúng chỗ thay vì để nút "Đặt hàng" im lặng không phản hồi.
    if (!validateStep2() || !validateStep3()) return;
    button.disabled = true;
    try {
      await assertCheckoutAvailable(supabase, cart);
      showPaymentStep();
    } catch (error) {
      console.error("Không mở được bước thanh toán", { slugs: cart.map((item) => item.slug), error });
      alert(error instanceof Error ? error.message : "Không kiểm tra được sản phẩm. Vui lòng thử lại.");
    } finally {
      button.disabled = false;
    }
  });

  // Load danh sách sản phẩm + đọc query string ?product=slug
  try {
    products = await getCheckoutProducts(supabase);
  } catch (error) {
    console.error("Không tải được danh mục checkout", { error });
    cartEmptyHint.textContent = "Không tải được sản phẩm. Vui lòng tải lại trang để thử lại.";
    addToCartBtn.disabled = true;
    throw error;
  }

  const typeGroupLabel: Record<ProductRow["type"], string> = {
    single: "Đồ uống lẻ",
    combo: "Combo",
    set: "5 Set Detox",
  };
  const optionHtml = (p: ProductRow) =>
    `<option value="${esc(p.slug)}">${esc(p.name)} — ${money(unitPrice(p))}</option>`;

  productSelect.innerHTML = (["single", "combo", "set"] as const)
    .map((type) => {
      const group = products.filter((p) => p.type === type);
      if (group.length === 0) return "";
      return `<optgroup label="${typeGroupLabel[type]}">${group.map(optionHtml).join("")}</optgroup>`;
    })
    .join("");

  const initial = getInitialCheckoutItem(location.search, products);

  if (initial) {
    productSelect.value = initial.slug;
    cart.push(initial);
  }
  // Refresh the custom label after fetching options and applying the URL selection.
  productSelect.dispatchEvent(new Event("change"));
  renderCart();

  // Không cho chọn ngày giao trong quá khứ.
  deliveryDateInput.min = localDateValue(new Date());
</script>

