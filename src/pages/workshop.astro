---
import BaseLayout from "../layouts/BaseLayout.astro";

const registrationUrl = "https://zalo.me/0888267009";
const workshops = [
  {
    name: "Học làm Ginger Shot",
    poster: "ginger-shot-poster",
    width: 1086,
    height: 1448,
    description: "Tự làm những shot gừng từ gừng tươi, chanh vàng, nghệ và mật ong ngay tại nhà.",
    lessons: [
      "Shot Wake Up: gừng, chanh vàng và cam.",
      "Shot Glow Skin: gừng, thơm và nghệ.",
      "Video hướng dẫn chi tiết và công thức để thực hành tại nhà.",
    ],
  },
  {
    name: "Học làm Bia Gừng",
    poster: "bia-gung-poster",
    width: 1024,
    height: 1536,
    description: "Khám phá cách làm thức uống lên men từ gừng với nguyên liệu tự nhiên, dễ tìm.",
    lessons: [
      "Hướng dẫn làm bia gừng qua video, có thể xem lại.",
      "Công thức và tỷ lệ nguyên liệu để thực hành.",
      "Hỗ trợ giải đáp thắc mắc trong quá trình làm.",
    ],
  },
];
const benefits = [
  { icon: "🎬", title: "Video dễ theo dõi", description: "Hướng dẫn chi tiết, dễ hiểu, xem lại để thực hành từng bước." },
  { icon: "📖", title: "Công thức rõ ràng", description: "Công thức và tỷ lệ nguyên liệu giúp bạn tự làm tại nhà." },
  { icon: "🤝", title: "Hỗ trợ trọn đời", description: "Giải đáp thắc mắc của học viên trong quá trình làm." },
  { icon: "🕒", title: "Chủ động thời gian", description: "Học online 100%, học mọi lúc, mọi nơi theo lịch của bạn." },
];
---

<BaseLayout
  title="Workshop Ginger Shot & Bia Gừng — GỪNG DETOX"
  description="Học làm Ginger Shot và Bia Gừng tại nhà qua video, công thức và hỗ trợ học viên. Ưu đãi 360.000đ/khóa."
  image="/images/workshop/gung-detox-workshop.webp"
>
  <main class="workshop-page">
    <section class="workshop-hero">
      <div>
        <p class="eyebrow">WORKSHOP · GỪNG DETOX</p>
        <h1>Tự tay làm<br /><span>Ginger Shot & Bia Gừng</span></h1>
        <p class="lead">Từ nguyên liệu quen thuộc đến thức uống tự làm tại nhà. Cùng GỪNG học công thức, thực hành và kết nối với những người yêu lối sống lành mạnh.</p>
        <p class="hero-note">Học online 100% · Video hướng dẫn · Hỗ trợ học viên</p>
        <div class="actions">
          <a class="button" href="#cac-workshop">Khám phá workshop</a>
          <a class="text-link" href={registrationUrl} target="_blank" rel="noopener">Đăng ký qua Zalo</a>
        </div>
      </div>
      <img src="/images/workshop/gung-detox-workshop.webp" alt="Hình minh họa workshop Ginger Shot GỪNG DETOX: cùng thực hành và pha chế" width="1024" height="1536" fetchpriority="high" />
    </section>

    <section id="cac-workshop">
      <p class="eyebrow">CHỌN WORKSHOP CỦA BẠN</p>
      <h2>Hai công thức, nhiều niềm vui tự làm</h2>
      <div class="workshop-grid">
        {workshops.map((workshop) => (
          <article class="workshop-card surface-card">
            <a href={`/images/workshop/${workshop.poster}.webp`} target="_blank" rel="noopener" aria-label={`Xem đầy đủ poster ${workshop.name}`}>
              <img src={`/images/workshop/${workshop.poster}.webp`} alt={`Poster workshop ${workshop.name}, học online, ưu đãi 360.000đ/khóa`} width={workshop.width} height={workshop.height} loading="lazy" />
            </a>
            <div class="card-body">
              <h3>{workshop.name}</h3>
              <p>{workshop.description}</p>
              <ul>{workshop.lessons.map((lesson) => <li>{lesson}</li>)}</ul>
              <div class="price-row"><strong>360.000đ <small>/ khóa</small></strong><span>Ưu đãi giảm 40%</span></div>
              <a class="button" href={registrationUrl} target="_blank" rel="noopener">Đăng ký {workshop.name.replace("Học làm ", "")}</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section>
      <h2>Bạn nhận được gì?</h2>
      <div class="benefit-grid">
        {benefits.map((benefit) => (
          <article class="surface-card benefit-card">
            <span class="benefit-icon" aria-hidden="true">{benefit.icon}</span>
            <h3>{benefit.title}</h3>
            <p>{benefit.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="info-grid">
      <div class="surface-card info-card">
        <h2>Workshop dành cho ai?</h2>
        <ul>
          <li>Người bận rộn muốn tự làm đồ uống tại nhà.</li>
          <li>Các mẹ muốn chuẩn bị thức uống cho gia đình.</li>
          <li>Người yêu thích nguyên liệu tự nhiên và lối sống lành mạnh.</li>
          <li>Người muốn giao lưu, kết nối và chia sẻ kinh nghiệm pha chế.</li>
        </ul>
      </div>
      <div class="surface-card info-card">
        <h2>Học online & giao lưu</h2>
        <p><strong>Online:</strong> học qua video, chủ động thời gian và địa điểm.</p>
        <p><strong>Ginger Shot:</strong> giao lưu tại Cần Thơ, Hà Nội.</p>
        <p><strong>Bia Gừng:</strong> giao lưu tại Cần Thơ.</p>
        <p>Nhắn GỪNG để nhận lịch, địa điểm cụ thể và tư vấn hình thức tham gia.</p>
      </div>
    </section>

    <section>
      <h2>Cùng làm, cùng kết nối</h2>
      <div class="workshop-grid gallery">
        <figure>
          <img src="/images/workshop/ginger-shot-cong-thuc.webp" alt="Hình minh họa công thức Ginger Shot Wake Up và Glow Skin" width="1024" height="1536" loading="lazy" />
          <figcaption>Công thức Ginger Shot để thực hành tại nhà.</figcaption>
        </figure>
        <figure>
          <img src="/images/workshop/ginger-shot-thuc-hanh.webp" alt="Hình minh họa học viên cùng pha chế Ginger Shot trong workshop" width="1024" height="1536" loading="lazy" />
          <figcaption>Cùng thực hành và chia sẻ niềm vui pha chế.</figcaption>
        </figure>
      </div>
    </section>

    <section class="registration">
      <h2>Bắt đầu với workshop bạn yêu thích</h2>
      <p>Nhắn GỪNG để đăng ký Ginger Shot hoặc Bia Gừng và nhận thông tin ưu đãi.</p>
      <div class="actions">
        <a class="button" href={registrationUrl} target="_blank" rel="noopener">Đăng ký qua Zalo</a>
        <a class="text-link" href="tel:0888267009">Gọi 0888 267 009</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  #cac-workshop {
    scroll-margin-top: 6rem;
  }

  .workshop-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
  }

  section {
    margin-bottom: 3.5rem;
  }

  .workshop-hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3rem;
    align-items: center;
  }

  .eyebrow {
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  h1 {
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    line-height: 1.2;
  }

  h1 span {
    color: var(--color-primary);
  }

  .lead {
    font-size: 1.1rem;
    color: var(--color-text-muted);
  }

  .hero-note {
    color: var(--color-primary);
    font-weight: 600;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }

  .workshop-hero img, .gallery img {
    border-radius: var(--radius-lg);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .button {
    display: inline-block;
    border-radius: 999px;
    padding: 0.75rem 1.3rem;
    background: var(--color-primary);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
  }

  .button:hover {
    background: var(--color-primary-dark);
  }

  .text-link {
    font-weight: 600;
  }

  .workshop-grid, .info-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .workshop-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    align-items: flex-start;
  }

  .card-body h3 {
    font-size: 1.5rem;
  }

  .card-body p {
    margin: 0;
  }

  ul {
    padding-left: 1.25rem;
  }

  li + li {
    margin-top: 0.5rem;
  }

  .price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin: auto 0 1rem;
    padding-top: 0.5rem;
  }

  .price-row strong {
    color: var(--color-primary);
    font-size: 1.5rem;
  }

  .price-row small {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-weight: 400;
  }

  .price-row span {
    background: var(--color-bg-warm);
    color: var(--color-accent);
    border-radius: 999px;
    padding: 0.3rem 0.6rem;
    font-size: 0.85rem;
  }

  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .benefit-card, .info-card {
    padding: 1.5rem;
  }

  .benefit-icon {
    display: block;
    font-size: 1.8rem;
    margin-bottom: 0.7rem;
  }

  .benefit-card h3 {
    font-size: 1.05rem;
  }

  .benefit-card p {
    margin-bottom: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .info-card h2 {
    font-size: 1.4rem;
  }

  figure {
    margin: 0;
  }

  figcaption {
    margin-top: 0.75rem;
    color: var(--color-text-muted);
  }

  .registration {
    background: var(--color-primary-light);
    border-radius: var(--radius-lg);
    padding: 2rem;
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .workshop-hero {
      gap: 1.5rem;
    }
    .benefit-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .workshop-hero, .workshop-grid, .info-grid, .benefit-grid {
      grid-template-columns: 1fr;
    }
    .workshop-page {
      padding-top: 1.5rem;
    }
    .registration {
      padding: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
</style>
