---
import BaseLayout from "../layouts/BaseLayout.astro";

const registrationUrl = "https://zalo.me/0888267009";
const workshops = [
  {
    name: "Học làm Ginger Shot",
    poster: "ginger-shot-poster",
    width: 1086,
    height: 1448,
    details: [
      {
        title: "🌿 1. Nơi giải tỏa stress",
        description: "Tạm gác lại những bộn bề, dành cho mình một khoảng thời gian thư giãn, nạp năng lượng và tìm lại sự cân bằng.",
      },
      {
        title: "🫶 2. Nơi gặp gỡ và kết nối chị em",
        description: "Giao lưu, trò chuyện, chia sẻ lối sống lành mạnh, gặp gỡ những người có cùng sở thích và năng lượng tích cực.",
      },
      {
        title: "🥤 3. Nơi học làm đồ uống healthy",
        description: "Cùng GỪNG khám phá công thức Ginger Shot, Juice, Smoothies, Kombucha và sữa hạt – tự tay làm những thức uống tốt cho sức khỏe.",
      },
      {
        title: "🏡 4. Mang lối sống healthy về cho gia đình",
        description: "Học cách lựa chọn nguyên liệu, tự làm đồ uống lành mạnh để chăm sóc bản thân, người thân và cả gia đình mỗi ngày.",
      },
    ],
    closing: [
      "GỪNG – Không chỉ bán nước, GỪNG muốn lan tỏa một lối sống lành mạnh từ những điều giản dị nhất. 💚",
      "Sống lành, uống xanh – gặp nhau ở WORKSHOP GỪNG nhé!",
    ],
  },
  {
    name: "Học làm Bia Gừng",
    poster: "bia-gung-poster",
    width: 1024,
    height: 1536,
    introTitle: "WORKSHOP BIA GỪNG – TỰ TAY Ủ, TỰ TIN SỐNG LÀNH 🫚💛",
    description: "Không chỉ là một buổi học làm đồ uống, Workshop Bia Gừng tại GỪNG là dịp để bạn khám phá nghệ thuật lên men tự nhiên, trải nghiệm làm bia gừng thủ công và mang những công thức thú vị về nhà.",
    details: [
      {
        title: "🫚 1. Khám phá thế giới bia gừng",
        description: "Tìm hiểu về gừng tươi, nguyên liệu lên men, cách tạo nên hương vị bia gừng thơm nồng, chua nhẹ và sảng khoái.",
      },
      {
        title: "🍹 2. Tự tay thực hành làm bia gừng",
        description: "Trực tiếp trải nghiệm các công đoạn chuẩn bị nguyên liệu, pha chế, ủ và hoàn thiện một mẻ bia gừng handmade.",
      },
      {
        title: "🫶 3. Gặp gỡ và kết nối những người cùng sở thích",
        description: "Cùng chị em trò chuyện, chia sẻ kinh nghiệm, học hỏi và tận hưởng một buổi workshop thật vui tại GỪNG.",
      },
      {
        title: "🏡 4. Mang công thức về chăm sóc gia đình",
        description: "Biết cách tự làm, bảo quản và sáng tạo các phiên bản bia gừng tại nhà để cùng gia đình thưởng thức.",
      },
    ],
    closing: [
      "GỪNG – Không chỉ dạy bạn làm một thức uống, mà còn truyền cảm hứng để bạn tự tay tạo nên những điều lành mạnh cho cuộc sống. 💛",
      "Sống lành, uống xanh – trải nghiệm một ngày thật khác tại GỪNG!",
    ],
  },
];
const benefits = [
  { image: "anh-xinh-mang-ve", alt: "Chị em chụp ảnh cùng thành phẩm Ginger Shot tại GỪNG", title: "Ảnh xinh mang về", description: "Lưu lại những khoảnh khắc vui vẻ và đáng nhớ tại GỪNG." },
  { image: "tieng-cuoi-ket-noi", alt: "Chị em trò chuyện và cùng thưởng thức Ginger Shot", title: "Tiếng cười & kết nối", description: "Gặp gỡ chị em, cùng học hỏi và chia sẻ năng lượng tích cực." },
  { image: "thanh-pham-tu-tay-lam", alt: "Những chai Ginger Shot thành phẩm bên gừng và nghệ tươi", title: "Thành phẩm tự tay làm", description: "Hoàn thành mẻ Ginger Shot của riêng bạn sau buổi thực hành." },
  { image: "bay-ngay-cham-soc-ban-than", alt: "Hộp bảy chai Ginger Shot mang về chăm sóc bản thân", title: "7 ngày chăm sóc bản thân", description: "Mang về thành phẩm dùng trong 1 tuần, duy trì thói quen sống lành." },
];
---

<BaseLayout
  title="Workshop Ginger Shot & Bia Gừng — GỪNG DETOX"
  description="Học làm Ginger Shot và Bia Gừng tại nhà qua video, công thức và hỗ trợ học viên. Ưu đãi 550.000đ/người."
  image="/images/workshop/gung-detox-workshop.webp"
>
  <main class="workshop-page">
    <section class="registration">
      <h2>Bắt đầu với workshop bạn yêu thích</h2>
      <p>Nhắn GỪNG để đăng ký Ginger Shot hoặc Bia Gừng và nhận thông tin ưu đãi.</p>
      <div class="actions">
        <a class="button" href={registrationUrl} target="_blank" rel="noopener">Đăng ký qua Zalo</a>
        <a class="text-link" href="tel:0888267009">Gọi 0888 267 009</a>
      </div>
    </section>

    <section class="workshop-hero">
      <div>
        <p class="eyebrow">WORKSHOP · GỪNG DETOX</p>
        <h1>Tự tay làm<br /><span>Ginger Shot & Bia Gừng</span></h1>
        <p class="lead">Từ nguyên liệu quen thuộc đến thức uống tự làm tại nhà. Cùng GỪNG học công thức, thực hành và kết nối với những người yêu lối sống lành mạnh.</p>
        <p class="hero-note">Học offline 100% · Video hướng dẫn · Hỗ trợ học viên</p>
        <div class="actions">
          <a class="text-link" href="#cac-workshop">Khám phá workshop</a>
          <a class="button" href={registrationUrl} target="_blank" rel="noopener">Đăng ký qua Zalo</a>
        </div>
      </div>
      <img src="/images/workshop/gung-detox-workshop.webp" alt="Hình minh họa workshop Ginger Shot GỪNG DETOX: cùng thực hành và pha chế" width="1024" height="1536" fetchpriority="high" />
    </section>

    <section id="cac-workshop">
      <p class="eyebrow">CHỌN WORKSHOP CỦA BẠN</p>
      <h2>Hai công thức, nhiều niềm vui tự làm</h2>
      <div class="workshop-grid">
        {workshops.map((workshop) => (
          <article class="workshop-card surface-card">
            <a href={`/images/workshop/${workshop.poster}.webp`} target="_blank" rel="noopener" aria-label={`Xem đầy đủ poster ${workshop.name}`}>
              <img src={`/images/workshop/${workshop.poster}.webp`} alt={`Poster workshop ${workshop.name}, học online, ưu đãi 550.000đ/người`} width={workshop.width} height={workshop.height} loading="lazy" />
            </a>
            <div class="card-body">
              <h3>{workshop.name}</h3>
              <div class="workshop-details">
                {workshop.introTitle && (
                  <div>
                    <h4>{workshop.introTitle}</h4>
                    <p>{workshop.description}</p>
                  </div>
                )}
                {workshop.details.map((detail) => (
                  <div>
                    <h4>{detail.title}</h4>
                    <p>{detail.description}</p>
                  </div>
                ))}
                {workshop.closing.map((paragraph) => <p>{paragraph}</p>)}
              </div>
              <div class="price-row"><strong>550k <small>/ người</small></strong><span>Ưu đãi giảm 40%</span></div>
              <a class="button" href={registrationUrl} target="_blank" rel="noopener">Đăng ký {workshop.name.replace("Học làm ", "")}</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="workshop-benefits">
      <h2>Bạn mang về điều gì?</h2>
      <div class="benefit-grid">
        {benefits.map((benefit) => (
          <article class="surface-card benefit-card">
            <img src={`/images/workshop/${benefit.image}.webp`} alt={benefit.alt} width="960" height="720" loading="lazy" />
            <div class="benefit-body">
              <h3>{benefit.title}</h3>
              <p>{benefit.description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="info-grid">
      <div class="surface-card info-card">
        <h2>Workshop dành cho ai?</h2>
        <ul>
          <li>Người bận rộn muốn tự làm đồ uống tại nhà.</li>
          <li>Các mẹ muốn chuẩn bị thức uống cho gia đình.</li>
          <li>Người yêu thích nguyên liệu tự nhiên và lối sống lành mạnh.</li>
          <li>Người muốn giao lưu, kết nối và chia sẻ kinh nghiệm pha chế.</li>
        </ul>
      </div>
      <div class="surface-card info-card">
        <h2>Học online & giao lưu</h2>
        <p><strong>Online:</strong> học qua video, chủ động thời gian và địa điểm.</p>
        <p><strong>Ginger Shot:</strong> giao lưu tại Cần Thơ, Hà Nội.</p>
        <p><strong>Bia Gừng:</strong> giao lưu tại Cần Thơ.</p>
        <p><a href={registrationUrl} target="_blank" rel="noopener">Nhắn GỪNG qua Zalo</a> để nhận lịch, địa điểm cụ thể và tư vấn hình thức tham gia.</p>
      </div>
    </section>

    <section>
      <h2>Cùng làm, cùng kết nối</h2>
      <div class="workshop-grid gallery">
        <figure>
          <img src="/images/workshop/ginger-shot-cong-thuc.webp" alt="Hình minh họa công thức Ginger Shot Wake Up và Glow Skin" width="1024" height="1536" loading="lazy" />
          <figcaption>Công thức Ginger Shot để thực hành tại nhà.</figcaption>
        </figure>
        <figure>
          <img src="/images/workshop/ginger-shot-thuc-hanh.webp" alt="Hình minh họa học viên cùng pha chế Ginger Shot trong workshop" width="1024" height="1536" loading="lazy" />
          <figcaption>Cùng thực hành và chia sẻ niềm vui pha chế.</figcaption>
        </figure>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  #cac-workshop {
    scroll-margin-top: 6rem;
  }

  .workshop-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
  }

  section {
    margin-bottom: 3.5rem;
  }

  .workshop-hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3rem;
    align-items: center;
  }

  .eyebrow {
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  h1 {
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    line-height: 1.2;
  }

  h1 span {
    color: var(--color-primary);
  }

  .lead {
    font-size: 1.1rem;
    color: var(--color-text-muted);
  }

  .hero-note {
    color: var(--color-primary);
    font-weight: 600;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }

  .workshop-hero img, .gallery img {
    border-radius: var(--radius-lg);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .button {
    display: inline-block;
    border-radius: 999px;
    padding: 0.75rem 1.3rem;
    background: var(--color-primary);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
  }

  .button:hover {
    background: var(--color-primary-dark);
  }

  .text-link {
    font-weight: 600;
  }

  .workshop-grid, .info-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .workshop-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .workshop-card > a img {
    aspect-ratio: 3 / 4;
    object-fit: fill;
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    align-items: flex-start;
  }

  .card-body h3 {
    font-size: 1.5rem;
  }

  .card-body p {
    margin: 0;
  }

  .workshop-details {
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .workshop-details h4 {
    margin: 0 0 0.5rem;
  }

  ul {
    padding-left: 1.25rem;
  }

  li + li {
    margin-top: 0.5rem;
  }

  .price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin: auto 0 1rem;
    padding-top: 0.5rem;
  }

  .price-row strong {
    color: var(--color-primary);
    font-size: 1.5rem;
  }

  .price-row small {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-weight: 400;
  }

  .price-row span {
    background: var(--color-bg-warm);
    color: var(--color-accent);
    border-radius: 999px;
    padding: 0.3rem 0.6rem;
    font-size: 0.85rem;
  }

  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .info-card {
    padding: 1.5rem;
  }

  .workshop-benefits {
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--color-bg-warm);
  }

  .workshop-benefits > h2 {
    text-align: center;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .workshop-benefits > h2::after {
    margin-inline: auto;
  }

  .benefit-card {
    overflow: hidden;
  }

  .benefit-card img {
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .benefit-body {
    padding: 1rem;
  }

  .benefit-card h3 {
    font-size: 1.05rem;
    margin: 0 0 0.75rem;
  }

  .benefit-card h3::after {
    content: "";
    display: block;
    width: 2rem;
    height: 3px;
    margin-top: 0.5rem;
    border-radius: 999px;
    background: var(--color-accent);
  }

  .benefit-card p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .info-card h2 {
    font-size: 1.4rem;
  }

  figure {
    margin: 0;
  }

  figcaption {
    margin-top: 0.75rem;
    color: var(--color-text-muted);
  }

  .registration {
    background: var(--color-primary-light);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }

  @media (max-width: 900px) {
    .workshop-hero {
      gap: 1.5rem;
    }
    .benefit-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .workshop-hero, .workshop-grid, .info-grid, .benefit-grid {
      grid-template-columns: 1fr;
    }
    .workshop-page {
      padding-top: 1.5rem;
    }
    .registration {
      padding: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
</style>
