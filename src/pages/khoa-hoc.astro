---
import BaseLayout from "../layouts/BaseLayout.astro";

const features = [
  { icon: "🌿", title: "Công thức độc quyền", desc: "Chuẩn vị GỪNG DETOX" },
  { icon: "📋", title: "Quy trình vận hành", desc: "Dễ học – Dễ làm" },
  { icon: "📣", title: "Đồng hành marketing", desc: "Hỗ trợ quảng cáo, nội dung, khai trương" },
  { icon: "🤝", title: "Đào tạo tận tâm", desc: "Hướng dẫn chi tiết 3 ngày tại tiệm" },
];

const packages = [
  {
    key: "online",
    name: "Chuyển giao Online",
    tagline: "Tự học – Tự làm – GỪNG hỗ trợ giải đáp",
    price: "5.000.000đ / dòng sản phẩm",
    icon: "💻",
    image: "/images/nhuong-quyen/package-online.webp",
    recommended: false,
  },
  {
    key: "essential",
    name: "Gói 1 — Học thực tế",
    tagline: "Chuyển giao công thức",
    price: "29.000.000đ",
    icon: "🌱",
    image: "/images/nhuong-quyen/package-essential.webp",
    recommended: false,
  },
  {
    key: "professional",
    name: "Gói 2 — Học + Marketing",
    tagline: "Xây dựng thương hiệu",
    price: "39.000.000đ",
    icon: "🚀",
    image: "/images/nhuong-quyen/package-professional.webp",
    recommended: true,
  },
  {
    key: "premium",
    name: "Gói 3 — Full đồng hành",
    tagline: "Đồng hành khởi nghiệp",
    price: "50.000.000đ",
    icon: "👑",
    image: "/images/nhuong-quyen/package-premium.webp",
    recommended: false,
  },
];

const includedGroups = [
  {
    title: "Công thức & vận hành",
    icon: "📖",
    items: [
      "Chuyển giao toàn bộ menu & công thức",
      "Hướng dẫn pha chế trực tiếp tại GỪNG DETOX (03 ngày)",
      "Hướng dẫn sơ chế & bảo quản nguyên liệu",
      "Tài liệu công thức & định lượng",
      "Quyền sử dụng thương hiệu GỪNG DETOX",
    ],
  },
  {
    title: "Thương hiệu & kênh online",
    icon: "🎨",
    items: [
      "Thiết lập Fanpage Facebook",
      "Thiết lập TikTok",
      "Thiết lập Instagram",
      "Thiết lập Threads",
      "Thiết lập bộ nhận diện thương hiệu cơ bản",
      "Hỗ trợ setup Google Maps",
    ],
  },
  {
    title: "Marketing & hỗ trợ sau chuyển giao",
    icon: "📢",
    items: [
      "Hỗ trợ chạy quảng cáo Facebook",
      "Tối ưu quảng cáo trong 01 tháng (không bao gồm ngân sách ads)",
      "Tư vấn nội dung đăng bài trong 01 tháng",
      "Hỗ trợ online sau chuyển giao",
    ],
  },
];
---

<BaseLayout
  title="Nhượng quyền — GỪNG DETOX"
  description="GỪNG DETOX chính thức nhận nhượng quyền mô hình đồ uống healthy — 4 hình thức linh hoạt, đồng hành từ công thức đến marketing."
>
  <main class="franchise-page">
    <section class="franchise-hero">
      <div class="franchise-hero-inner">
        <div class="franchise-hero-text">
          <p class="eyebrow eyebrow-green">📣 Thông báo</p>
          <h1>Tiệm GỪNG DETOX chính thức có Nhượng quyền!</h1>
          <p class="lead">
            Cơ hội cho chị em tỉnh muốn khởi nghiệp mô hình đồ uống healthy — thương hiệu uy tín,
            đã có lượng khách hàng ổn định tại Sài Gòn.
          </p>
          <a class="hotline-btn hotline-btn-inline" href="tel:0888267009">📞 0888 267 009</a>
        </div>
        <div class="franchise-hero-photo">
          <img src="/images/hero/kitchen-lifestyle.webp" alt="Góc pha chế thật tại GỪNG DETOX" />
        </div>
      </div>
    </section>

    <section class="franchise-story">
      <p class="eyebrow eyebrow-orange">🌱 Câu chuyện GỪNG DETOX</p>
      <h2>Một mô hình đã được kiểm chứng, không phải ý tưởng trên giấy</h2>
      <p>
        Từ một tiệm nhỏ ở Sài Gòn, GỪNG DETOX hôm nay đã có lượng khách quen ổn định mỗi ngày —
        không nhờ quảng cáo rầm rộ, mà nhờ đúng một điều: làm mới mỗi ngày, không gian dối nguyên liệu.
      </p>
      <p>
        Nhu cầu sống xanh, ăn sạch, uống lành đang lớn dần ở khắp nơi, không chỉ riêng Sài Gòn. Nhưng
        để tự xây một thương hiệu đồ uống healthy từ con số 0 — từ công thức, quy trình vận hành, đến
        cách giữ chân khách mỗi ngày — là một hành trình dài và không ít rủi ro.
      </p>
      <p>
        Nhượng quyền GỪNG DETOX sinh ra để rút ngắn hành trình đó. Bạn không bắt đầu từ tờ giấy trắng,
        mà bắt đầu từ một mô hình đã được kiểm chứng bằng khách hàng thật, đơn hàng thật, mỗi ngày. 💚
      </p>
    </section>

    <section class="features">
      <div class="feature-grid">
        {
          features.map((f) => (
            <div class="surface-card feature-card">
              <span class="feature-icon">{f.icon}</span>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="packages">
      <p class="eyebrow eyebrow-purple">💼 Lựa chọn phù hợp</p>
      <h2>4 hình thức nhượng quyền — linh hoạt lựa chọn</h2>
      <p class="package-intro">
        1 gói <strong>Chuyển giao Online</strong> (tự học tại nhà) và 3 gói <strong>Chuyển giao Offline</strong>
        (học trực tiếp 3 ngày tại tiệm) — chọn theo ngân sách và mức độ đồng hành bạn cần.
      </p>
      <img
        class="package-overview-img"
        src="/images/nhuong-quyen/goi-nhuong-quyen.webp"
        alt="So sánh các hình thức nhượng quyền GỪNG DETOX"
        loading="lazy"
      />
      <p class="package-overview-caption">
        Vận hành thật, sản lượng thật — không phải mô hình trên giấy.
      </p>
      <div class="package-grid">
        {
          packages.map((p) => (
            <div class={`surface-card package-card theme-${p.key}`}>
              {p.recommended && <span class="recommended-badge">★ Khuyến nghị</span>}
              <a class="package-image-link" href={p.image} target="_blank" rel="noopener">
                <img class="package-image" src={p.image} alt={`Chi tiết ${p.name}`} loading="lazy" />
              </a>
              <span class="package-icon">{p.icon}</span>
              <h3>{p.name}</h3>
              <p class="package-price">{p.price}</p>
              <p class="package-tagline">{p.tagline}</p>
              <a class="package-cta" href="https://forms.gle/hLtzhyzPiQtnxnbe6" target="_blank" rel="noopener">
                Đăng ký khóa học
              </a>
            </div>
          ))
        }
      </div>

      <div class="location-notes">
        <div class="surface-card location-note">
          <strong>📍 Áp dụng tại Sài Gòn</strong>
          <p>Đã bao gồm chi phí đi lại đào tạo tận nơi.</p>
        </div>
        <div class="surface-card location-note">
          <strong>📍 Tại các tỉnh thành</strong>
          <p>Giá nhượng quyền chưa bao gồm chi phí đi lại đào tạo tận nơi.</p>
        </div>
      </div>
    </section>

    <section class="roadmap-section">
      <p class="eyebrow eyebrow-green">🗺️ Hành trình đồng hành</p>
      <h2>Lộ trình nhượng quyền — rõ ràng từng bước</h2>
      <p class="roadmap-intro">
        GỪNG đồng hành cùng bạn từ ý tưởng đến khi ra đơn — mỗi bước đều có mốc thời gian và đầu
        việc cụ thể, không mơ hồ.
      </p>

      <img
        class="roadmap-img"
        src="/images/nhuong-quyen/roadmap-goi-2.webp"
        alt="Lộ trình chi tiết Gói Học + Marketing GỪNG DETOX"
        loading="lazy"
      />
      <p class="roadmap-caption">Lộ trình 5 bước — áp dụng cho Gói 2 (Học + Marketing)</p>

      <img
        class="roadmap-img"
        src="/images/nhuong-quyen/roadmap-full.webp"
        alt="Lộ trình nhượng quyền đầy đủ GỪNG DETOX — từ đăng ký đến tự vận hành"
        loading="lazy"
      />
      <p class="roadmap-caption">Lộ trình đầy đủ 6 bước — áp dụng cho Gói 3 (Full đồng hành)</p>
    </section>

    <section class="included-section">
      <p class="eyebrow eyebrow-yellow">📦 Chuyển giao trọn gói</p>
      <h2>Bạn sẽ nhận được gì</h2>
      <div class="included-groups">
        {
          includedGroups.map((group) => (
            <div class="surface-card included-group">
              <div class="included-group-title">
                <span class="included-group-icon">{group.icon}</span>
                <h3>{group.title}</h3>
              </div>
              <ul class="included-list">
                {group.items.map((text) => <li>{text}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="franchise-cta">
      <h2>Liên hệ ngay để được tư vấn</h2>
      <p class="deposit-note">
        💳 Đặt cọc <strong>10.000.000đ</strong> để bắt đầu triển khai — phần còn lại thanh toán sau
        15 ngày triển khai online, trước khi vào học thực tế 3 ngày tại tiệm.
      </p>
      <div class="cta-btn-row">
        <a class="hotline-btn" href="tel:0888267009">📞 Hotline: 0888 267 009</a>
        <a class="register-btn" href="https://forms.gle/hLtzhyzPiQtnxnbe6" target="_blank" rel="noopener">
          📝 Đăng ký khóa học
        </a>
      </div>
      <div class="trust-badges">
        <span>💬 Tư vấn miễn phí</span>
        <span>💚 Hỗ trợ tận tâm</span>
        <span>🤝 Đồng hành lâu dài</span>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .franchise-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.5rem;
    --c-green: #2e7d32;
    --c-yellow: #d4a017;
    --c-orange: #e07b1a;
    --c-purple: #7c3aed;
  }

  section {
    margin-bottom: 3rem;
  }

  .franchise-hero {
    position: relative;
    margin-bottom: 3rem;
    padding-top: 1.5rem;
  }

  .franchise-hero::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      var(--c-green),
      var(--c-yellow),
      var(--color-accent),
      var(--c-orange),
      var(--c-purple)
    );
  }

  .franchise-hero-inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 2.5rem;
    align-items: center;
  }

  .franchise-hero-photo img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    display: block;
  }

  @media (max-width: 800px) {
    .franchise-hero-inner {
      grid-template-columns: 1fr;
    }

    .franchise-hero-photo {
      order: -1;
    }

    .franchise-hero-text {
      text-align: center;
    }
  }

  .lead {
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }

  .hotline-btn-inline {
    margin-top: 0.5rem;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .eyebrow-green {
    color: var(--c-green);
    background: color-mix(in srgb, var(--c-green) 16%, #fff);
  }

  .eyebrow-purple {
    color: var(--c-purple);
    background: color-mix(in srgb, var(--c-purple) 16%, #fff);
  }

  .eyebrow-yellow {
    color: var(--c-yellow);
    background: color-mix(in srgb, var(--c-yellow) 20%, #fff);
  }

  .eyebrow-orange {
    color: var(--c-orange);
    background: color-mix(in srgb, var(--c-orange) 16%, #fff);
  }

  .franchise-story {
    max-width: 700px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .franchise-story h2 {
    margin: 0 0 1.2rem;
  }

  .franchise-story h2::after {
    margin-left: auto;
    margin-right: auto;
  }

  .franchise-story p:not(.eyebrow) {
    text-align: left;
    line-height: 1.7;
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .packages h2,
  .included-section h2 {
    text-align: center;
  }

  .packages h2::after,
  .included-section h2::after {
    margin-left: auto;
    margin-right: auto;
  }

  .packages,
  .included-section {
    text-align: center;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.2rem;
  }

  .feature-card {
    padding: 1.4rem;
    text-align: center;
  }

  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--color-primary-light);
    font-size: 1.4rem;
    margin-bottom: 0.7rem;
  }

  .feature-card h3 {
    font-size: 1.05rem;
    margin-bottom: 0.3rem;
  }

  .feature-card p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .package-overview-img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    margin: 1.8rem auto 0;
    display: block;
  }

  .package-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
    text-align: left;
    margin-top: 2rem;
  }

  @media (max-width: 900px) {
    .package-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .package-grid {
      grid-template-columns: 1fr;
    }
  }

  .package-card {
    position: relative;
    padding: 1.4rem;
    border-top: 6px solid var(--color-primary);
    display: flex;
    flex-direction: column;
  }

  .package-card.theme-professional {
    border-top-color: var(--c-orange);
    box-shadow: var(--shadow-md);
  }

  .package-card.theme-premium {
    border-top-color: var(--c-purple);
  }

  .package-card.theme-essential {
    border-top-color: var(--c-green);
  }

  .package-card.theme-online {
    border-top-color: #6b7280;
  }

  .recommended-badge {
    position: absolute;
    top: -0.7rem;
    right: 1.4rem;
    background: var(--c-orange);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
  }

  .package-image-link {
    display: block;
    margin: -1.4rem -1.4rem 0.9rem;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  .package-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
    transition: transform 0.2s ease;
  }

  .package-image-link:hover .package-image {
    transform: scale(1.04);
  }

  .package-icon {
    font-size: 1.8rem;
  }

  .package-card h3 {
    margin: 0.5rem 0 0.2rem;
  }

  .package-price {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-secondary);
    margin: 0 0 0.2rem;
  }

  .package-tagline {
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 0.9rem;
  }

  .package-cta {
    display: inline-block;
    background: var(--color-primary);
    color: #fff;
    text-decoration: none;
    text-align: center;
    width: 100%;
    padding: 0.6rem;
    border-radius: 999px;
    margin-top: auto;
    font-weight: 600;
  }

  .package-cta:hover {
    background: var(--color-primary-dark);
  }

  .location-notes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-top: 2rem;
    text-align: left;
  }

  .location-note {
    padding: 1.1rem 1.3rem;
  }

  .location-note strong {
    color: var(--color-secondary);
  }

  .location-note p {
    margin: 0.3rem 0 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .package-intro {
    max-width: 680px;
    margin: 0 auto;
    color: var(--color-text-muted);
  }

  .package-overview-caption {
    text-align: center;
    margin: 0.8rem 0 0;
    font-style: italic;
    color: var(--color-primary);
    font-weight: 600;
  }

  .roadmap-section {
    text-align: center;
  }

  .roadmap-section h2::after {
    margin-left: auto;
    margin-right: auto;
  }

  .roadmap-intro {
    max-width: 680px;
    margin: 0 auto 1.5rem;
    color: var(--color-text-muted);
  }

  .roadmap-img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    display: block;
  }

  .roadmap-caption {
    margin: 0.8rem 0 2rem;
    font-style: italic;
    color: var(--color-primary);
    font-weight: 600;
  }

  .roadmap-img:last-of-type,
  .roadmap-caption:last-child {
    margin-bottom: 0;
  }

  .included-groups {
    margin: 2rem auto 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.2rem;
    text-align: left;
  }

  .included-group {
    padding: 1.4rem;
  }

  .included-group-title {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.9rem;
  }

  .included-group-title h3 {
    margin: 0;
    font-size: 1rem;
  }

  .included-group-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--c-yellow) 18%, #fff);
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .included-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .included-list li {
    padding-left: 1.1rem;
    position: relative;
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.4;
  }

  .included-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 700;
  }

  .deposit-note {
    margin: 0.6rem 0 1.4rem;
    font-size: 0.95rem;
    opacity: 0.92;
  }

  .deposit-note strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
  }

  .franchise-cta {
    text-align: center;
    background: linear-gradient(120deg, var(--color-primary), var(--color-primary-dark));
    color: #fff;
    border-radius: var(--radius-lg);
    padding: 2.5rem 1.5rem;
  }

  .franchise-cta h2 {
    color: #fff;
  }

  .franchise-cta h2::after {
    margin-left: auto;
    margin-right: auto;
    background: #fff;
  }

  .cta-btn-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 1rem 0;
  }

