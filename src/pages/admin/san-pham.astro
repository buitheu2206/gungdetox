---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminLogin from "../../components/AdminLogin.astro";
import CustomSelect from "../../components/CustomSelect.astro";
import CustomInput from "../../components/CustomInput.astro";
import ImageUpload from "../../components/ImageUpload.astro";
---

<BaseLayout title="Quản trị sản phẩm — GỪNG DETOX">
  <main class="admin-page">
    <AdminLogin>
      <h1>Quản trị sản phẩm</h1>

      <form id="product-form" class="product-form">
        <input type="hidden" id="edit-id" />
        <div class="grid-2">
          <CustomInput label="Slug (định danh, không dấu)" type="text" id="f-slug" required />
          <label>
            Loại
            <CustomSelect id="f-type" required>
              <option value="single">Đồ uống lẻ</option>
              <option value="combo">Combo</option>
              <option value="set">Set Detox</option>
            </CustomSelect>
          </label>
          <CustomInput label="Tên sản phẩm" type="text" id="f-name" required />
          <CustomInput label="Danh mục (category)" type="text" id="f-category" placeholder="ginger-shot, kombucha..." />
          <CustomInput label="Giá lẻ (đồ uống lẻ)" type="number" id="f-price-retail" />
          <CustomInput label="Giá trọn gói (combo/set)" type="number" id="f-price" />
          <CustomInput label="Dung tích/quy cách" type="text" id="f-volume" placeholder="30ml/lần, 1 chai..." />
          <CustomInput label="Số lần uống/chai (servings)" type="number" id="f-servings" />
          <CustomInput label="Lịch giao (combo)" type="text" id="f-delivery" placeholder="4 đợt/tuần" />
          <CustomInput label="Mục tiêu (chỉ Set Detox)" type="text" id="f-goal" placeholder="Thải độc – Làm mát..." />
          <label>
            Màu chủ đề (chỉ Set Detox)
            <CustomSelect id="f-color">
              <option value="">— Không —</option>
              <option value="green">Xanh</option>
              <option value="yellow">Vàng</option>
              <option value="red">Đỏ</option>
              <option value="orange">Cam</option>
              <option value="mix">Mix</option>
            </CustomSelect>
          </label>
          <label>
            Nhãn
            <CustomSelect id="f-badge">
              <option value="">— Không —</option>
              <option value="best-seller">Best-seller</option>
              <option value="new">Mới</option>
              <option value="sale">Sale</option>
              <option value="out-of-stock">Tạm hết</option>
            </CustomSelect>
          </label>
        </div>

        <label>
          Mô tả ngắn
          <textarea id="f-description" rows="2"></textarea>
        </label>
        <label>
          Nguồn gốc (1-2 câu)
          <textarea id="f-origin" rows="2"></textarea>
        </label>

        <fieldset>
          <legend>Loại chai áp dụng</legend>
          <label class="inline"><input type="checkbox" id="f-bottle-glass" /> Thủy tinh</label>
          <label class="inline"><input type="checkbox" id="f-bottle-plastic" /> Nhựa</label>
        </fieldset>

        <ImageUpload id="f-image" label="Ảnh đại diện (thumbnail)" />
        <div id="main-image-preview" class="main-image-preview" hidden>
          <button type="button" id="remove-main-image" class="remove-main-image" aria-label="Xoá ảnh đại diện" title="Xoá ảnh đại diện">×</button>
        </div>
        <p id="current-image" class="current-image"></p>

        <ImageUpload id="f-gallery" label="Ảnh phụ (thêm nhiều ảnh cho trang chi tiết sản phẩm)" multiple />
        <div id="gallery-preview" class="gallery-preview"></div>

        <label class="inline"><input type="checkbox" id="f-in-stock" checked /> Còn hàng</label>

        <div class="form-actions">
          <button type="submit" class="save-btn">Lưu sản phẩm</button>
          <button type="button" id="cancel-edit" class="cancel-btn" hidden>Huỷ sửa</button>
        </div>
      </form>

      <h2>Danh sách sản phẩm</h2>
      <div class="table-wrap">
        <table id="products-table">
          <thead>
            <tr>
              <th>Ảnh</th>
              <th>Tên</th>
              <th>Loại</th>
              <th>Giá</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="products-body">
            <tr><td colspan="5">Đang tải...</td></tr>
          </tbody>
        </table>
      </div>
    </AdminLogin>
  </main>
</BaseLayout>

<script>
  import { initMainImagePreview } from "../../lib/image-preview";
  import { supabase } from "../../lib/supabase";

  const form = document.getElementById("product-form") as HTMLFormElement;
  const editIdInput = document.getElementById("edit-id") as HTMLInputElement;
  const currentImageEl = document.getElementById("current-image") as HTMLElement;
  const cancelBtn = document.getElementById("cancel-edit") as HTMLButtonElement;
  const tbody = document.getElementById("products-body")!;

  const field = (id: string) => document.getElementById(id) as HTMLInputElement;

  // CustomSelect chỉ tự vẽ lại nhãn hiển thị khi select gốc bắn event "change"
  // (nghe ở src/components/CustomSelect.astro) — set .value trực tiếp bằng JS
  // không tự bắn event này, nên set xong phải tự dispatch để đồng bộ giao diện.
  function setSelect(id: string, value: string) {
    const el = document.getElementById(id) as HTMLSelectElement;
    el.value = value;
    el.dispatchEvent(new Event("change"));
  }

  const galleryPreview = document.getElementById("gallery-preview") as HTMLDivElement;
  const mainImageInput = document.getElementById("f-image") as HTMLInputElement;
  const mainImagePreview = document.getElementById("main-image-preview") as HTMLDivElement;
  const galleryInput = document.getElementById("f-gallery") as HTMLInputElement;

  let products: any[] = [];
  let currentImageUrl: string | null = null;
  let currentGalleryImages: string[] = [];
  // File vừa chọn nhưng chưa lưu — giữ riêng để xem trước ngay, không phải đợi bấm Lưu mới biết đã chọn đúng ảnh chưa.
  let pendingGalleryFiles: File[] = [];

  // Astro chỉ áp CSS scoped (data-astro-cid-*) cho phần tử render lúc build; phần tử
  // tạo bằng innerHTML ở JS phải tự gắn thêm attribute này thì style mới nhận diện
  // được — nếu không, ảnh preview sẽ hiện full-size thay vì bị giới hạn kích thước nhỏ
  // (đã gặp đúng lỗi này ở gallery ảnh trang chi tiết sản phẩm/blog).
  const cidAttr = Array.from(mainImagePreview.attributes).find((a) => a.name.startsWith("data-astro-cid-"));
  const cid = cidAttr ? ` ${cidAttr.name}=""` : "";

  const renderMainImagePreview = initMainImagePreview(mainImageInput, mainImagePreview, currentImageEl, {
    getUrl: () => currentImageUrl,
    clearUrl: () => { currentImageUrl = null; },
  });

  // Đồng bộ lại input.files từ mảng pendingGalleryFiles sau khi xoá bớt 1 ảnh —
  // FileList vốn chỉ đọc, phải dùng DataTransfer để dựng lại danh sách file mới.
  function syncGalleryInputFiles() {
    const dt = new DataTransfer();
    pendingGalleryFiles.forEach((f) => dt.items.add(f));
    galleryInput.files = dt.files;
  }

  galleryInput.addEventListener("change", () => {
    pendingGalleryFiles.push(...Array.from(galleryInput.files ?? []));
    syncGalleryInputFiles();
    renderGalleryPreview();
  });

  function renderGalleryPreview() {
    const savedHtml = currentGalleryImages
      .map(
        (url, i) => `
        <div class="gallery-thumb-wrap"${cid}>
          <img src="${url}"${cid} />
          <button type="button" class="remove-gallery-img" data-index="${i}"${cid}>×</button>
        </div>
      `
      )
      .join("");
    const pendingHtml = pendingGalleryFiles
      .map(
        (file, i) => `
        <div class="gallery-thumb-wrap pending"${cid}>
          <img src="${URL.createObjectURL(file)}"${cid} />
          <span class="pending-label" title="${file.name}"${cid}>${file.name}</span>
          <button type="button" class="remove-pending-img" data-index="${i}"${cid}>×</button>
        </div>
      `
      )
      .join("");
    galleryPreview.innerHTML = savedHtml + pendingHtml;
    galleryPreview.querySelectorAll<HTMLButtonElement>(".remove-gallery-img").forEach((btn) => {
      btn.addEventListener("click", () => {
        currentGalleryImages.splice(Number(btn.dataset.index), 1);
        renderGalleryPreview();
      });
    });
    galleryPreview.querySelectorAll<HTMLButtonElement>(".remove-pending-img").forEach((btn) => {
      btn.addEventListener("click", () => {
        pendingGalleryFiles.splice(Number(btn.dataset.index), 1);
        syncGalleryInputFiles();
        renderGalleryPreview();
      });
    });
  }

  function resetForm() {
    form.reset();
    editIdInput.value = "";
    currentImageUrl = null;
    currentImageEl.textContent = "";
    currentGalleryImages = [];
    pendingGalleryFiles = [];
    renderMainImagePreview();
    renderGalleryPreview();
    cancelBtn.hidden = true;
  }

  function fillForm(p: any) {
    form.reset();
    editIdInput.value = p.id;
    field("f-slug").value = p.slug;
    setSelect("f-type", p.type);
    field("f-name").value = p.name;
    field("f-category").value = p.category ?? "";
    field("f-price-retail").value = p.price_retail ?? "";
    field("f-price").value = p.price ?? "";
    field("f-volume").value = p.volume ?? "";
    field("f-servings").value = p.servings ?? "";
    field("f-delivery").value = p.delivery_schedule ?? "";
    field("f-goal").value = p.set_goal ?? "";
    setSelect("f-color", p.color_theme ?? "");
    setSelect("f-badge", p.badge ?? "");
    (document.getElementById("f-description") as HTMLTextAreaElement).value = p.description ?? "";
    (document.getElementById("f-origin") as HTMLTextAreaElement).value = p.origin_story ?? "";
    (document.getElementById("f-bottle-glass") as HTMLInputElement).checked = (
      p.bottle_options ?? []
    ).includes("glass");
    (document.getElementById("f-bottle-plastic") as HTMLInputElement).checked = (
      p.bottle_options ?? []
    ).includes("plastic");
    (document.getElementById("f-in-stock") as HTMLInputElement).checked = p.in_stock !== false;
    currentImageUrl = p.image_url ?? null;
    currentImageEl.textContent = currentImageUrl ? `Ảnh hiện tại: ${currentImageUrl}` : "Chưa có ảnh";
    renderMainImagePreview();
    currentGalleryImages = [...(p.gallery_images ?? [])];
    pendingGalleryFiles = [];
    renderGalleryPreview();
    cancelBtn.hidden = false;
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  const typeGroupLabel: Record<string, string> = {
    single: "🥤 Đồ uống lẻ",
    combo: "📦 Combo & Set quà",
    set: "🌿 5 Set Detox",
  };
  const typeGroupOrder = ["single", "combo", "set"];

  function renderTable() {
    const rowHtml = (p: any) => {
      const price = p.price ?? p.price_retail;
      return `
      <tr data-id="${p.id}"${cid}>
        <td${cid}>${p.image_url ? `<img class="row-thumb" src="${p.image_url}" alt=""${cid} />` : `<span class="row-thumb row-thumb-empty"${cid}>🫚</span>`}</td>
        <td${cid}>${p.name}</td>
        <td${cid}><span class="type-pill type-pill-${p.type}"${cid}>${p.type}</span></td>
        <td class="${price ? "" : "price-pending"}"${cid}>${price ? `${price.toLocaleString("vi-VN")}đ` : "Đang cập nhật"}</td>
        <td class="actions-cell"${cid}>
          <button class="edit-btn" data-id="${p.id}"${cid}>Sửa</button>
          <button class="delete-btn" data-id="${p.id}"${cid}>Xoá</button>
        </td>
      </tr>
    `;
    };

    const groupedTypes = [
      ...typeGroupOrder,
      ...Array.from(new Set(products.map((p) => p.type))).filter((t) => !typeGroupOrder.includes(t)),
    ];

    tbody.innerHTML = groupedTypes
      .map((type) => {
        const items = products.filter((p) => p.type === type);
        if (items.length === 0) return "";
        return `
          <tr class="group-row"${cid}><td colspan="5"${cid}>${typeGroupLabel[type] ?? type} (${items.length})</td></tr>
          ${items.map(rowHtml).join("")}
        `;
      })
      .join("");

    document.querySelectorAll<HTMLButtonElement>(".edit-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const p = products.find((x) => x.id === btn.dataset.id);
        if (p) fillForm(p);
      });
    });
    document.querySelectorAll<HTMLButtonElement>(".delete-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (!confirm("Xoá sản phẩm này?")) return;
        const { error } = await supabase.from("products").delete().eq("id", btn.dataset.id);
        if (error) alert("Lỗi xoá: " + error.message);
        else await loadProducts();
      });
    });
  }

  async function loadProducts() {
    const { data, error } = await supabase.from("products").select("*").order("sort_order");
    if (error) {
      tbody.innerHTML = `<tr><td colspan="5">Lỗi: ${error.message}</td></tr>`;
      return;
    }
    products = data ?? [];
    renderTable();
  }

  cancelBtn.addEventListener("click", resetForm);

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const bottleOptions = [
      (document.getElementById("f-bottle-glass") as HTMLInputElement).checked ? "glass" : null,
      (document.getElementById("f-bottle-plastic") as HTMLInputElement).checked ? "plastic" : null,
    ].filter(Boolean);

    let imageUrl = currentImageUrl;
    const file = mainImageInput.files?.[0];
    if (file) {
      const path = `${Date.now()}-${file.name}`;
      const { error: uploadError } = await supabase.storage
        .from("product-images")
        .upload(path, file);
      if (uploadError) {
        alert("Lỗi tải ảnh: " + uploadError.message);
        return;
      }
      imageUrl = supabase.storage.from("product-images").getPublicUrl(path).data.publicUrl;
    }

    const newGalleryFiles = Array.from(galleryInput.files ?? []);
    for (const file of newGalleryFiles) {
      const path = `${Date.now()}-${file.name}`;
      const { error: uploadError } = await supabase.storage
        .from("product-images")
        .upload(path, file);
      if (uploadError) {
        alert("Lỗi tải ảnh phụ: " + uploadError.message);
        return;
      }
      currentGalleryImages.push(
        supabase.storage.from("product-images").getPublicUrl(path).data.publicUrl
      );
    }

    const payload = {
      slug: field("f-slug").value,
      type: (document.getElementById("f-type") as HTMLSelectElement).value,
      name: field("f-name").value,
      category: field("f-category").value || null,
      description: (document.getElementById("f-description") as HTMLTextAreaElement).value || null,
      origin_story: (document.getElementById("f-origin") as HTMLTextAreaElement).value || null,
      volume: field("f-volume").value || null,
      price_retail: field("f-price-retail").value ? Number(field("f-price-retail").value) : null,
      price: field("f-price").value ? Number(field("f-price").value) : null,
      servings: field("f-servings").value ? Number(field("f-servings").value) : null,
      delivery_schedule: field("f-delivery").value || null,
      bottle_options: bottleOptions.length ? bottleOptions : null,
      set_goal: field("f-goal").value || null,
      color_theme: (document.getElementById("f-color") as HTMLSelectElement).value || null,
      badge: (document.getElementById("f-badge") as HTMLSelectElement).value || null,
      image_url: imageUrl,
      gallery_images: currentGalleryImages.length ? currentGalleryImages : null,
      in_stock: (document.getElementById("f-in-stock") as HTMLInputElement).checked,
    };

    const editId = editIdInput.value;
    const { error } = editId
      ? await supabase.from("products").update(payload).eq("id", editId)
      : await supabase.from("products").insert(payload);

    if (error) {
      alert("Lỗi lưu sản phẩm: " + error.message);
      return;
    }

    resetForm();
    await loadProducts();
  });

  loadProducts();
</script>

<style>
  .admin-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 1.5rem;
  }

  .product-form {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    background: var(--color-bg-alt);
    border-radius: 12px;
    padding: 1.2rem;
    margin-bottom: 2rem;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.8rem;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  label.inline {
    flex-direction: row;
    align-items: center;
    gap: 0.4rem;
  }

  input,
  select,
  textarea {
    padding: 0.5rem 0.6rem;
    border-radius: 8px;
    border: 1px solid #d1d5db;
    font-family: var(--font-body);
    font-weight: 400;
  }

  textarea:focus-visible {
    outline: none;
    border-color: var(--color-primary);
  }

  fieldset {
    border: none;
    padding: 0;
    display: flex;
    gap: 1rem;
  }

  fieldset legend {
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0;
    margin-bottom: 0.3rem;
  }

  .current-image {
    font-size: 0.75rem;
    color: #6b7280;
    word-break: break-all;
  }

  .gallery-preview {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .gallery-thumb-wrap {
    position: relative;
    width: 64px;
    height: 64px;
  }

  .gallery-thumb-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 6px;
  }

  .gallery-thumb-wrap.pending img {
    border: 2px solid var(--color-primary);
  }

  .pending-label {
    position: absolute;
    bottom: 2px;
    left: 2px;
    right: 2px;
    background: rgba(0, 0, 0, 0.65);
    color: #fff;
    font-size: 0.6rem;
    text-align: center;
    border-radius: 3px;
    padding: 1px 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .main-image-preview {
    position: relative;
    width: 70px;
    height: 70px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .remove-main-image:hover {
    background: var(--color-accent-dark);
  }

  .remove-main-image:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .thumb-filename {
    font-size: 0.75rem;
    color: #6b7280;
    max-width: 220px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .remove-main-image,
  .remove-gallery-img,
  .remove-pending-img {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-accent);
    color: #fff;
    border: none;
    cursor: pointer;
    line-height: 1;
    font-size: 0.85rem;
  }

  .main-image-preview img {
    width: 70px;
    height: 70px;
    object-fit: cover;
    border-radius: 8px;
    border: 2px solid var(--color-primary);
    flex-shrink: 0;
  }

  .form-actions {
    display: flex;
    gap: 0.6rem;
  }

  .save-btn,
  .cancel-btn,
  .edit-btn,
  .delete-btn {
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: none;
    font-weight: 600;
    cursor: pointer;
    font-size: 0.85rem;
  }

  .save-btn {
    background: var(--color-primary);
    color: #fff;
  }

  .cancel-btn {
    background: #fff;
    border: 1px solid var(--color-bg-alt);
  }

  .edit-btn {
    background: #e5e7eb;
  }

  .delete-btn {
    background: var(--color-accent);
    color: #fff;
  }

  .table-wrap {
    overflow-x: auto;
    background: #fff;
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
    padding: 0.4rem 0.8rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  thead th {
    text-align: left;
    padding: 0.7rem 0.5rem;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted, #6b7280);
    border-bottom: 2px solid var(--color-bg-alt);
  }

  td {
    border-bottom: 1px solid var(--color-bg-alt);
    padding: 0.55rem 0.5rem;
    text-align: left;
    vertical-align: middle;
  }

  tbody tr:not(.group-row):hover {
    background: color-mix(in srgb, var(--color-primary) 5%, transparent);
  }

  .row-thumb {
    display: block;
    width: 44px;
    height: 44px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--color-bg-alt);
  }

  .row-thumb-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-alt);
    font-size: 1.2rem;
    opacity: 0.6;
  }

  .type-pill {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    background: #e5e7eb;
    color: #374151;
  }

  .type-pill-single {
    background: color-mix(in srgb, var(--color-primary) 16%, #fff);
    color: var(--color-primary-dark, var(--color-primary));
  }

  .type-pill-combo {
    background: color-mix(in srgb, var(--color-secondary) 16%, #fff);
    color: var(--color-secondary);
  }

  .type-pill-set {
    background: color-mix(in srgb, var(--color-accent) 16%, #fff);
    color: var(--color-accent);
  }

  .price-pending {
    color: var(--color-text-muted, #9ca3af);
    font-style: italic;
    font-size: 0.8rem;
  }

  .actions-cell {
    white-space: nowrap;
  }

  .group-row td {
    background: var(--color-bg-alt);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-secondary);
    padding: 0.6rem 0.7rem;
    border-bottom: none;
    border-top: 1px solid rgba(0, 0, 0, 0.05);
  }

  .group-row:first-child td {
    border-top: none;
  }
</style>
