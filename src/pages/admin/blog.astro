---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminLogin from "../../components/AdminLogin.astro";
---

<BaseLayout title="Quản trị blog — GỪNG DETOX">
  <main class="admin-page">
    <AdminLogin>
      <h1>Quản trị Blog</h1>

      <form id="post-form" class="post-form">
        <input type="hidden" id="edit-id" />
        <label>
          Slug (định danh, không dấu)
          <input type="text" id="f-slug" required />
        </label>
        <label>
          Tiêu đề
          <input type="text" id="f-title" required />
        </label>
        <div class="grid-2">
          <label>
            Tag
            <input type="text" id="f-tag" placeholder="detox, eat-clean..." />
          </label>
          <label>
            Thời gian đọc
            <input type="text" id="f-read-time" placeholder="3 phút" />
          </label>
        </div>
        <label>
          Nội dung
          <textarea id="f-body" rows="8" required></textarea>
        </label>
        <label>
          Ảnh đại diện
          <input type="file" id="f-image" accept="image/*" />
        </label>
        <div id="main-image-preview" class="main-image-preview"></div>
        <p id="current-image" class="current-image"></p>

        <label>
          Ảnh phụ (thêm nhiều ảnh cho trang chi tiết bài viết)
          <input type="file" id="f-gallery" accept="image/*" multiple />
        </label>
        <div id="gallery-preview" class="gallery-preview"></div>

        <div class="form-actions">
          <button type="submit" class="save-btn">Đăng bài</button>
          <button type="button" id="cancel-edit" class="cancel-btn" hidden>Huỷ sửa</button>
        </div>
      </form>

      <h2>Danh sách bài viết</h2>
      <div class="table-wrap">
        <table id="posts-table">
          <thead>
            <tr>
              <th>Tiêu đề</th>
              <th>Tag</th>
              <th>Ngày đăng</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="posts-body">
            <tr><td colspan="4">Đang tải...</td></tr>
          </tbody>
        </table>
      </div>
    </AdminLogin>
  </main>
</BaseLayout>

<script>
  import { supabase } from "../../lib/supabase";

  const form = document.getElementById("post-form") as HTMLFormElement;
  const editIdInput = document.getElementById("edit-id") as HTMLInputElement;
  const currentImageEl = document.getElementById("current-image") as HTMLElement;
  const cancelBtn = document.getElementById("cancel-edit") as HTMLButtonElement;
  const tbody = document.getElementById("posts-body")!;

  const field = (id: string) => document.getElementById(id) as HTMLInputElement;
  const galleryPreview = document.getElementById("gallery-preview") as HTMLDivElement;
  const mainImageInput = document.getElementById("f-image") as HTMLInputElement;
  const mainImagePreview = document.getElementById("main-image-preview") as HTMLDivElement;
  const galleryInput = document.getElementById("f-gallery") as HTMLInputElement;

  let posts: any[] = [];
  let currentImageUrl: string | null = null;
  let currentGalleryImages: string[] = [];
  // File vừa chọn nhưng chưa lưu — giữ riêng để xem trước ngay, không phải đợi bấm Lưu mới biết đã chọn đúng ảnh chưa.
  let pendingGalleryFiles: File[] = [];

  // Astro chỉ áp CSS scoped (data-astro-cid-*) cho phần tử render lúc build; phần tử
  // tạo bằng innerHTML ở JS phải tự gắn thêm attribute này thì style mới nhận diện
  // được — nếu không, ảnh preview sẽ hiện full-size thay vì bị giới hạn kích thước nhỏ.
  const cidAttr = Array.from(mainImagePreview.attributes).find((a) => a.name.startsWith("data-astro-cid-"));
  const cid = cidAttr ? ` ${cidAttr.name}=""` : "";

  // Ảnh đại diện: xem trước ngay khi chọn file, không cần đợi lưu mới thấy.
  mainImageInput.addEventListener("change", () => {
    const file = mainImageInput.files?.[0];
    mainImagePreview.innerHTML = file
      ? `<img src="${URL.createObjectURL(file)}" alt="Xem trước ảnh đại diện"${cid} /><span class="thumb-filename"${cid}>${file.name}</span>`
      : "";
  });

  // Đồng bộ lại input.files từ mảng pendingGalleryFiles sau khi xoá bớt 1 ảnh —
  // FileList vốn chỉ đọc, phải dùng DataTransfer để dựng lại danh sách file mới.
  function syncGalleryInputFiles() {
    const dt = new DataTransfer();
    pendingGalleryFiles.forEach((f) => dt.items.add(f));
    galleryInput.files = dt.files;
  }

  galleryInput.addEventListener("change", () => {
    pendingGalleryFiles = Array.from(galleryInput.files ?? []);
    renderGalleryPreview();
  });

  function renderGalleryPreview() {
    const savedHtml = currentGalleryImages
      .map(
        (url, i) => `
        <div class="gallery-thumb-wrap"${cid}>
          <img src="${url}"${cid} />
          <button type="button" class="remove-gallery-img" data-index="${i}"${cid}>×</button>
        </div>
      `
      )
      .join("");
    const pendingHtml = pendingGalleryFiles
      .map(
        (file, i) => `
        <div class="gallery-thumb-wrap pending"${cid}>
          <img src="${URL.createObjectURL(file)}"${cid} />
          <span class="pending-label" title="${file.name}"${cid}>${file.name}</span>
          <button type="button" class="remove-pending-img" data-index="${i}"${cid}>×</button>
        </div>
      `
      )
      .join("");
    galleryPreview.innerHTML = savedHtml + pendingHtml;
    galleryPreview.querySelectorAll<HTMLButtonElement>(".remove-pending-img").forEach((btn) => {
      btn.addEventListener("click", () => {
        pendingGalleryFiles.splice(Number(btn.dataset.index), 1);
        syncGalleryInputFiles();
        renderGalleryPreview();
      });
    });
    galleryPreview.querySelectorAll<HTMLButtonElement>(".remove-gallery-img").forEach((btn) => {
      btn.addEventListener("click", () => {
        currentGalleryImages.splice(Number(btn.dataset.index), 1);
        renderGalleryPreview();
      });
    });
  }

  function resetForm() {
    form.reset();
    editIdInput.value = "";
    currentImageUrl = null;
    currentImageEl.textContent = "";
    mainImagePreview.innerHTML = "";
    currentGalleryImages = [];
    pendingGalleryFiles = [];
    renderGalleryPreview();
    cancelBtn.hidden = true;
  }

  function fillForm(p: any) {
    editIdInput.value = p.id;
    field("f-slug").value = p.slug;
    field("f-title").value = p.title;
    field("f-tag").value = p.tag ?? "";
    field("f-read-time").value = p.read_time ?? "";
    (document.getElementById("f-body") as HTMLTextAreaElement).value = p.body;
    currentImageUrl = p.image_url ?? null;
    currentImageEl.textContent = currentImageUrl ? `Ảnh hiện tại: ${currentImageUrl}` : "Chưa có ảnh";
    mainImagePreview.innerHTML = "";
    currentGalleryImages = [...(p.gallery_images ?? [])];
    pendingGalleryFiles = [];
    renderGalleryPreview();
    cancelBtn.hidden = false;
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function renderTable() {
    tbody.innerHTML = posts
      .map(
        (p) => `
      <tr>
        <td>${p.title}</td>
        <td>${p.tag ?? ""}</td>
        <td>${new Date(p.published_at).toLocaleDateString("vi-VN")}</td>
        <td>
          <button class="edit-btn" data-id="${p.id}">Sửa</button>
          <button class="delete-btn" data-id="${p.id}">Xoá</button>
        </td>
      </tr>
    `
      )
      .join("");

    document.querySelectorAll<HTMLButtonElement>(".edit-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const p = posts.find((x) => x.id === btn.dataset.id);
        if (p) fillForm(p);
      });
    });
    document.querySelectorAll<HTMLButtonElement>(".delete-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (!confirm("Xoá bài viết này?")) return;
        const { error } = await supabase.from("posts").delete().eq("id", btn.dataset.id);
        if (error) alert("Lỗi xoá: " + error.message);
        else await loadPosts();
      });
    });
  }

  async function loadPosts() {
    const { data, error } = await supabase
      .from("posts")
      .select("*")
      .order("published_at", { ascending: false });
    if (error) {
      tbody.innerHTML = `<tr><td colspan="4">Lỗi: ${error.message}</td></tr>`;
      return;
    }
    posts = data ?? [];
    renderTable();
  }

  cancelBtn.addEventListener("click", resetForm);

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    let imageUrl = currentImageUrl;
    const fileInput = document.getElementById("f-image") as HTMLInputElement;
    const file = fileInput.files?.[0];
    if (file) {
      const path = `${Date.now()}-${file.name}`;
      const { error: uploadError } = await supabase.storage.from("post-images").upload(path, file);
      if (uploadError) {
        alert("Lỗi tải ảnh: " + uploadError.message);
        return;
      }
      imageUrl = supabase.storage.from("post-images").getPublicUrl(path).data.publicUrl;
    }

    const newGalleryFiles = Array.from(galleryInput.files ?? []);
    for (const file of newGalleryFiles) {
      const path = `${Date.now()}-${file.name}`;
      const { error: uploadError } = await supabase.storage.from("post-images").upload(path, file);
      if (uploadError) {
        alert("Lỗi tải ảnh phụ: " + uploadError.message);
        return;
      }
      currentGalleryImages.push(supabase.storage.from("post-images").getPublicUrl(path).data.publicUrl);
    }

    const payload = {
      slug: field("f-slug").value,
      title: field("f-title").value,
      tag: field("f-tag").value || null,
      read_time: field("f-read-time").value || null,
      body: (document.getElementById("f-body") as HTMLTextAreaElement).value,
      image_url: imageUrl,
      gallery_images: currentGalleryImages.length ? currentGalleryImages : null,
    };

    const editId = editIdInput.value;
    const { error } = editId
      ? await supabase.from("posts").update(payload).eq("id", editId)
      : await supabase.from("posts").insert(payload);

    if (error) {
      alert("Lỗi lưu bài viết: " + error.message);
      return;
    }

    resetForm();
    await loadPosts();
  });

  loadPosts();
</script>

<style>
  .admin-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 1.5rem;
  }

  .post-form {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    background: var(--color-bg-alt);
    border-radius: 12px;
    padding: 1.2rem;
    margin-bottom: 2rem;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.8rem;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  input,
  textarea {
    padding: 0.5rem 0.6rem;
    border-radius: 8px;
    border: 1px solid #d1d5db;
    font-family: var(--font-body);
    font-weight: 400;
  }

  .current-image {
    font-size: 0.75rem;
    color: #6b7280;
    word-break: break-all;
  }

  .gallery-preview {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .gallery-thumb-wrap {
    position: relative;
    width: 64px;
    height: 64px;
  }

  .gallery-thumb-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 6px;
  }

  .gallery-thumb-wrap.pending img {
    border: 2px solid var(--color-primary);
  }

  .pending-label {
    position: absolute;
    bottom: 2px;
    left: 2px;
    right: 2px;
    background: rgba(0, 0, 0, 0.65);
    color: #fff;
    font-size: 0.6rem;
    text-align: center;
    border-radius: 3px;
    padding: 1px 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .main-image-preview {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .main-image-preview img {
    width: 70px;
    height: 70px;
    object-fit: cover;
    border-radius: 8px;
    border: 2px solid var(--color-primary);
    flex-shrink: 0;
  }

  .thumb-filename {
    font-size: 0.75rem;
    color: #6b7280;
    max-width: 220px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .remove-gallery-img,
  .remove-pending-img {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-accent);
    color: #fff;
    border: none;
    cursor: pointer;
    line-height: 1;
    font-size: 0.85rem;
  }

  .form-actions {
    display: flex;
    gap: 0.6rem;
  }

  .save-btn,
  .cancel-btn,
  .edit-btn,
  .delete-btn {
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: none;
    font-weight: 600;
    cursor: pointer;
    font-size: 0.85rem;
  }

  .save-btn {
    background: var(--color-primary);
    color: #fff;
  }

  .cancel-btn {
    background: #fff;
    border: 1px solid var(--color-bg-alt);
  }

  .edit-btn {
    background: #e5e7eb;
  }

  .delete-btn {
    background: var(--color-accent);
    color: #fff;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  th,
  td {
    border-bottom: 1px solid var(--color-bg-alt);
    padding: 0.5rem;
    text-align: left;
  }
</style>
