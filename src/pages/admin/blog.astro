---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminLogin from "../../components/AdminLogin.astro";
---

<BaseLayout title="Quản trị blog — GỪNG DETOX">
  <main class="admin-page">
    <AdminLogin>
      <h1>Quản trị Blog</h1>

      <form id="post-form" class="post-form">
        <input type="hidden" id="edit-id" />
        <label>
          Slug (định danh, không dấu)
          <input type="text" id="f-slug" required />
        </label>
        <label>
          Tiêu đề
          <input type="text" id="f-title" required />
        </label>
        <div class="grid-2">
          <label>
            Tag
            <input type="text" id="f-tag" placeholder="detox, eat-clean..." />
          </label>
          <label>
            Thời gian đọc
            <input type="text" id="f-read-time" placeholder="3 phút" />
          </label>
        </div>
        <label>
          Nội dung
          <textarea id="f-body" rows="8" required></textarea>
        </label>
        <label>
          Ảnh đại diện
          <input type="file" id="f-image" accept="image/*" />
        </label>
        <p id="current-image" class="current-image"></p>

        <div class="form-actions">
          <button type="submit" class="save-btn">Đăng bài</button>
          <button type="button" id="cancel-edit" class="cancel-btn" hidden>Huỷ sửa</button>
        </div>
      </form>

      <h2>Danh sách bài viết</h2>
      <div class="table-wrap">
        <table id="posts-table">
          <thead>
            <tr>
              <th>Tiêu đề</th>
              <th>Tag</th>
              <th>Ngày đăng</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="posts-body">
            <tr><td colspan="4">Đang tải...</td></tr>
          </tbody>
        </table>
      </div>
    </AdminLogin>
  </main>
</BaseLayout>

<script>
  import { supabase } from "../../lib/supabase";

  const form = document.getElementById("post-form") as HTMLFormElement;
  const editIdInput = document.getElementById("edit-id") as HTMLInputElement;
  const currentImageEl = document.getElementById("current-image") as HTMLElement;
  const cancelBtn = document.getElementById("cancel-edit") as HTMLButtonElement;
  const tbody = document.getElementById("posts-body")!;

  const field = (id: string) => document.getElementById(id) as HTMLInputElement;

  let posts: any[] = [];
  let currentImageUrl: string | null = null;

  function resetForm() {
    form.reset();
    editIdInput.value = "";
    currentImageUrl = null;
    currentImageEl.textContent = "";
    cancelBtn.hidden = true;
  }

  function fillForm(p: any) {
    editIdInput.value = p.id;
    field("f-slug").value = p.slug;
    field("f-title").value = p.title;
    field("f-tag").value = p.tag ?? "";
    field("f-read-time").value = p.read_time ?? "";
    (document.getElementById("f-body") as HTMLTextAreaElement).value = p.body;
    currentImageUrl = p.image_url ?? null;
    currentImageEl.textContent = currentImageUrl ? `Ảnh hiện tại: ${currentImageUrl}` : "Chưa có ảnh";
    cancelBtn.hidden = false;
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function renderTable() {
    tbody.innerHTML = posts
      .map(
        (p) => `
      <tr>
        <td>${p.title}</td>
        <td>${p.tag ?? ""}</td>
        <td>${new Date(p.published_at).toLocaleDateString("vi-VN")}</td>
        <td>
          <button class="edit-btn" data-id="${p.id}">Sửa</button>
          <button class="delete-btn" data-id="${p.id}">Xoá</button>
        </td>
      </tr>
    `
      )
      .join("");

    document.querySelectorAll<HTMLButtonElement>(".edit-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const p = posts.find((x) => x.id === btn.dataset.id);
        if (p) fillForm(p);
      });
    });
    document.querySelectorAll<HTMLButtonElement>(".delete-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (!confirm("Xoá bài viết này?")) return;
        const { error } = await supabase.from("posts").delete().eq("id", btn.dataset.id);
        if (error) alert("Lỗi xoá: " + error.message);
        else await loadPosts();
      });
    });
  }

  async function loadPosts() {
    const { data, error } = await supabase
      .from("posts")
      .select("*")
      .order("published_at", { ascending: false });
    if (error) {
      tbody.innerHTML = `<tr><td colspan="4">Lỗi: ${error.message}</td></tr>`;
      return;
    }
    posts = data ?? [];
    renderTable();
  }

  cancelBtn.addEventListener("click", resetForm);

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    let imageUrl = currentImageUrl;
    const fileInput = document.getElementById("f-image") as HTMLInputElement;
    const file = fileInput.files?.[0];
    if (file) {
      const path = `${Date.now()}-${file.name}`;
      const { error: uploadError } = await supabase.storage.from("post-images").upload(path, file);
      if (uploadError) {
        alert("Lỗi tải ảnh: " + uploadError.message);
        return;
      }
      imageUrl = supabase.storage.from("post-images").getPublicUrl(path).data.publicUrl;
    }

    const payload = {
      slug: field("f-slug").value,
      title: field("f-title").value,
      tag: field("f-tag").value || null,
      read_time: field("f-read-time").value || null,
      body: (document.getElementById("f-body") as HTMLTextAreaElement).value,
      image_url: imageUrl,
    };

    const editId = editIdInput.value;
    const { error } = editId
      ? await supabase.from("posts").update(payload).eq("id", editId)
      : await supabase.from("posts").insert(payload);

    if (error) {
      alert("Lỗi lưu bài viết: " + error.message);
      return;
    }

    resetForm();
    await loadPosts();
  });

  loadPosts();
</script>

<style>
  .admin-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 1.5rem;
  }

  .post-form {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    background: var(--color-bg-alt);
    border-radius: 12px;
    padding: 1.2rem;
    margin-bottom: 2rem;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.8rem;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  input,
  textarea {
    padding: 0.5rem 0.6rem;
    border-radius: 8px;
    border: 1px solid #d1d5db;
    font-family: var(--font-body);
    font-weight: 400;
  }

  .current-image {
    font-size: 0.75rem;
    color: #6b7280;
    word-break: break-all;
  }

  .form-actions {
    display: flex;
    gap: 0.6rem;
  }

  .save-btn,
  .cancel-btn,
  .edit-btn,
  .delete-btn {
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: none;
    font-weight: 600;
    cursor: pointer;
    font-size: 0.85rem;
  }

  .save-btn {
    background: var(--color-primary);
    color: #fff;
  }

  .cancel-btn {
    background: #fff;
    border: 1px solid var(--color-bg-alt);
  }

  .edit-btn {
    background: #e5e7eb;
  }

  .delete-btn {
    background: var(--color-accent);
    color: #fff;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  th,
  td {
    border-bottom: 1px solid var(--color-bg-alt);
    padding: 0.5rem;
    text-align: left;
  }
</style>
