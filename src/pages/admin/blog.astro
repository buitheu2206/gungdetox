---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminLogin from "../../components/AdminLogin.astro";
import ImageUpload from "../../components/ImageUpload.astro";
import CustomInput from "../../components/CustomInput.astro";
---

<BaseLayout title="Quản trị blog — GỪNG DETOX">
  <link href="https://cdn.quilljs.com/2.0.3/quill.snow.css" rel="stylesheet" />
  <main class="admin-page">
    <AdminLogin>
      <h1>Quản trị Blog</h1>

      <form id="post-form" class="post-form">
        <input type="hidden" id="edit-id" />
        <CustomInput label="Slug (định danh, không dấu)" type="text" id="f-slug" required />
        <CustomInput label="Tiêu đề" type="text" id="f-title" required />
        <div class="grid-2">
          <CustomInput label="Tag" type="text" id="f-tag" placeholder="detox, eat-clean..." />
          <CustomInput label="Thời gian đọc" type="text" id="f-read-time" placeholder="3 phút" />
        </div>
        <div class="field-group">
          <span class="field-label">Nội dung</span>
          <div id="f-body-editor" class="quill-editor"></div>
          <small class="field-hint">
            Bôi đen văn bản để in đậm, gạch đầu dòng, hoặc chèn link.
          </small>
        </div>
        <ImageUpload id="f-image" label="Ảnh đại diện" />
        <div id="main-image-preview" class="main-image-preview" hidden>
          <button type="button" id="remove-main-image" class="remove-main-image" aria-label="Xoá ảnh đại diện" title="Xoá ảnh đại diện">×</button>
        </div>
        <p id="current-image" class="current-image"></p>

        <ImageUpload id="f-gallery" label="Ảnh phụ (thêm nhiều ảnh cho trang chi tiết bài viết)" multiple />
        <div id="gallery-preview" class="gallery-preview"></div>

        <div class="form-actions">
          <button type="submit" class="save-btn">Đăng bài</button>
          <button type="button" id="cancel-edit" class="cancel-btn" hidden>Huỷ sửa</button>
        </div>
      </form>

      <h2>Danh sách bài viết</h2>
      <div class="table-wrap">
        <table id="posts-table">
          <thead>
            <tr>
              <th>Tiêu đề</th>
              <th>Tag</th>
              <th>Ngày đăng</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="posts-body">
            <tr><td colspan="4">Đang tải...</td></tr>
          </tbody>
        </table>
      </div>
    </AdminLogin>
  </main>
</BaseLayout>

<script is:inline src="https://cdn.quilljs.com/2.0.3/quill.js"></script>

<script>
  import { initContentForm } from "../../lib/content-form";
  import { escapeHtml as esc } from "../../lib/output";
  import { deleteContentWithImages } from "../../lib/delete-content";
  import { initGalleryPreview } from "../../lib/gallery-preview";
  import { uploadContentImages } from "../../lib/content-images";
  import { initMainImagePreview } from "../../lib/image-preview";
  import { supabase } from "../../lib/supabase";
  import { renderPostBodyHtml, type PostRow } from "../../lib/templates";

  const form = document.getElementById("post-form") as HTMLFormElement;
  const editIdInput = document.getElementById("edit-id") as HTMLInputElement;
  const currentImageEl = document.getElementById("current-image") as HTMLElement;
  const cancelBtn = document.getElementById("cancel-edit") as HTMLButtonElement;
  const tbody = document.getElementById("posts-body")!;

  const field = (id: string) => document.getElementById(id) as HTMLInputElement;
  const galleryPreview = document.getElementById("gallery-preview") as HTMLDivElement;
  const mainImageInput = document.getElementById("f-image") as HTMLInputElement;
  const mainImagePreview = document.getElementById("main-image-preview") as HTMLDivElement;
  const galleryInput = document.getElementById("f-gallery") as HTMLInputElement;

  // Quill (rich-text editor) nạp qua <script src="cdn.quilljs.com"> ở global
  // window.Quill — xem hướng dẫn thêm 1 dòng trống giữa đoạn không còn áp dụng
  // nữa vì giờ lưu HTML thật, enter 1 lần cũng tự xuống dòng/đoạn đúng ý.
  const quill = new window.Quill("#f-body-editor", {
    theme: "snow",
    modules: {
      toolbar: [
        [{ header: [2, 3, false] }],
        ["bold", "italic", "underline", "strike"],
        ["blockquote"],
        [{ list: "ordered" }, { list: "bullet" }],
        [{ align: [] }],
        ["link"],
        ["clean"],
      ],
    },
  });

  type AdminPost = PostRow & { id: string };
  let posts: AdminPost[] = [];
  let currentImageUrl: string | null = null;
  const uploadedFiles = new Map<File, string>();
  const gallery = initGalleryPreview(galleryInput, galleryPreview);

  const renderMainImagePreview = initMainImagePreview(mainImageInput, mainImagePreview, currentImageEl, {
    getUrl: () => currentImageUrl,
    clearUrl: () => { currentImageUrl = null; },
  });

  function resetForm() {
    uploadedFiles.clear();
    form.reset();
    editIdInput.value = "";
    quill.setText("");
    currentImageUrl = null;
    currentImageEl.textContent = "";
    renderMainImagePreview();
    gallery.setImages();
    cancelBtn.hidden = true;
  }

  function fillForm(p: AdminPost) {
    if (submission.isSaving()) return;
    uploadedFiles.clear();
    form.reset();
    editIdInput.value = p.id;
    field("f-slug").value = p.slug;
    field("f-title").value = p.title;
    field("f-tag").value = p.tag ?? "";
    field("f-read-time").value = p.read_time ?? "";
    // Bài viết cũ (trước khi có Quill) là văn bản thuần — chuyển qua <p> trước khi
    // nạp vào editor để vẫn hiển thị tách đoạn đúng, không dính thành 1 khối.
    quill.root.innerHTML = renderPostBodyHtml(p.body);
    currentImageUrl = p.image_url ?? null;
    currentImageEl.textContent = currentImageUrl ? `Ảnh hiện tại: ${currentImageUrl}` : "Chưa có ảnh";
    renderMainImagePreview();
    gallery.setImages(p.gallery_images ?? []);
    cancelBtn.hidden = false;
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function renderTable() {
    tbody.innerHTML = posts
      .map(
        (p) => `
      <tr>
        <td>${esc(p.title)}</td>
        <td>${esc(p.tag ?? "")}</td>
        <td>${new Date(p.published_at ?? "").toLocaleDateString("vi-VN")}</td>
        <td>
          <button class="edit-btn" data-id="${esc(p.id)}">Sửa</button>
          <button class="delete-btn" data-id="${esc(p.id)}">Xoá</button>
        </td>
      </tr>
    `
      )
      .join("");

    document.querySelectorAll<HTMLButtonElement>(".edit-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const p = posts.find((x) => x.id === btn.dataset.id);
        if (p) fillForm(p);
      });
    });
    document.querySelectorAll<HTMLButtonElement>(".delete-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (submission.isSaving() || btn.disabled || !confirm("Xoá bài viết này và toàn bộ ảnh đã tải lên của bài viết?")) return;
        btn.disabled = true;
        try {
          const warning = await deleteContentWithImages(supabase, "posts", btn.dataset.id ?? "");
          if (editIdInput.value === btn.dataset.id) resetForm();
          if (warning) alert(warning);
          await loadPosts();
        } catch (error) {
          console.error("Lỗi xoá bài viết", { id: btn.dataset.id, error });
          alert("Lỗi xoá: " + (error instanceof Error ? error.message : String(error)));
        } finally {
          btn.disabled = false;
        }
      });
    });
  }

  async function loadPosts() {
    const { data, error } = await supabase
      .from("posts")
      .select("*")
      .order("published_at", { ascending: false });
    if (error) {
      tbody.innerHTML = `<tr><td colspan="4">Lỗi: ${esc(error.message)}</td></tr>`;
      return;
    }
    posts = data ?? [];
    renderTable();
  }

  cancelBtn.addEventListener("click", resetForm);

  const submission = initContentForm(form, async () => {
    if (!quill.getText().trim()) {
      alert("Vui lòng nhập nội dung bài viết");
      return;
    }

    const images = await uploadContentImages(supabase, "posts", {
      currentUrl: currentImageUrl,
      mainFile: mainImageInput.files?.[0],
      galleryFiles: Array.from(galleryInput.files ?? []),
      galleryUrls: gallery.getUrls(),
      uploadedFiles,
    });

    // Dọn khoảng trắng/dấu phẩy thừa ở các field hay bị dính khi copy-paste tay
    // (vd. gõ "detox, " rồi quên xoá dấu phẩy) — tránh tag hiển thị lỗi ngoài trang.
    const cleanTag = field("f-tag").value.trim().replace(/,+$/, "").trim();

    const payload = {
      slug: field("f-slug").value.trim(),
      title: field("f-title").value.trim(),
      tag: cleanTag || null,
      read_time: field("f-read-time").value.trim() || null,
      body: renderPostBodyHtml(quill.root.innerHTML),
      image_url: images.imageUrl,
      gallery_images: images.galleryUrls.length ? images.galleryUrls : null,
    };

    const editId = editIdInput.value;
    const { error } = editId
      ? await supabase.from("posts").update(payload).eq("id", editId)
      : await supabase.from("posts").insert(payload);

    if (error) {
      alert("Lỗi lưu bài viết: " + error.message);
      return;
    }

    resetForm();
    await loadPosts();
  });

  loadPosts();
</script>

<style>
  .admin-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 1.5rem;
  }

  .post-form {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    background: var(--color-bg-alt);
    border-radius: 12px;
    padding: 1.2rem;
    margin-bottom: 2rem;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.8rem;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  /* Dùng div thường (không phải <label>) để bọc Quill — Quill tự tạo 1 <select>
     ẩn làm control thật cho mỗi picker (vd. header). Nếu bọc trong <label>,
     trình duyệt tự bắn thêm 1 click "ngầm" vào select ẩn đó mỗi lần bấm bất kỳ
     đâu trong label (hành vi chuẩn của label với control có thể gắn nhãn),
     khiến picker vừa mở đã bị đóng lại ngay do nhận 2 click liên tiếp. */
  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .field-label {
    font-size: 0.85rem;
    font-weight: 600;
  }

  input,
  textarea {
    padding: 0.5rem 0.6rem;
    border-radius: 8px;
    border: 1px solid #d1d5db;
    font-family: var(--font-body);
    font-weight: 400;
  }

  .field-hint {
    font-weight: 400;
    color: #6b7280;
    font-size: 0.75rem;
  }

  /* Quill biến chính thẻ #f-body-editor thành .ql-container (không bọc thêm div),
     và chèn .ql-toolbar làm anh em đứng trước nó — không phải con/cháu — nên 2
     rule dưới đây target trực tiếp 2 lớp đó thay vì lồng qua .quill-editor. */
  :global(.ql-toolbar) {
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
  }

  :global(.quill-editor.ql-container) {
    font-family: var(--font-body);
    font-size: 0.95rem;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
  }

  :global(.quill-editor .ql-editor) {
    min-height: 180px;
    cursor: text;
  }

  :global(.quill-editor.ql-container:focus-within) {
    border-color: var(--color-primary);
  }

  :global(.quill-editor .ql-editor:focus-visible) {
    outline: none;
  }

  .current-image {
    font-size: 0.75rem;
    color: #6b7280;
    word-break: break-all;
  }

  .gallery-preview {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .gallery-thumb-wrap {
    position: relative;
    width: 64px;
    height: 64px;
  }

  .gallery-thumb-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 6px;
  }

  .gallery-thumb-wrap.pending img {
    border: 2px solid var(--color-primary);
  }

  .pending-label {
    position: absolute;
    bottom: 2px;
    left: 2px;
    right: 2px;
    background: rgba(0, 0, 0, 0.65);
    color: #fff;
    font-size: 0.6rem;
    text-align: center;
    border-radius: 3px;
    padding: 1px 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .main-image-preview {
    position: relative;
    width: 70px;
    height: 70px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .main-image-preview img {
    width: 70px;
    height: 70px;
    object-fit: cover;
    border-radius: 8px;
    border: 2px solid var(--color-primary);
    flex-shrink: 0;
  }

  .remove-main-image:hover {
    background: var(--color-accent-dark);
  }

  .remove-main-image:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .thumb-filename {
    font-size: 0.75rem;
    color: #6b7280;
    max-width: 220px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .remove-main-image,
  .remove-gallery-img,
  .remove-pending-img {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-accent);
    color: #fff;
    border: none;
    cursor: pointer;
    line-height: 1;
    font-size: 0.85rem;
  }

  .form-actions {
    display: flex;
    gap: 0.6rem;
  }

  .save-btn,
  .cancel-btn,
  .edit-btn,
  .delete-btn {
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: none;
    font-weight: 600;
    cursor: pointer;
    font-size: 0.85rem;
  }

  .save-btn {
    background: var(--color-primary);
    color: #fff;
  }

  .cancel-btn {
    background: #fff;
    border: 1px solid var(--color-bg-alt);
  }

  .edit-btn {
    background: #e5e7eb;
  }

  .delete-btn {
    background: var(--color-accent);
    color: #fff;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  th,
  td {
    border-bottom: 1px solid var(--color-bg-alt);
    padding: 0.5rem;
    text-align: left;
  }
</style>
