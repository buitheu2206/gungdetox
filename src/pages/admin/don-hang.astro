---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminLogin from "../../components/AdminLogin.astro";
---

<BaseLayout title="Quản trị đơn hàng — GỪNG DETOX">
  <main class="admin-page">
    <AdminLogin>
      <h1>Quản trị đơn hàng</h1>

      <div class="status-filter" id="status-filter">
        <button data-status="all" class="chip active">Tất cả</button>
        <button data-status="processing" class="chip">Đang xử lý</button>
        <button data-status="delivering" class="chip">Đang giao</button>
        <button data-status="delivered" class="chip">Đã giao</button>
        <button data-status="cancelled" class="chip">Đã huỷ</button>
      </div>

      <div class="table-wrap">
        <table id="orders-table">
          <thead>
            <tr>
              <th>Ngày đặt</th>
              <th>Khách</th>
              <th>SĐT</th>
              <th>Địa chỉ</th>
              <th>Sản phẩm</th>
              <th>Chai</th>
              <th>Chai trả</th>
              <th>Trạng thái</th>
            </tr>
          </thead>
          <tbody id="orders-body">
            <tr><td colspan="8">Đang tải...</td></tr>
          </tbody>
        </table>
      </div>
    </AdminLogin>
  </main>
</BaseLayout>

<script>
  import { supabase } from "../../lib/supabase";

  const statusLabel: Record<string, string> = {
    processing: "Đang xử lý",
    delivering: "Đang giao",
    delivered: "Đã giao",
    cancelled: "Đã huỷ",
  };

  const bottleLabel: Record<string, string> = { glass: "Thủy tinh", plastic: "Nhựa" };

  const tbody = document.getElementById("orders-body")!;
  const chips = document.querySelectorAll<HTMLButtonElement>(".chip");

  let allOrders: any[] = [];

  function itemsSummary(items: any[]) {
    return items.map((i) => `${i.productSlug} × ${i.quantity}`).join(", ");
  }

  function render(orders: any[]) {
    if (orders.length === 0) {
      tbody.innerHTML = `<tr><td colspan="8">Chưa có đơn hàng nào.</td></tr>`;
      return;
    }
    tbody.innerHTML = orders
      .map(
        (o) => `
      <tr data-id="${o.id}">
        <td>${new Date(o.created_at).toLocaleString("vi-VN")}</td>
        <td>${o.customer_name}</td>
        <td>${o.phone}</td>
        <td>${o.address}, ${o.district}</td>
        <td>${itemsSummary(o.items)}</td>
        <td>${bottleLabel[o.bottle_type] ?? o.bottle_type}</td>
        <td>${o.bottles_returned ?? 0}</td>
        <td>
          <select class="status-select" data-id="${o.id}">
            ${Object.entries(statusLabel)
              .map(
                ([value, label]) =>
                  `<option value="${value}" ${value === o.status ? "selected" : ""}>${label}</option>`
              )
              .join("")}
          </select>
        </td>
      </tr>
    `
      )
      .join("");

    document.querySelectorAll<HTMLSelectElement>(".status-select").forEach((sel) => {
      sel.addEventListener("change", async () => {
        const id = sel.dataset.id!;
        const newStatus = sel.value;
        const order = allOrders.find((o) => o.id === id);
        const newHistory = [
          ...(order?.status_history ?? []),
          { status: newStatus, at: new Date().toISOString() },
        ];
        const { error } = await supabase
          .from("orders")
          .update({ status: newStatus, status_history: newHistory })
          .eq("id", id);
        if (error) alert("Lỗi cập nhật: " + error.message);
        else if (order) {
          order.status = newStatus;
          order.status_history = newHistory;
        }
      });
    });
  }

  function applyFilter(status: string) {
    render(status === "all" ? allOrders : allOrders.filter((o) => o.status === status));
  }

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      chips.forEach((c) => c.classList.remove("active"));
      chip.classList.add("active");
      applyFilter(chip.dataset.status ?? "all");
    });
  });

  async function loadOrders() {
    const { data, error } = await supabase
      .from("orders")
      .select("*")
      .order("created_at", { ascending: false });
    if (error) {
      tbody.innerHTML = `<tr><td colspan="8">Lỗi tải đơn hàng: ${error.message}</td></tr>`;
      return;
    }
    allOrders = data ?? [];
    render(allOrders);
  }

  loadOrders();
</script>

<style>
  .admin-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.5rem;
  }

  .status-filter {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .chip {
    border: 1px solid var(--color-bg-alt);
    background: #fff;
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    cursor: pointer;
    font-size: 0.85rem;
  }

  .chip.active {
    background: var(--color-primary);
    color: #fff;
    border-color: var(--color-primary);
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  th,
  td {
    border-bottom: 1px solid var(--color-bg-alt);
    padding: 0.5rem;
    text-align: left;
    white-space: nowrap;
  }

  .status-select {
    padding: 0.3rem 0.5rem;
    border-radius: 6px;
    border: 1px solid #d1d5db;
  }
</style>
