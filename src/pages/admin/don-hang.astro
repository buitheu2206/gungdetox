---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminLogin from "../../components/AdminLogin.astro";
import OrderToolbar from "../../components/admin/orders/OrderToolbar.astro";
import OrderTable from "../../components/admin/orders/OrderTable.astro";
---

<BaseLayout title="Quản trị đơn hàng — GỪNG DETOX">
  <main class="admin-page">
    <AdminLogin>
      <h1>Quản trị đơn hàng</h1>
      <OrderToolbar />
      <p id="order-products-warning" role="status" hidden></p>
      <OrderTable />
    </AdminLogin>
  </main>
</BaseLayout>

<script>
  import "../../lib/admin-orders";
</script>

<style>
  .admin-page {
    max-width: 100%;
    margin: 0 auto;
    padding: 1.5rem 2rem;
  }
</style>
