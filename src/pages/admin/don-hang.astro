---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminLogin from "../../components/AdminLogin.astro";
import CustomSelect from "../../components/CustomSelect.astro";
---

<BaseLayout title="Quản trị đơn hàng — GỪNG DETOX">
  <main class="admin-page">
    <AdminLogin>
      <h1>Quản trị đơn hàng</h1>

      <div class="toolbar-row">
        <div class="status-filter" id="status-filter">
          <button data-status="all" class="chip active">Tất cả</button>
          <button data-status="processing" class="chip">Đang xử lý</button>
          <button data-status="delivering" class="chip">Đang giao</button>
          <button data-status="delivered" class="chip">Đã giao</button>
          <button data-status="cancelled" class="chip">Đã huỷ</button>
        </div>

        <button type="button" id="export-csv-btn" class="export-btn">Xuất file CSV</button>
      </div>

      <p id="order-products-warning" role="status" hidden></p>

      <div class="table-wrap">
        <table id="orders-table">
          <thead>
            <tr>
              <th>Mã đơn</th>
              <th>Ngày đặt</th>
              <th>Khách</th>
              <th>SĐT</th>
              <th>Địa chỉ</th>
              <th>Ngày giao</th>
              <th>Khung giờ</th>
              <th>Ghi chú giao hàng</th>
              <th>Sản phẩm</th>
              <th>Đơn giá</th>
              <th class="order-quantities-cell">Số lượng</th>
              <th>Thành tiền</th>
              <th>Chai trả</th>
              <th>Hình thức TT</th>
              <th>Thanh toán</th>
              <th>Trạng thái</th>
            </tr>
          </thead>
          <tbody id="orders-body">
            <tr><td colspan="16">Đang tải...</td></tr>
          </tbody>
        </table>
      </div>
      <template id="order-status-template">
        <CustomSelect id="order-status" />
      </template>
      <nav class="pagination" aria-label="Phân trang đơn hàng">
        <button type="button" id="orders-previous" class="page-btn" disabled>‹ Trang trước</button>
        <span id="orders-page-label" class="page-label" role="status"></span>
        <button type="button" id="orders-next" class="page-btn" disabled>Trang sau ›</button>
      </nav>
    </AdminLogin>
  </main>
</BaseLayout>

<script>
  import { hasAdminAccess } from "../../lib/admin-access";
  import { escapeHtml as esc, csvCell } from "../../lib/output";
  import { getAstroScopeHtml } from "../../lib/astro-scope";
  import { loadAllRows, countOrdersByCustomer } from "../../lib/load-rows";
  import { supabase } from "../../lib/supabase";
  import { orderCode, type ProductRow } from "../../lib/templates";
  import { initCustomSelect, syncCustomSelect } from "../../lib/initCustomSelect";
  import { ORDER_STATUS_LABELS as statusLabel, getOrderDelivery, type OrderRow } from "../../lib/order-details";
  import { getOrderAmount, resolveOrderItems, type OrderItem } from "../../lib/order-pricing";
  import { saveOrderStatus } from "../../lib/order-status";
  import { saveOrderPayment } from "../../lib/order-payment";

  const paymentMethodLabel: Record<string, string> = {
    bank_transfer: "Chuyển khoản",
    cod: "COD",
  };

  const tbody = document.getElementById("orders-body")!;
  const statusChips = document.querySelectorAll<HTMLButtonElement>("#status-filter .chip");
  const statusTemplate = document.getElementById("order-status-template") as HTMLTemplateElement;

  // Astro chỉ gắn attribute scope CSS (data-astro-cid-*) cho phần tử render lúc build —
  // <tr>/<td> dựng bằng innerHTML ở đây không tự có, nên mọi CSS trong file này (viền,
  // màu xen kẽ...) sẽ bị bỏ qua hoàn toàn nếu không tự gắn thêm (cùng lỗi đã gặp ở
  // dat-hang.astro và trang chi tiết sản phẩm/blog).
  const orderTable = document.getElementById("orders-table")!;
  const cid = getAstroScopeHtml(orderTable);

  let allOrders: OrderRow[] = [];
  let customerCounts = new Map<string, number>();
  const DISPLAY_PAGE_SIZE = 50;
  let currentPage = 0;
  let allProducts: ProductRow[] = [];
  let activeStatus = "all";

  function itemsSummary(items: OrderItem[]) {
    if (!items.length) return "Dữ liệu sản phẩm không hợp lệ — cần kiểm tra đơn";
    return items.map((item) => allProducts.find((product) => product.slug === item.productSlug)?.name ?? item.productSlug).join("\n");
  }

  function quantitiesSummary(items: OrderItem[]) {
    return items.map((item) => item.quantity).join("\n");
  }

  function moneyLabel(value?: number | null) {
    return typeof value === "number" && Number.isFinite(value) && value >= 0
      ? `${value.toLocaleString("vi-VN")}đ` : "—";
  }

  function unitPricesSummary(items: OrderItem[]) {
    return items.map((item) => moneyLabel(item.unitPrice)).join("\n");
  }

  function amountSummary(items: OrderItem[]) {
    return moneyLabel(getOrderAmount(items));
  }

  // Khách "quen" = đã có từ 2 đơn trở lên tính đến thời điểm đơn này (kể cả đơn này) — dựa theo
  // toàn bộ đơn trong hệ thống (allOrders), không phải chỉ danh sách đang hiển thị sau khi lọc.
  function initOrderStatusSelect(sel: HTMLSelectElement): HTMLSelectElement {
    const root = statusTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
    const customSelect = root.querySelector("select")!;
    customSelect.id = `order-status-${sel.dataset.id}`;
    customSelect.className = sel.className;
    customSelect.dataset.id = sel.dataset.id;
    const selectedStatus = sel.value;
    customSelect.replaceChildren(...sel.childNodes);
    customSelect.value = selectedStatus;
    const list = root.querySelector<HTMLElement>(".custom-select-list")!;
    list.id = `${customSelect.id}-options`;
    const trigger = root.querySelector<HTMLButtonElement>(".custom-select-trigger")!;
    trigger.setAttribute("aria-controls", list.id);
    trigger.setAttribute("aria-label", `Trạng thái đơn ${sel.closest("tr")!.querySelector(".code")!.textContent}`);
    sel.replaceWith(root);
    initCustomSelect(root);
    return customSelect;
  }

  async function updateOrderStatus(sel: HTMLSelectElement) {
    const id = sel.dataset.id!;
    const newStatus = sel.value;
    const order = allOrders.find((o) => o.id === id);
    const previousStatus = order?.status ?? "processing";
    sel.disabled = true;
    syncCustomSelect(sel);
    try {
      if (!order) throw new Error("Không tìm thấy đơn hàng. Vui lòng tải lại trang.");
      Object.assign(order, await saveOrderStatus(supabase, order, newStatus));
    } catch (error) {
      sel.value = previousStatus;
      console.error("Lỗi cập nhật trạng thái đơn hàng", { id, newStatus, error });
      alert("Lỗi cập nhật trạng thái: " + ((error as { message?: string })?.message ?? String(error)));
    } finally {
      sel.disabled = false;
      syncCustomSelect(sel);
    }
  }

  function render(orders: OrderRow[]) {
    if (orders.length === 0) {
      tbody.innerHTML = `<tr${cid}><td colspan="16"${cid}>Không có đơn nào khớp bộ lọc.</td></tr>`;
      return;
    }
    tbody.innerHTML = orders
      .map((o) => {
        const orderCountSoFar = customerCounts.get(o.id) ?? 0;
        const customerBadge = `<span class="badge ${orderCountSoFar > 1 ? "badge-returning" : "badge-new"}"${cid}>${orderCountSoFar}</span>`;
        const deliveryDate = getOrderDelivery(o).date;
        const deliveryTimeRange = getOrderDelivery(o).time;
        const deliveryNote = getOrderDelivery(o).note;
        return `
      <tr data-id="${esc(o.id)}"${cid}>
        <td class="code"${cid}><a href="/don-hang/${encodeURIComponent(orderCode(o.phone, o.id))}"${cid}>${orderCode(o.phone, o.id)}</a></td>
        <td${cid}>${new Date(o.created_at).toLocaleDateString("vi-VN")}<br${cid} />${new Date(o.created_at).toLocaleTimeString("vi-VN")}</td>
        <td class="customer-cell"${cid}>${esc(o.customer_name)} ${customerBadge}</td>
        <td${cid}>${esc(o.phone)}</td>
        <td class="address-cell"${cid}>${esc(o.address)}, ${esc(o.district)}</td>
        <td${cid}>${deliveryDate !== "—" ? `<span class="badge badge-delivery"${cid}>${esc(deliveryDate)}</span>` : "—"}</td>
        <td${cid}>${esc(deliveryTimeRange)}</td>
        <td class="delivery-note-cell"${cid}>${esc(deliveryNote)}</td>
        <td class="order-items-cell order-products-cell"${cid}></td>
        <td class="order-items-cell order-prices-cell"${cid}></td>
        <td class="order-items-cell order-quantities-cell"${cid}></td>
        <td${cid}>${amountSummary(o.items)}</td>
        <td${cid}>${esc(o.bottles_returned ?? 0)}</td>
        <td${cid}>${esc(paymentMethodLabel[o.payment_method] ?? o.payment_method ?? "COD")}</td>
        <td${cid}>
          <label class="paid-toggle"${cid}>
            <input type="checkbox" class="paid-checkbox" data-id="${esc(o.id)}" ${o.paid ? "checked" : ""}${cid} />
            ${o.paid ? "Đã thanh toán" : "Chưa thanh toán"}
          </label>
        </td>
        <td${cid}>
          <select class="status-select" data-id="${esc(o.id)}"${cid}>
            ${Object.entries(statusLabel)
              .map(
                ([value, label]) =>
                  `<option value="${value}" ${value === o.status ? "selected" : ""}>${label}</option>`
              )
              .join("")}
          </select>
        </td>
      </tr>
    `;
      })
      .join("");

    tbody.querySelectorAll<HTMLTableRowElement>("tr[data-id]").forEach((row, index) => {
      row.querySelector(".order-products-cell")!.textContent = itemsSummary(orders[index].items);
      row.querySelector(".order-prices-cell")!.textContent = unitPricesSummary(orders[index].items);
      row.querySelector(".order-quantities-cell")!.textContent = quantitiesSummary(orders[index].items);
    });

    document.querySelectorAll<HTMLInputElement>(".paid-checkbox").forEach((cb) => {
      cb.addEventListener("change", async () => {
        const id = cb.dataset.id!;
        const order = allOrders.find((o) => o.id === id);
        if (!order || cb.disabled) return;
        const paid = cb.checked;
        cb.disabled = true;
        try {
          Object.assign(order, await saveOrderPayment(supabase, id, paid));
          cb.closest("label")!.lastChild!.textContent = ` ${paid ? "Đã thanh toán" : "Chưa thanh toán"}`;
        } catch (error) {
          cb.checked = order.paid;
          alert(error instanceof Error ? error.message : "Không cập nhật được thanh toán.");
        } finally {
          cb.disabled = false;
        }
      });
    });

    document.querySelectorAll<HTMLSelectElement>(".status-select").forEach((select) => {
      const customSelect = initOrderStatusSelect(select);
      customSelect.addEventListener("change", () => updateOrderStatus(customSelect));
    });
  }

  const previousPage = document.getElementById("orders-previous") as HTMLButtonElement;
  const nextPage = document.getElementById("orders-next") as HTMLButtonElement;
  const pageLabel = document.getElementById("orders-page-label")!;
  previousPage.addEventListener("click", () => { currentPage--; applyFilters(); });
  nextPage.addEventListener("click", () => { currentPage++; applyFilters(); });

  function applyFilters() {
    const filtered = allOrders.filter((o) => {
      if (activeStatus !== "all" && o.status !== activeStatus) return false;
      return true;
    });
    const pages = Math.max(1, Math.ceil(filtered.length / DISPLAY_PAGE_SIZE));
    currentPage = Math.min(currentPage, pages - 1);
    render(filtered.slice(currentPage * DISPLAY_PAGE_SIZE, (currentPage + 1) * DISPLAY_PAGE_SIZE));
    pageLabel.textContent = `Trang ${currentPage + 1}/${pages} · ${filtered.length} đơn`;
    previousPage.disabled = currentPage === 0;
    nextPage.disabled = currentPage === pages - 1;
  }

  statusChips.forEach((chip) => {
    chip.addEventListener("click", () => {
      statusChips.forEach((c) => c.classList.remove("active"));
      chip.classList.add("active");
      activeStatus = chip.dataset.status ?? "all";
      currentPage = 0;
      applyFilters();
    });
  });

  // Xuất toàn bộ đơn (không theo bộ lọc đang chọn) ra file CSV để mở bằng Excel/Sheets.
  const exportCsvBtn = document.getElementById("export-csv-btn") as HTMLButtonElement;

  const csvHeader = [
    "Mã đơn", "Ngày đặt", "Khách", "SĐT", "Địa chỉ", "Ngày giao", "Khung giờ",
    "Ghi chú giao hàng", "Sản phẩm", "Đơn giá", "Số lượng", "Thành tiền", "Chai trả", "Hình thức TT",
    "Thanh toán", "Trạng thái",
  ];

  function orderToCsvRow(o: OrderRow): string[] {
    return [
      orderCode(o.phone, o.id),
      new Date(o.created_at).toLocaleString("vi-VN"),
      o.customer_name,
      o.phone,
      `${esc(o.address)}, ${esc(o.district)}`,
      getOrderDelivery(o).date,
      getOrderDelivery(o).time,
      getOrderDelivery(o).note,
      itemsSummary(o.items),
      unitPricesSummary(o.items),
      quantitiesSummary(o.items),
      amountSummary(o.items),
      String(o.bottles_returned ?? 0),
      paymentMethodLabel[o.payment_method] ?? o.payment_method ?? "COD",
      o.paid ? "Đã thanh toán" : "Chưa thanh toán",
      statusLabel[o.status] ?? o.status,
    ];
  }

  // Bọc trong dấu "" và nhân đôi dấu " bên trong — quy tắc escape chuẩn của CSV,
  // bắt buộc vì địa chỉ/ghi chú khách nhập tự do có thể chứa dấu phẩy hoặc xuống dòng.
  exportCsvBtn.addEventListener("click", () => {
    const rows = [csvHeader, ...allOrders.map(orderToCsvRow)];
    const csv = rows.map((row) => row.map(csvCell).join(",")).join("\r\n");
    // Thêm BOM (\uFEFF) để Excel nhận đúng UTF-8, không thì chữ có dấu tiếng Việt
    // sẽ hiện sai (vd. "Đơn" thành ký tự lạ) khi mở file trực tiếp bằng Excel.
    const blob = new Blob(["\uFEFF" + csv], { type: "text/csv;charset=utf-8" });

    const link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.download = `don-hang-${new Date().toISOString().slice(0, 10)}.csv`;
    link.click();
    URL.revokeObjectURL(link.href);
  });

  async function loadOrders() {
    try {
      const { data: { user }, error: authError } = await supabase.auth.getUser();
      if (authError && authError.name !== "AuthSessionMissingError") throw authError;
      if (!user || !await hasAdminAccess(supabase)) return;
      const loadedBefore = new Date().toISOString();
      const [ordersResult, productsResult] = await Promise.all([
        loadAllRows((from, to) => supabase.from("orders").select("*").lte("created_at", loadedBefore).order("created_at", { ascending: false }).order("id").range(from, to)),
        supabase.from("products").select("slug, name, type, price, price_retail"),
      ]);
      allProducts = productsResult.data ?? [];
      allOrders = ordersResult.map((order) => ({
        ...order, items: resolveOrderItems(order.items, allProducts),
      }));
      customerCounts = countOrdersByCustomer(allOrders);
      applyFilters();
      if (productsResult.error) {
        console.error("Không tải được tên và giá sản phẩm cho bảng đơn hàng", { error: productsResult.error });
        const warning = document.getElementById("order-products-warning")!;
        warning.textContent = "Không tải được tên và giá sản phẩm. Vui lòng tải lại trang; đơn thiếu giá vẫn hiện “—”.";
        warning.hidden = false;
      }
    } catch (error) {
      console.error("Không tải được bảng đơn hàng", { error });
      tbody.innerHTML = `<tr${cid}><td colspan="16"${cid}></td></tr>`;
      tbody.querySelector("td")!.textContent = `Lỗi tải đơn hàng: ${(error as { message?: string })?.message ?? String(error)}. Vui lòng tải lại trang.`;
    }
  }

  loadOrders();
  supabase.auth.onAuthStateChange((event) => {
    if (event === "SIGNED_IN") setTimeout(loadOrders, 0);
  });
</script>

<style>
  .admin-page {
    max-width: 100%;
    margin: 0 auto;
    padding: 1.5rem 2rem;
  }

  .toolbar-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .status-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .export-btn {
    background: var(--color-secondary);
    color: #fff;
    border: none;
    border-radius: 999px;
    padding: 0.4rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  .chip {
    border: 1px solid var(--color-bg-alt);
    background: #fff;
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    cursor: pointer;
    font-size: 0.85rem;
  }

  .chip.active {
    background: var(--color-primary);
    color: #fff;
    border-color: var(--color-primary);
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
  }

  .page-btn {
    border: 1px solid var(--color-bg-alt);
    background: #fff;
    color: var(--color-secondary);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  .page-btn:hover:not(:disabled) {
    background: color-mix(in srgb, var(--color-primary) 8%, #fff);
    border-color: var(--color-primary);
  }

  .page-btn:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .page-label {
    font-size: 0.85rem;
    color: var(--color-secondary);
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    border: 1px solid #c9bfa8;
  }

  th,
  td {
    padding: 0.55rem 0.6rem;
    text-align: left;
    white-space: nowrap;
    vertical-align: middle;
    border: 1px solid #c9bfa8;
  }

  th {
    background: var(--color-bg-alt);
  }

  td {
    background: #fff;
  }

  tbody tr:nth-child(even) td {
    background: #faf6ec;
  }

  tbody tr:hover td {
    background: color-mix(in srgb, var(--color-primary) 8%, #fff);
  }

  .paid-toggle {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    white-space: nowrap;
  }

  .order-items-cell {
    white-space: pre;
  }

  .order-quantities-cell {
    text-align: center;
  }

  .code {
    font-family: monospace;
    font-weight: 600;
    color: var(--color-secondary);
  }

  .badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .badge-new {
    background: color-mix(in srgb, var(--color-primary) 16%, #fff);
    color: var(--color-primary);
  }

  .customer-cell .badge {
    margin-left: 0.4rem;
    vertical-align: middle;
  }

  .badge-returning {
    background: color-mix(in srgb, var(--color-accent) 16%, #fff);
    color: var(--color-accent);
  }

  .badge-delivery {
    background: color-mix(in srgb, #2563eb 16%, #fff);
    color: #2563eb;
    white-space: nowrap;
  }

  .delivery-note-cell {
    white-space: normal;
    max-width: 220px;
    min-width: 160px;
  }

  .address-cell {
    white-space: normal;
    max-width: 220px;
    min-width: 160px;
  }
</style>
