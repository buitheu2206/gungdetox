---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminLogin from "../../components/AdminLogin.astro";
---

<BaseLayout title="Quản trị đơn hàng — GỪNG DETOX">
  <main class="admin-page">
    <AdminLogin>
      <h1>Quản trị đơn hàng</h1>

      <div class="toolbar-row">
        <div class="status-filter" id="status-filter">
          <button data-status="all" class="chip active">Tất cả</button>
          <button data-status="processing" class="chip">Đang xử lý</button>
          <button data-status="delivering" class="chip">Đang giao</button>
          <button data-status="delivered" class="chip">Đã giao</button>
          <button data-status="cancelled" class="chip">Đã huỷ</button>
        </div>

        <button type="button" id="export-csv-btn" class="export-btn">Xuất file CSV</button>
      </div>

      <div class="table-wrap">
        <table id="orders-table">
          <thead>
            <tr>
              <th>Mã đơn</th>
              <th>Ngày đặt</th>
              <th>Khách</th>
              <th>SĐT</th>
              <th>Địa chỉ</th>
              <th>Ngày giao</th>
              <th>Khung giờ</th>
              <th>Ghi chú giao hàng</th>
              <th>Sản phẩm</th>
              <th>Chai</th>
              <th>Chai trả</th>
              <th>Hình thức TT</th>
              <th>Thanh toán</th>
              <th>Trạng thái</th>
            </tr>
          </thead>
          <tbody id="orders-body">
            <tr><td colspan="14">Đang tải...</td></tr>
          </tbody>
        </table>
      </div>
    </AdminLogin>
  </main>
</BaseLayout>

<script>
  import { supabase } from "../../lib/supabase";
  import { orderCode } from "../../lib/templates";

  const statusLabel: Record<string, string> = {
    processing: "Đang xử lý",
    delivering: "Đang giao",
    delivered: "Đã giao",
    cancelled: "Đã huỷ",
  };

  const bottleLabel: Record<string, string> = { glass: "Thủy tinh", plastic: "Nhựa" };
  const paymentMethodLabel: Record<string, string> = {
    bank_transfer: "Chuyển khoản",
    cod: "COD",
  };

  const tbody = document.getElementById("orders-body")!;
  const statusChips = document.querySelectorAll<HTMLButtonElement>("#status-filter .chip");

  // Astro chỉ gắn attribute scope CSS (data-astro-cid-*) cho phần tử render lúc build —
  // <tr>/<td> dựng bằng innerHTML ở đây không tự có, nên mọi CSS trong file này (viền,
  // màu xen kẽ...) sẽ bị bỏ qua hoàn toàn nếu không tự gắn thêm (cùng lỗi đã gặp ở
  // dat-hang.astro và trang chi tiết sản phẩm/blog).
  const orderTable = document.getElementById("orders-table")!;
  const cidAttrName = Array.from(orderTable.attributes).find((a) => a.name.startsWith("data-astro-cid-"))?.name;
  const cid = cidAttrName ? ` ${cidAttrName}=""` : "";

  let allOrders: any[] = [];
  let activeStatus = "all";

  function itemsSummary(items: any[]) {
    return items.map((i) => `${i.productSlug} × ${i.quantity}`).join(", ");
  }

  // orders chưa có cột delivery_date/delivery_note riêng (không có quyền chạy ALTER
  // TABLE từ đây — cần Supabase Management API token hoặc mật khẩu DB mà phiên này
  // không có sẵn), nên đang trích tạm từ shipping_fee_note — dat-hang.astro luôn ghi
  // đúng theo mẫu "Giao ngày DD/MM/YYYY [(HH:MM-HH:MM)]. Ghi chú của khách: ... . Phí ship..."
  // lúc đặt hàng. Đơn cũ hơn (đặt trước khi có tính năng này) sẽ không khớp mẫu, trả về "—".
  function extractDeliveryFull(note: string | null | undefined): string | null {
    if (!note) return null;
    const match = note.match(/Giao ngày (.+?)\. Ghi chú của khách:/);
    return match ? match[1] : null;
  }

  function extractDeliveryDate(note: string | null | undefined): string {
    const full = extractDeliveryFull(note);
    if (!full) return "—";
    const match = full.match(/^(.+?)\s*\(/);
    return match ? match[1] : full;
  }

  function extractDeliveryTimeRange(note: string | null | undefined): string {
    const full = extractDeliveryFull(note);
    if (!full) return "—";
    const match = full.match(/\(([^)]+)\)/);
    return match ? match[1] : "—";
  }

  function extractDeliveryNote(note: string | null | undefined): string {
    if (!note) return "—";
    const match = note.match(/Ghi chú của khách: (.*?)\. Phí ship/);
    if (!match || match[1] === "(không có)") return "—";
    return match[1];
  }

  // Khách "quen" = đã có từ 2 đơn trở lên tính đến thời điểm đơn này (kể cả đơn này) — dựa theo
  // toàn bộ đơn trong hệ thống (allOrders), không phải chỉ danh sách đang hiển thị sau khi lọc.
  function orderCountByPhoneUpTo(phone: string, createdAt: string): number {
    return allOrders.filter((o) => o.phone === phone && o.created_at <= createdAt).length;
  }

  function render(orders: any[]) {
    if (orders.length === 0) {
      tbody.innerHTML = `<tr${cid}><td colspan="14"${cid}>Không có đơn nào khớp bộ lọc.</td></tr>`;
      return;
    }
    tbody.innerHTML = orders
      .map((o) => {
        const orderCountSoFar = orderCountByPhoneUpTo(o.phone, o.created_at);
        const customerBadge = `<span class="badge ${orderCountSoFar > 1 ? "badge-returning" : "badge-new"}"${cid}>${orderCountSoFar}</span>`;
        const deliveryDate = extractDeliveryDate(o.shipping_fee_note);
        const deliveryTimeRange = extractDeliveryTimeRange(o.shipping_fee_note);
        const deliveryNote = extractDeliveryNote(o.shipping_fee_note);
        return `
      <tr data-id="${o.id}"${cid}>
        <td class="code"${cid}>${orderCode(o.phone, o.id)}</td>
        <td${cid}>${new Date(o.created_at).toLocaleDateString("vi-VN")}<br${cid} />${new Date(o.created_at).toLocaleTimeString("vi-VN")}</td>
        <td${cid}>${o.customer_name}<br${cid} />${customerBadge}</td>
        <td${cid}>${o.phone}</td>
        <td class="address-cell"${cid}>${o.address}, ${o.district}</td>
        <td${cid}>${deliveryDate !== "—" ? `<span class="badge badge-delivery"${cid}>${deliveryDate}</span>` : "—"}</td>
        <td${cid}>${deliveryTimeRange}</td>
        <td class="delivery-note-cell"${cid}>${deliveryNote}</td>
        <td${cid}>${itemsSummary(o.items)}</td>
        <td${cid}>${bottleLabel[o.bottle_type] ?? o.bottle_type}</td>
        <td${cid}>${o.bottles_returned ?? 0}</td>
        <td${cid}>${paymentMethodLabel[o.payment_method] ?? o.payment_method ?? "COD"}</td>
        <td${cid}>
          <label class="paid-toggle"${cid}>
            <input type="checkbox" class="paid-checkbox" data-id="${o.id}" ${o.paid ? "checked" : ""}${cid} />
            ${o.paid ? "Đã thanh toán" : "Chưa thanh toán"}
          </label>
        </td>
        <td${cid}>
          <select class="status-select" data-id="${o.id}"${cid}>
            ${Object.entries(statusLabel)
              .map(
                ([value, label]) =>
                  `<option value="${value}" ${value === o.status ? "selected" : ""}>${label}</option>`
              )
              .join("")}
          </select>
        </td>
      </tr>
    `;
      })
      .join("");

    document.querySelectorAll<HTMLInputElement>(".paid-checkbox").forEach((cb) => {
      cb.addEventListener("change", async () => {
        const id = cb.dataset.id!;
        const paid = cb.checked;
        const { error } = await supabase.from("orders").update({ paid }).eq("id", id);
        if (error) {
          alert("Lỗi cập nhật: " + error.message);
          cb.checked = !paid;
          return;
        }
        const order = allOrders.find((o) => o.id === id);
        if (order) order.paid = paid;
        cb.closest("label")!.lastChild!.textContent = ` ${paid ? "Đã thanh toán" : "Chưa thanh toán"}`;
      });
    });

    document.querySelectorAll<HTMLSelectElement>(".status-select").forEach((sel) => {
      sel.addEventListener("change", async () => {
        const id = sel.dataset.id!;
        const newStatus = sel.value;
        const order = allOrders.find((o) => o.id === id);
        const newHistory = [
          ...(order?.status_history ?? []),
          { status: newStatus, at: new Date().toISOString() },
        ];
        const { error } = await supabase
          .from("orders")
          .update({ status: newStatus, status_history: newHistory })
          .eq("id", id);
        if (error) alert("Lỗi cập nhật: " + error.message);
        else if (order) {
          order.status = newStatus;
          order.status_history = newHistory;
        }
      });
    });
  }

  function applyFilters() {
    const filtered = allOrders.filter((o) => {
      if (activeStatus !== "all" && o.status !== activeStatus) return false;
      return true;
    });
    render(filtered);
  }

  statusChips.forEach((chip) => {
    chip.addEventListener("click", () => {
      statusChips.forEach((c) => c.classList.remove("active"));
      chip.classList.add("active");
      activeStatus = chip.dataset.status ?? "all";
      applyFilters();
    });
  });

  // Xuất toàn bộ đơn (không theo bộ lọc đang chọn) ra file CSV để mở bằng Excel/Sheets.
  const exportCsvBtn = document.getElementById("export-csv-btn") as HTMLButtonElement;

  const csvHeader = [
    "Mã đơn", "Ngày đặt", "Khách", "SĐT", "Địa chỉ", "Ngày giao", "Khung giờ",
    "Ghi chú giao hàng", "Sản phẩm", "Chai", "Chai trả", "Hình thức TT",
    "Thanh toán", "Trạng thái",
  ];

  function orderToCsvRow(o: any): string[] {
    return [
      orderCode(o.phone, o.id),
      new Date(o.created_at).toLocaleString("vi-VN"),
      o.customer_name,
      o.phone,
      `${o.address}, ${o.district}`,
      extractDeliveryDate(o.shipping_fee_note),
      extractDeliveryTimeRange(o.shipping_fee_note),
      extractDeliveryNote(o.shipping_fee_note),
      itemsSummary(o.items),
      bottleLabel[o.bottle_type] ?? o.bottle_type,
      String(o.bottles_returned ?? 0),
      paymentMethodLabel[o.payment_method] ?? o.payment_method ?? "COD",
      o.paid ? "Đã thanh toán" : "Chưa thanh toán",
      statusLabel[o.status] ?? o.status,
    ];
  }

  // Bọc trong dấu "" và nhân đôi dấu " bên trong — quy tắc escape chuẩn của CSV,
  // bắt buộc vì địa chỉ/ghi chú khách nhập tự do có thể chứa dấu phẩy hoặc xuống dòng.
  function csvCell(value: string): string {
    return `"${value.replace(/"/g, '""')}"`;
  }

  exportCsvBtn.addEventListener("click", () => {
    const rows = [csvHeader, ...allOrders.map(orderToCsvRow)];
    const csv = rows.map((row) => row.map(csvCell).join(",")).join("\r\n");
    // Thêm BOM (﻿) để Excel nhận đúng UTF-8, không thì chữ có dấu tiếng Việt
    // sẽ hiện sai (vd. "Đơn" thành ký tự lạ) khi mở file trực tiếp bằng Excel.
    const blob = new Blob(["﻿" + csv], { type: "text/csv;charset=utf-8" });

    const link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.download = `don-hang-${new Date().toISOString().slice(0, 10)}.csv`;
    link.click();
    URL.revokeObjectURL(link.href);
  });

  async function loadOrders() {
    const { data, error } = await supabase
      .from("orders")
      .select("*")
      .order("created_at", { ascending: false });
    if (error) {
      tbody.innerHTML = `<tr${cid}><td colspan="14"${cid}>Lỗi tải đơn hàng: ${error.message}</td></tr>`;
      return;
    }
    allOrders = data ?? [];
    applyFilters();
  }

  loadOrders();
</script>

<style>
  .admin-page {
    max-width: 100%;
    margin: 0 auto;
    padding: 1.5rem 2rem;
  }

  .toolbar-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .status-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .export-btn {
    background: var(--color-secondary);
    color: #fff;
    border: none;
    border-radius: 999px;
    padding: 0.4rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  .chip {
    border: 1px solid var(--color-bg-alt);
    background: #fff;
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    cursor: pointer;
    font-size: 0.85rem;
  }

  .chip.active {
    background: var(--color-primary);
    color: #fff;
    border-color: var(--color-primary);
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    border: 1px solid #c9bfa8;
  }

  th,
  td {
    padding: 0.55rem 0.6rem;
    text-align: left;
    white-space: nowrap;
    vertical-align: top;
    border: 1px solid #c9bfa8;
  }

  th {
    background: var(--color-bg-alt);
  }

  td {
    background: #fff;
  }

  tbody tr:nth-child(even) td {
    background: #faf6ec;
  }

  tbody tr:hover td {
    background: color-mix(in srgb, var(--color-primary) 8%, #fff);
  }

  .status-select {
    padding: 0.3rem 0.5rem;
    border-radius: 6px;
    border: 1px solid #d1d5db;
  }

  .paid-toggle {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    white-space: nowrap;
  }

  .code {
    font-family: monospace;
    font-weight: 600;
    color: var(--color-secondary);
  }

  .badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .badge-new {
    background: color-mix(in srgb, var(--color-primary) 16%, #fff);
    color: var(--color-primary);
  }

  .badge-returning {
    background: color-mix(in srgb, var(--color-accent) 16%, #fff);
    color: var(--color-accent);
  }

  .badge-delivery {
    background: color-mix(in srgb, #2563eb 16%, #fff);
    color: #2563eb;
    white-space: nowrap;
  }

  .delivery-note-cell {
    white-space: normal;
    max-width: 220px;
    min-width: 160px;
  }

  .address-cell {
    white-space: normal;
    max-width: 220px;
    min-width: 160px;
  }
</style>
