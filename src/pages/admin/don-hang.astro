---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminLogin from "../../components/AdminLogin.astro";
---

<BaseLayout title="Quản trị đơn hàng — GỪNG DETOX">
  <main class="admin-page">
    <AdminLogin>
      <h1>Quản trị đơn hàng</h1>

      <div class="status-filter" id="status-filter">
        <button data-status="all" class="chip active">Tất cả</button>
        <button data-status="processing" class="chip">Đang xử lý</button>
        <button data-status="delivering" class="chip">Đang giao</button>
        <button data-status="delivered" class="chip">Đã giao</button>
        <button data-status="cancelled" class="chip">Đã huỷ</button>
      </div>

      <div class="status-filter" id="customer-filter">
        <button data-customer="all" class="chip active">Mọi khách</button>
        <button data-customer="new" class="chip">Khách mới</button>
        <button data-customer="returning" class="chip">Khách quen</button>
      </div>

      <div class="table-wrap">
        <table id="orders-table">
          <thead>
            <tr>
              <th>Mã đơn</th>
              <th>Ngày đặt</th>
              <th>Khách</th>
              <th>SĐT</th>
              <th>Địa chỉ</th>
              <th>Ngày giao</th>
              <th>Ghi chú giao hàng</th>
              <th>Sản phẩm</th>
              <th>Chai</th>
              <th>Chai trả</th>
              <th>Hình thức TT</th>
              <th>Thanh toán</th>
              <th>Trạng thái</th>
            </tr>
          </thead>
          <tbody id="orders-body">
            <tr><td colspan="13">Đang tải...</td></tr>
          </tbody>
        </table>
      </div>
    </AdminLogin>
  </main>
</BaseLayout>

<script>
  import { supabase } from "../../lib/supabase";
  import { orderCode } from "../../lib/templates";

  const statusLabel: Record<string, string> = {
    processing: "Đang xử lý",
    delivering: "Đang giao",
    delivered: "Đã giao",
    cancelled: "Đã huỷ",
  };

  const bottleLabel: Record<string, string> = { glass: "Thủy tinh", plastic: "Nhựa" };
  const paymentMethodLabel: Record<string, string> = {
    bank_transfer: "Chuyển khoản",
    cod: "COD",
  };

  const tbody = document.getElementById("orders-body")!;
  const statusChips = document.querySelectorAll<HTMLButtonElement>("#status-filter .chip");
  const customerChips = document.querySelectorAll<HTMLButtonElement>("#customer-filter .chip");

  let allOrders: any[] = [];
  let activeStatus = "all";
  let activeCustomerType: "all" | "new" | "returning" = "all";

  function itemsSummary(items: any[]) {
    return items.map((i) => `${i.productSlug} × ${i.quantity}`).join(", ");
  }

  // orders chưa có cột delivery_date/delivery_note riêng (không có quyền chạy ALTER
  // TABLE từ đây — cần Supabase Management API token hoặc mật khẩu DB mà phiên này
  // không có sẵn), nên đang trích tạm từ shipping_fee_note — dat-hang.astro luôn ghi
  // đúng theo mẫu "Giao ngày DD/MM/YYYY [lúc HH:MM]. Ghi chú của khách: ... . Phí ship..."
  // lúc đặt hàng. Đơn cũ hơn (đặt trước khi có tính năng này) sẽ không khớp mẫu, trả về "—".
  function extractDeliveryDateTime(note: string | null | undefined): string {
    if (!note) return "—";
    const match = note.match(/Giao ngày (.+?)\. Ghi chú của khách:/);
    return match ? match[1] : "—";
  }

  function extractDeliveryNote(note: string | null | undefined): string {
    if (!note) return "—";
    const match = note.match(/Ghi chú của khách: (.*?)\. Phí ship/);
    if (!match || match[1] === "(không có)") return "—";
    return match[1];
  }

  // Khách "quen" = đã có từ 2 đơn trở lên tính đến thời điểm đơn này (kể cả đơn này) — dựa theo
  // toàn bộ đơn trong hệ thống (allOrders), không phải chỉ danh sách đang hiển thị sau khi lọc.
  function orderCountByPhoneUpTo(phone: string, createdAt: string): number {
    return allOrders.filter((o) => o.phone === phone && o.created_at <= createdAt).length;
  }

  function render(orders: any[]) {
    if (orders.length === 0) {
      tbody.innerHTML = `<tr><td colspan="13">Không có đơn nào khớp bộ lọc.</td></tr>`;
      return;
    }
    tbody.innerHTML = orders
      .map((o) => {
        const orderCountSoFar = orderCountByPhoneUpTo(o.phone, o.created_at);
        const customerBadge =
          orderCountSoFar > 1
            ? `<span class="badge badge-returning">Khách quen (${orderCountSoFar})</span>`
            : `<span class="badge badge-new">Khách mới</span>`;
        const deliveryDateTime = extractDeliveryDateTime(o.shipping_fee_note);
        const deliveryNote = extractDeliveryNote(o.shipping_fee_note);
        return `
      <tr data-id="${o.id}">
        <td class="code">${orderCode(o.phone, o.id)}</td>
        <td>${new Date(o.created_at).toLocaleString("vi-VN")}</td>
        <td>${o.customer_name}<br />${customerBadge}</td>
        <td>${o.phone}</td>
        <td>${o.address}, ${o.district}</td>
        <td>${deliveryDateTime !== "—" ? `<span class="badge badge-delivery">${deliveryDateTime}</span>` : "—"}</td>
        <td class="delivery-note-cell">${deliveryNote}</td>
        <td>${itemsSummary(o.items)}</td>
        <td>${bottleLabel[o.bottle_type] ?? o.bottle_type}</td>
        <td>${o.bottles_returned ?? 0}</td>
        <td>${paymentMethodLabel[o.payment_method] ?? o.payment_method ?? "COD"}</td>
        <td>
          <label class="paid-toggle">
            <input type="checkbox" class="paid-checkbox" data-id="${o.id}" ${o.paid ? "checked" : ""} />
            ${o.paid ? "Đã thanh toán" : "Chưa thanh toán"}
          </label>
        </td>
        <td>
          <select class="status-select" data-id="${o.id}">
            ${Object.entries(statusLabel)
              .map(
                ([value, label]) =>
                  `<option value="${value}" ${value === o.status ? "selected" : ""}>${label}</option>`
              )
              .join("")}
          </select>
        </td>
      </tr>
    `;
      })
      .join("");

    document.querySelectorAll<HTMLInputElement>(".paid-checkbox").forEach((cb) => {
      cb.addEventListener("change", async () => {
        const id = cb.dataset.id!;
        const paid = cb.checked;
        const { error } = await supabase.from("orders").update({ paid }).eq("id", id);
        if (error) {
          alert("Lỗi cập nhật: " + error.message);
          cb.checked = !paid;
          return;
        }
        const order = allOrders.find((o) => o.id === id);
        if (order) order.paid = paid;
        cb.closest("label")!.lastChild!.textContent = ` ${paid ? "Đã thanh toán" : "Chưa thanh toán"}`;
      });
    });

    document.querySelectorAll<HTMLSelectElement>(".status-select").forEach((sel) => {
      sel.addEventListener("change", async () => {
        const id = sel.dataset.id!;
        const newStatus = sel.value;
        const order = allOrders.find((o) => o.id === id);
        const newHistory = [
          ...(order?.status_history ?? []),
          { status: newStatus, at: new Date().toISOString() },
        ];
        const { error } = await supabase
          .from("orders")
          .update({ status: newStatus, status_history: newHistory })
          .eq("id", id);
        if (error) alert("Lỗi cập nhật: " + error.message);
        else if (order) {
          order.status = newStatus;
          order.status_history = newHistory;
        }
      });
    });
  }

  function applyFilters() {
    const filtered = allOrders.filter((o) => {
      if (activeStatus !== "all" && o.status !== activeStatus) return false;
      if (activeCustomerType !== "all") {
        const isReturning = orderCountByPhoneUpTo(o.phone, o.created_at) > 1;
        if (activeCustomerType === "returning" && !isReturning) return false;
        if (activeCustomerType === "new" && isReturning) return false;
      }
      return true;
    });
    render(filtered);
  }

  statusChips.forEach((chip) => {
    chip.addEventListener("click", () => {
      statusChips.forEach((c) => c.classList.remove("active"));
      chip.classList.add("active");
      activeStatus = chip.dataset.status ?? "all";
      applyFilters();
    });
  });

  customerChips.forEach((chip) => {
    chip.addEventListener("click", () => {
      customerChips.forEach((c) => c.classList.remove("active"));
      chip.classList.add("active");
      activeCustomerType = (chip.dataset.customer as "all" | "new" | "returning") ?? "all";
      applyFilters();
    });
  });

  async function loadOrders() {
    const { data, error } = await supabase
      .from("orders")
      .select("*")
      .order("created_at", { ascending: false });
    if (error) {
      tbody.innerHTML = `<tr><td colspan="13">Lỗi tải đơn hàng: ${error.message}</td></tr>`;
      return;
    }
    allOrders = data ?? [];
    applyFilters();
  }

  loadOrders();
</script>

<style>
  .admin-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.5rem;
  }

  .status-filter {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .chip {
    border: 1px solid var(--color-bg-alt);
    background: #fff;
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    cursor: pointer;
    font-size: 0.85rem;
  }

  .chip.active {
    background: var(--color-primary);
    color: #fff;
    border-color: var(--color-primary);
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  th,
  td {
    border-bottom: 1px solid var(--color-bg-alt);
    padding: 0.5rem;
    text-align: left;
    white-space: nowrap;
  }

  .status-select {
    padding: 0.3rem 0.5rem;
    border-radius: 6px;
    border: 1px solid #d1d5db;
  }

  .paid-toggle {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    white-space: nowrap;
  }

  .code {
    font-family: monospace;
    font-weight: 600;
    color: var(--color-secondary);
  }

  .badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .badge-new {
    background: color-mix(in srgb, var(--color-primary) 16%, #fff);
    color: var(--color-primary);
  }

  .badge-returning {
    background: color-mix(in srgb, var(--color-accent) 16%, #fff);
    color: var(--color-accent);
  }

  .badge-delivery {
    background: color-mix(in srgb, #2563eb 16%, #fff);
    color: #2563eb;
    white-space: nowrap;
  }

  .delivery-note-cell {
    white-space: normal;
    max-width: 220px;
    min-width: 160px;
  }
</style>
