---
import BaseLayout from "../layouts/BaseLayout.astro";

const features = [
  { icon: "🌿", title: "Công thức độc quyền", desc: "Chuẩn vị GỪNG DETOX" },
  { icon: "📋", title: "Quy trình vận hành", desc: "Dễ học – Dễ làm" },
  { icon: "📣", title: "Đồng hành marketing", desc: "Hỗ trợ quảng cáo, nội dung, khai trương" },
  { icon: "🤝", title: "Đào tạo tận tâm", desc: "Hướng dẫn chi tiết 3 ngày tại tiệm" },
];

const packages = [
  {
    key: "essential",
    name: "Gói Essential",
    tagline: "Chuyển giao công thức",
    price: "29.000.000đ",
    icon: "🌱",
    recommended: false,
    fit: "Người đã có cửa hàng hoặc thương hiệu riêng, chỉ cần công thức và quy trình để triển khai sản phẩm healthy.",
  },
  {
    key: "professional",
    name: "Gói Professional",
    tagline: "Xây dựng thương hiệu",
    price: "39.000.000đ",
    icon: "🚀",
    recommended: true,
    fit: "Người muốn kinh doanh dưới thương hiệu của bản thân, được hỗ trợ xây dựng đầy đủ nền tảng thương hiệu trên các kênh mạng xã hội mang tên mình thích.",
  },
  {
    key: "premium",
    name: "Gói Premium",
    tagline: "Đồng hành khởi nghiệp",
    price: "50.000.000đ",
    icon: "👑",
    recommended: false,
    fit: "Người mới bắt đầu kinh doanh, cần đồng hành trong giai đoạn khai trương và xây dựng tệp khách hàng qua quảng cáo và định hướng nội dung. Xây dựng thương hiệu, quy trình vận hành và menu chuyên nghiệp từ đầu.",
  },
];

const included = [
  "Chuyển giao toàn bộ menu & công thức",
  "Hướng dẫn pha chế trực tiếp tại GỪNG DETOX (03 ngày)",
  "Hướng dẫn sơ chế & bảo quản nguyên liệu",
  "Tài liệu công thức & định lượng",
  "Quyền sử dụng thương hiệu GỪNG DETOX",
  "Thiết lập Fanpage Facebook",
  "Thiết lập TikTok",
  "Thiết lập Instagram",
  "Thiết lập Threads",
  "Thiết lập bộ nhận diện thương hiệu cơ bản",
  "Hỗ trợ setup Google Maps",
  "Hỗ trợ chạy quảng cáo Facebook",
  "Tối ưu quảng cáo trong 01 tháng (không bao gồm ngân sách ads)",
  "Tư vấn nội dung đăng bài trong 01 tháng",
  "Hỗ trợ online sau chuyển giao",
];
---

<BaseLayout
  title="Nhượng quyền — GỪNG DETOX"
  description="GỪNG DETOX chính thức nhận nhượng quyền mô hình đồ uống healthy — 3 gói linh hoạt, đồng hành từ công thức đến marketing."
>
  <main class="franchise-page">
    <section class="franchise-hero">
      <p class="eyebrow eyebrow-green">📣 Thông báo</p>
      <h1>Tiệm GỪNG DETOX chính thức có Nhượng quyền!</h1>
      <p class="lead">
        Cơ hội cho chị em tỉnh muốn khởi nghiệp mô hình đồ uống healthy — thương hiệu uy tín,
        đã có lượng khách hàng ổn định tại Sài Gòn.
      </p>
      <a class="hotline-btn hotline-btn-inline" href="tel:0888267009">📞 0888 267 009</a>
    </section>

    <section class="announcement-photo">
      <img
        src="/images/brand/nhuong-quyen-thong-bao.webp"
        alt="Thông báo nhượng quyền GỪNG DETOX — chi tiết gói và quyền lợi"
        loading="lazy"
      />
    </section>

    <section class="features">
      <div class="feature-grid">
        {
          features.map((f) => (
            <div class="surface-card feature-card">
              <span class="feature-icon">{f.icon}</span>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="packages">
      <p class="eyebrow eyebrow-purple">💼 Lựa chọn phù hợp</p>
      <h2>3 gói nhượng quyền — linh hoạt lựa chọn</h2>
      <div class="package-grid">
        {
          packages.map((p) => (
            <div class={`surface-card package-card theme-${p.key}`}>
              {p.recommended && <span class="recommended-badge">★ Khuyến nghị</span>}
              <span class="package-icon">{p.icon}</span>
              <h3>{p.name}</h3>
              <p class="package-price">{p.price}</p>
              <p class="package-tagline">{p.tagline}</p>
              <p class="package-fit">
                <strong>Phù hợp với:</strong> {p.fit}
              </p>
              <a class="package-cta" href="tel:0888267009">
                Tư vấn gói này
              </a>
            </div>
          ))
        }
      </div>

      <div class="location-notes">
        <div class="surface-card location-note">
          <strong>📍 Áp dụng tại Sài Gòn</strong>
          <p>Đã bao gồm chi phí đi lại đào tạo tận nơi.</p>
        </div>
        <div class="surface-card location-note">
          <strong>📍 Tại các tỉnh thành</strong>
          <p>Giá nhượng quyền chưa bao gồm chi phí đi lại đào tạo tận nơi.</p>
        </div>
      </div>
    </section>

    <section class="proof-photo">
      <img src="/images/hero/story-bottles.webp" alt="Từng dãy chai GỪNG DETOX được đóng chai mỗi ngày" loading="lazy" />
      <p class="proof-caption">Vận hành thật, sản lượng thật — không phải mô hình trên giấy.</p>
    </section>

    <section class="included-section">
      <p class="eyebrow eyebrow-yellow">📦 Chuyển giao trọn gói</p>
      <h2>Bạn sẽ nhận được gì</h2>
      <ul class="included-list">
        {included.map((item) => <li>✅ {item}</li>)}
      </ul>
    </section>

    <section class="payment-policy">
      <div class="surface-card payment-card">
        <h3>💳 Chính sách thanh toán</h3>
        <p>Đặt cọc <strong>10.000.000đ</strong> để giữ lịch chuyển giao.</p>
      </div>
    </section>

    <section class="franchise-cta">
      <h2>Liên hệ ngay để được tư vấn</h2>
      <a class="hotline-btn" href="tel:0888267009">📞 Hotline: 0888 267 009</a>
      <div class="trust-badges">
        <span>💬 Tư vấn miễn phí</span>
        <span>💚 Hỗ trợ tận tâm</span>
        <span>🤝 Đồng hành lâu dài</span>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .franchise-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.5rem;
    --c-green: #2e7d32;
    --c-yellow: #d4a017;
    --c-orange: #e07b1a;
    --c-purple: #7c3aed;
  }

  section {
    margin-bottom: 3rem;
  }

  .franchise-hero {
    position: relative;
    margin-bottom: 2rem;
    padding-top: 1.5rem;
    text-align: center;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .franchise-hero h1::after {
    margin-left: auto;
    margin-right: auto;
  }

  .franchise-hero::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      var(--c-green),
      var(--c-yellow),
      var(--color-accent),
      var(--c-orange),
      var(--c-purple)
    );
  }

  .lead {
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }

  .hotline-btn-inline {
    margin-top: 0.5rem;
  }

  .announcement-photo {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 3rem;
  }

  .announcement-photo img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    display: block;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .eyebrow-green {
    color: var(--c-green);
    background: color-mix(in srgb, var(--c-green) 16%, #fff);
  }

  .eyebrow-purple {
    color: var(--c-purple);
    background: color-mix(in srgb, var(--c-purple) 16%, #fff);
  }

  .eyebrow-yellow {
    color: var(--c-yellow);
    background: color-mix(in srgb, var(--c-yellow) 20%, #fff);
  }

  .packages h2,
  .included-section h2 {
    text-align: center;
  }

  .packages h2::after,
  .included-section h2::after {
    margin-left: auto;
    margin-right: auto;
  }

  .packages,
  .included-section {
    text-align: center;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.2rem;
  }

  .feature-card {
    padding: 1.4rem;
    text-align: center;
  }

  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--color-primary-light);
    font-size: 1.4rem;
    margin-bottom: 0.7rem;
  }

  .feature-card h3 {
    font-size: 1.05rem;
    margin-bottom: 0.3rem;
  }

  .feature-card p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .package-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    text-align: left;
    margin-top: 2rem;
  }

  .package-card {
    position: relative;
    padding: 1.8rem;
    border-top: 6px solid var(--color-primary);
  }

  .package-card.theme-professional {
    border-top-color: var(--c-orange);
    box-shadow: var(--shadow-md);
  }

  .package-card.theme-premium {
    border-top-color: var(--c-purple);
  }

  .package-card.theme-essential {
    border-top-color: var(--c-green);
  }

  .recommended-badge {
    position: absolute;
    top: -0.7rem;
    right: 1.4rem;
    background: var(--c-orange);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
  }

  .package-icon {
    font-size: 1.8rem;
  }

  .package-card h3 {
    margin: 0.5rem 0 0.2rem;
  }

  .package-price {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-secondary);
    margin: 0 0 0.2rem;
  }

  .package-tagline {
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 0.9rem;
  }

  .package-fit {
    font-size: 0.88rem;
    color: var(--color-text);
    margin: 0 0 1.2rem;
  }

  .package-cta {
    display: inline-block;
    background: var(--color-primary);
    color: #fff;
    text-decoration: none;
    text-align: center;
    width: 100%;
    padding: 0.6rem;
    border-radius: 999px;
    font-weight: 600;
  }

  .package-cta:hover {
    background: var(--color-primary-dark);
  }

  .location-notes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-top: 2rem;
    text-align: left;
  }

  .location-note {
    padding: 1.1rem 1.3rem;
  }

  .location-note strong {
    color: var(--color-secondary);
  }

  .location-note p {
    margin: 0.3rem 0 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .proof-photo {
    text-align: center;
  }

  .proof-photo img {
    width: 100%;
    max-height: 340px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    display: block;
  }

  .proof-caption {
    margin-top: 0.8rem;
    font-style: italic;
    color: var(--color-primary);
    font-weight: 600;
  }

  .included-list {
    list-style: none;
    padding: 0;
    margin: 2rem auto 0;
    max-width: 720px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0.7rem;
    text-align: left;
  }

  .included-list li {
    background: #fff;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    padding: 0.65rem 0.9rem;
    font-size: 0.9rem;
  }

  .payment-policy {
    text-align: center;
  }

  .payment-card {
    max-width: 480px;
    margin: 0 auto;
    padding: 1.5rem;
    text-align: center;
    border-left: 4px solid var(--color-accent);
  }

  .payment-card h3 {
    margin-bottom: 0.5rem;
  }

  .payment-card p {
    margin: 0;
  }

  .franchise-cta {
    text-align: center;
    background: linear-gradient(120deg, var(--color-primary), var(--color-primary-dark));
    color: #fff;
    border-radius: var(--radius-lg);
    padding: 2.5rem 1.5rem;
  }

  .franchise-cta h2 {
    color: #fff;
  }

  .franchise-cta h2::after {
    margin-left: auto;
    margin-right: auto;
    background: #fff;
  }

  .hotline-btn {
    display: inline-block;
    background: #fff;
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.1rem;
    padding: 0.8rem 1.8rem;
    border-radius: 999px;
    margin: 1rem 0;
    box-shadow: var(--shadow-md);
  }

  .hotline-btn:hover {
    transform: translateY(-2px);
  }

  .trust-badges {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.9rem;
    margin-top: 1rem;
    opacity: 0.95;
  }
</style>
