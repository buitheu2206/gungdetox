---
import "../styles/global.css";
import "../styles/cards.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ZaloButton from "../components/ZaloButton.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "GỪNG DETOX — Sống xanh, sống khỏe" } = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400&family=Be+Vietnam+Pro:wght@400;500;600;700&subset=vietnamese&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <ZaloButton />
  </body>
</html>
