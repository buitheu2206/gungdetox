---
import "../styles/global.css";
import "../styles/cards.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ZaloButton from "../components/ZaloButton.astro";
import ShareModal from "../components/ShareModal.astro";
import ImagePreview from "../components/ImagePreview.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "GỪNG DETOX — Sống xanh, sống khỏe",
  image = "/images/brand/cover-5-set-detox.jpg",
} = Astro.props;

const ogImageUrl = new URL(image, Astro.site).toString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      // Disable restoration before the browser restores the old scroll position.
      history.scrollRestoration = "manual";
      window.addEventListener("pageshow", () => {
        // Run after the browser applies a destination URL's fragment scroll.
        requestAnimationFrame(() => {
          window.scrollTo({ top: 0, left: 0, behavior: "instant" });
        });
      });
    </script>
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GỪNG DETOX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&subset=vietnamese&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <ZaloButton />
    <ShareModal />
    <ImagePreview />
  </body>
</html>
